---
import Icon from "./Icon.astro";
import { localeMeta, otherLocale, strings, type Locale } from "../data/i18n";

interface Props {
  locale?: Locale;
  /** Path of this page in the other language, or null when no counterpart exists. */
  switchPath?: string | null;
}

const { locale = "en", switchPath = null } = Astro.props;

const meta = localeMeta[locale];
const other = otherLocale(locale);
const otherMeta = localeMeta[other];
const t = strings[locale];

const links = t.nav;
const path = Astro.url.pathname;

const switchHref = switchPath
  ? `${otherMeta.prefix}${switchPath}`.replace(/\/$/, "") + "/"
  : `${otherMeta.prefix}/`;
const switchIsExact = Boolean(switchPath);
const switchTitle = switchIsExact
  ? `${t.languageSwitch}: ${otherMeta.endonym}`
  : `${t.languageSwitch}: ${otherMeta.endonym} — ${t.languageFallbackNote}`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={`${meta.prefix}/`}>
      <span class="brand__mark" aria-hidden="true"><Icon name="grid" size={17} /></span>
      <span class="brand__name">Tools<b>.ly</b></span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={locale === "ar" ? "التنقّل الرئيسي" : "Main"}>
      {
        links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <a
        class="lang-switch"
        href={switchHref}
        hreflang={otherMeta.htmlLang}
        lang={otherMeta.htmlLang}
        title={switchTitle}
        aria-label={switchTitle}
      >
        <Icon name="link" size={15} />
        <span>{otherMeta.endonym}</span>
        {!switchIsExact && <span class="lang-switch__dot" aria-hidden="true">•</span>}
      </a>

      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label={t.themeToggle}
        title={t.themeToggle}
      >
        <Icon name="moon" size={18} />
      </button>
      <button
        class="icon-btn nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label={locale === "ar" ? "إظهار القائمة" : "Toggle navigation"}
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;

  const paintThemeIcon = () => {
    const dark = root.dataset.theme === "dark";
    const btn = document.getElementById("theme-toggle");
    if (btn)
      btn.innerHTML = dark
        ? '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>'
        : '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>';
  };

  paintThemeIcon();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("toolsly-theme", next);
    } catch {}
    paintThemeIcon();
  });

  const navBtn = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  navBtn?.addEventListener("click", () => {
    const open = nav?.dataset.open === "true";
    if (nav) nav.dataset.open = String(!open);
    navBtn.setAttribute("aria-expanded", String(!open));
  });
</script>
