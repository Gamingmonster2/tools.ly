---
import ArToolLayout from "../../layouts/ArToolLayout.astro";
import { arTools } from "../../data/arTools";

const tool = arTools.find((t) => t.slug === "مصلح-النص-العربي")!;

const faqs = [
  {
    q: "كيف أصلح النص العربي المقلوب بعد النسخ من PDF؟",
    a: "الصق النص في المربع الأول، ثم اختر من مجموعة «الترتيب»: «اقلب ترتيب الحروف» إن كان القلب داخل الكلمة نفسها، أو «اقلب ترتيب الكلمات» إن كانت الكلمات في غير مواضعها. الافتراضي «كما هو» لأن العكس ليس حالة واحدة: ملفات PDF تقلب الحروف كاملة، وأخرى تقلب الكلمات وحدها، وثالثة تقلب مقاطع من السطر؛ فلا يوجد اختيار صحيح دائماً. وإن رأت الأداة مؤشراً على القلب ظهرت لافتة اقتراح بجانب الخيارات، وهي مبنية على قائمة بالكلمات العربية الشائعة: نقيس عدد الكلمات المعروفة في النص وفي مقلوبه، ولا نقترح القلب إلا إذا كان الفرق واضحاً. ثم اضغط «انسخ الناتج» والصقه في مكانه.",
  },
  {
    q: "لماذا يظهر النص العربي رموزاً غريبة؟",
    a: "لأن البايتات قُرئت بترميز غير ترميزها. الحرف العربي يُخزَّن في UTF-8 ببايتين، فإذا قرأهما برنامج على أنهما حرفان في ترميز لاتيني ظهر النص بالشكل «\u00D8\u00A7\u00D9\u201E\u00D8\u00B3\u00D9\u201E\u00D8\u00A7\u00D9\u2026». والفكّ عكس العملية نفسها: يُعاد كل محرف إلى البايت الذي جاء منه، ثم تُفكّ البايتات بترميز UTF-8، وهو ما يفعله خيار «إصلاح الترميز». ولا يُطبَّق الإصلاح إلا إذا أنتج عدداً أكبر من الحروف العربية ولم يبقَ فيه محرف غير صالح (\uFFFD)؛ وإلا تُرك النص كما هو ونُبِّه عليه في سطر الفحص.",
  },
  {
    q: "هل تُرفع نصوصي إلى خادم؟",
    a: "لا. الأداة صفحة واحدة تعمل داخل متصفحك: لا رفع ولا إرسال ولا تحليل على خادم، ولا تُحمَّل أي مكتبة خارجية. ويمكنك التحقق بسهولة: افتح الصفحة ثم افصل الإنترنت، وستجدها تعمل كما هي لأن كل شيء يجري في جهازك. وهذا مقصود؛ فالنصوص التي تحتاج هذا الإصلاح غالباً عقود أو أوراق رسمية أو بحوث لا يصح إرسالها إلى جهة أخرى.",
  },
  {
    q: "النص يبدو سليماً لكن البحث لا يجده، لماذا؟",
    a: "لأن الحرف قد يكون سليماً والمشكلة في محارف لا تُرى. تدسّ ملفات PDF محارف خفية مثل المسافة الصفرية (U+200B) ومحارف الاتجاه (U+200E و U+200F) ومحارف عزل الاتجاه (U+2066–U+2069)، فتظهر الكلمة «محمد» سليمة بينما بين حروفها محارف لا تُرى، والبحث يقارن المحارف واحداً واحداً فيفشل. شغّل خيار «إزالة المحارف الخفية» وأعد البحث، وسيخبرك سطر الفحص بعدد ما أُزيل. وإن كان النص يحمل أشكال عرض أيضاً فشغّل الخيار الثاني معه.",
  },
];

const sources = [
  {
    label: "Unicode — UAX #15: Unicode Normalization Forms",
    href: "https://www.unicode.org/reports/tr15/",
    note: "التوصية المعيارية التي تعرّف التحويل NFKC، وهو ما تستخدمه الأداة لإعادة أشكال العرض إلى حروفها الأساسية.",
  },
  {
    label: "Unicode — Arabic Presentation Forms-B (U+FE70–U+FEFF)",
    href: "https://www.unicode.org/charts/PDF/UFE70.pdf",
    note: "جدول نطاق أشكال العرض الذي يفسّر كيف صار للحرف العربي الواحد أربعة أشكال بنقاط ترميز مختلفة، ويقابله نطاق أشكال العرض-أ (U+FB50–U+FDFF).",
  },
  {
    label: "WHATWG — Encoding Standard (windows-1252 و ISO-8859-1)",
    href: "https://encoding.spec.whatwg.org/",
    note: "المرجع الذي يحدّد كيف تُقابل البايتات بالمحارف في الترميزات اللاتينية، وعليه بُني فكّ الرموز الغريبة وإعادة كل محرف إلى بايته.",
  },
];
---

<ArToolLayout
  tool={tool}
  intro="الصق نصاً عربياً أفسدته عملية النسخ من PDF — معكوساً أو متقطّعاً أو برموز غريبة — واحصل على نص سليم داخل متصفحك، مع خيارات تتحكم في كل إصلاح وسطر فحص يخبرك بما تغيّر."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div class="tool">
          <div class="field">
            <label for="src">النص المكسور — الصقه هنا</label>
            <textarea
              id="src"
              rows="9"
              dir="rtl"
              lang="ar"
              spellcheck="false"
              autocomplete="off"
              autocapitalize="off"
              placeholder="الصق النص الذي نسخته من PDF… سيبدأ الفحص فوراً مع أول حرف."
            ></textarea>
            <p class="hint">
              الإصلاح يجري أثناء الكتابة وداخل متصفحك: لا زرّ «أصلح»، ولا رفع، ولا اتصال بالشبكة.
            </p>
          </div>

          <fieldset class="fieldset">
            <legend>الإصلاحات</legend>
            <div class="opts">
              <label class="check" for="fix-encoding">
                <input type="checkbox" id="fix-encoding" checked />
                <span>إصلاح الترميز — الرموز الغريبة (&#xD9;&#xD8;&#xD9;&#xD8;&#xAF;)</span>
              </label>
              <label class="check" for="fix-forms">
                <input type="checkbox" id="fix-forms" checked />
                <span>تحويل أشكال العرض إلى حروفها</span>
              </label>
              <label class="check" for="fix-hidden">
                <input type="checkbox" id="fix-hidden" checked />
                <span>إزالة المحارف الخفية (مسافات صفرية ومحارف اتجاه)</span>
              </label>
              <label class="check" for="fix-spacing">
                <input type="checkbox" id="fix-spacing" checked />
                <span>إزالة المسافات بين الحروف المفردة (م ح م د ← محمد)</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>الترتيب</legend>
            <p class="hint">
              لا نُصلح الترتيب تلقائياً؛ فقد يقلب PDF الحروف كاملة، أو الكلمات وحدها، أو مقاطع من السطر.
              القرار لك، والناتج يتغيّر فور اختيارك.
            </p>
            <div class="opts">
              <label class="check" for="ord-none">
                <input type="radio" name="order" id="ord-none" value="none" checked />
                <span>كما هو</span>
              </label>
              <label class="check" for="ord-chars">
                <input type="radio" name="order" id="ord-chars" value="chars" />
                <span>اقلب ترتيب الحروف</span>
              </label>
              <label class="check" for="ord-words">
                <input type="radio" name="order" id="ord-words" value="words" />
                <span>اقلب ترتيب الكلمات</span>
              </label>
            </div>
            <p class="hint suggest" id="ord-suggest" hidden>
              <span class="badge badge--accent">قد يكون مقلوباً</span>
              <span id="ord-suggest-text"></span>
            </p>
          </fieldset>

          <section aria-labelledby="out-heading">
            <h3 class="block-title" id="out-heading">الناتج</h3>
            <p class="detect" id="detect" aria-live="polite">الصق نصاً في الأعلى ليبدأ الفحص.</p>

            <div class="field">
              <label for="out">النص بعد الإصلاح (للقراءة فقط)</label>
              <textarea
                id="out"
                class="out"
                rows="9"
                dir="rtl"
                lang="ar"
                spellcheck="false"
                readonly
                placeholder="سيظهر النص المُصلَح هنا…"
              ></textarea>
            </div>

            <div class="callout callout--warn" id="no-detect" hidden>
              <p>
                لم نكتشف أي مشكلة معروفة في هذا النص. فإن كان يبدو تالفاً رغم ذلك، فالسبب على الأرجح
                <strong>جدول تحويل المحارف (ToUnicode)</strong> في ملف PDF الأصلي: عندها لا يحمل الملف
                حروفاً صحيحة أصلاً، ولا تستطيع أي أداة استعادتها — لا هذه ولا غيرها. الحل الوحيد أن
                تُقرأ الصفحة صورةً ويُشغَّل عليها التعرّف الضوئي (OCR)، أو أن تنسخ النص من مصدره الأصلي.
              </p>
            </div>
          </section>

          <section aria-labelledby="stats-heading">
            <h3 class="block-title" id="stats-heading">الملخّص</h3>
            <div class="stat-grid" aria-live="polite">
              <div class="stat">
                <div class="stat__label">الحروف العربية قبل</div>
                <div class="stat__value" id="st-letters-before">٠</div>
              </div>
              <div class="stat">
                <div class="stat__label">الحروف العربية بعد</div>
                <div class="stat__value" id="st-letters-after">٠</div>
              </div>
              <div class="stat">
                <div class="stat__label">الكلمات قبل</div>
                <div class="stat__value" id="st-words-before">٠</div>
              </div>
              <div class="stat">
                <div class="stat__label">الكلمات بعد</div>
                <div class="stat__value" id="st-words-after">٠</div>
              </div>
              <div class="stat">
                <div class="stat__label">الأسطر</div>
                <div class="stat__value" id="st-lines">٠</div>
              </div>
              <div class="stat">
                <div class="stat__label">ما تم إصلاحه</div>
                <div class="stat__value" id="st-fixed">لا شيء</div>
              </div>
            </div>
          </section>

          <div class="actions">
            <button type="button" class="btn btn--primary" id="btn-copy">انسخ الناتج</button>
            <button type="button" class="btn btn--ghost" id="btn-clear">تفريغ</button>
            <span class="status" id="copy-status" role="status" aria-live="polite"></span>
          </div>

          <noscript>
            <div class="callout callout--warn">
              <p>
                هذه الأداة تفحص النص وتُصلحه بجافاسكربت داخل متصفحك، وبدونه لا تستطيع أن تفعل شيئاً.
                فعّل جافاسكربت ثم أعد تحميل الصفحة. وللمعلومة: نصك لن يُرسل إلى أي مكان في الحالتين.
              </p>
            </div>
          </noscript>
        </div>
      </div>
      <div class="panel__foot">
        كل إصلاح يعمل على نسخة من نصك: ما لا تكون الأداة واثقة منه يبقى كما هو، ولا يُغيَّر الناتج
        بالتخمين. ولأن ملف PDF قد يقلب الحروف، أو الكلمات، أو مقاطع فقط، فقرار الترتيب متروك لك.
      </div>
    </div>
  </Fragment>

  <h2>لماذا يظهر النص العربي معكوساً بعد النسخ من PDF؟</h2>
  <p>
    الملف الذي يصلك بصيغة PDF ليس نصاً بالمعنى المألوف، بل صفحة مرسومة: تعليمات تقول «ارسم هذا الشكل
    عند هذا الإحداثي». أما ما تحدّده بالفأرة وتنسخه فهو طبقة نصية أُضيفت فوق الرسم، وقد رتّبها البرنامج
    الذي أنشأ الملف بالترتيب الذي رسم به الأشكال. وفي العربية يُرسم النص من اليمين إلى اليسار، فيُكتب
    الحرف الأخير في آخر الصفحة أولاً في ترتيب الرسم ثم يأتي ما قبله. وهنا أصل
    <strong>مشكلة نسخ النص العربي من PDF</strong>: أنت تنسخ ترتيب الرسم، لا ترتيب القراءة.
  </p>
  <p>
    وحين يستخرج القارئ — كروم أو أكروبات أو غيرهما — هذه الطبقة النصية، يقرأ الأشكال بترتيب ورودها في
    الملف ثم يعرضها وفق قواعد الاتجاه الثنائي (Bidi). فإن كان الملف محفوظاً بترتيب العرض البصري خرج
    <strong>النص العربي معكوساً</strong>: تُقلب الحروف داخل الكلمة، أو تُقلب الكلمات داخل السطر، أو يحدث
    الأمران في مقاطع متفرقة من الصفحة؛ لأن كل سطر يُرسم على حدة، وقد يكون بعضها بترتيب منطقي سليم
    وبعضها بترتيب بصري مقلوب. ولهذا لا يوجد «إصلاح واحد» لعكس النص العربي، ولهذا لا نقلب الترتيب هنا
    تلقائياً، بل نعرض عليك ثلاثة خيارات، ونُظهر لافتة اقتراح إن رأينا مؤشراً على القلب.
  </p>
  <p>
    ويبقى سؤال مهم: كيف يعرف القارئ أن هذا الشكل هو حرف الميم لا حرف الجيم؟ الجواب في جدول صغير داخل
    الملف يُسمّى جدول التحويل إلى يونيكود (<code>ToUnicode CMap</code>)، وهو يقول مثلاً: «الشكل رقم ٢١٥
    هو الحرف م». فإن كان الجدول سليماً خرج النص سليماً، وإن كان ناقصاً أو مُخمَّناً خرجت حروف في غير
    مواضعها أو رموز غريبة — وهذه حالة أخرى غير القلب، وسنراها في الأسفل. أما الخلاصة العملية:
    <strong>تصحيح النص العربي المقلوب</strong> يبدأ بمعرفة ما الذي قُلب؛ فإن كان القلب داخل الكلمات
    فاختر «اقلب ترتيب الحروف»، وإن كانت الكلمات نفسها في غير مواضعها فاختر «اقلب ترتيب الكلمات»، ويصير
    <strong>تحويل نص عربي مقلوب</strong> إلى نص سليم أمراً بضغطة واحدة.
  </p>

  <h2>الحروف العربية متقطعة: ما الذي حدث فعلاً؟</h2>
  <p>
    حين تقول «الحروف العربية متقطعة» فقد تصف مشكلتين مختلفتين تماماً، ولكل واحدة سبب وعلاج: مسافات
    دُسّت بين الحروف، أو أشكال عرض حُفظت بدل الحروف نفسها.
  </p>
  <p>
    المشكلة الأولى شكلية: مسافة بين كل حرفين، فتصير «محمد» هكذا «م ح م د». سببها أن مستخرج النص يتعامل
    مع كل شكل مرسوم على أنه وحدة مستقلة، فيضع بينه وبين ما جاوره فاصلاً. والعلاج حذف هذه المسافات، لكن
    بشرط ألّا يُفسد كلاماً سليماً: لا تُحذف مسافة إلا إذا كان الحرف قبلها والحرف بعدها حرفين عربيين
    مفردين، أي غير ملتصقين بحرف آخر. ولذلك تبقى الواو في «و قال» على حالها، ولا تُدمج كلمتان حقيقيتان
    أبداً، ولا تُمسّ مسافة إن كان على أحد الحرفين حركة أو كان جزءاً من كلمة. وهذا هو الإصلاح الأكثر
    خطراً في القائمة، ولهذا أُفرد بخيار مستقل تستطيع إيقافه في أي لحظة.
  </p>
  <p>
    أما المشكلة الثانية فأعمق: أن يحفظ الملف شكل الحرف المرسوم بدل الحرف نفسه. للحرف العربي أربعة أشكال
    — منفصل، وأول، ووسط، وآخر — ولكل شكل نقطة ترميز خاصة في نطاقَي أشكال العرض
    (U+FB50–U+FDFF و U+FE70–U+FEFF). فكلمة «محمد» بالحروف العادية هي النقاط
    <code>U+0645 U+062D U+0645 U+062F</code>، وبأشكال العرض المنفصلة تصبح
    <span class="sample">&#xFEE1;&#xFEA1;&#xFEE1;&#xFEA9;</span> أي
    <code>U+FEE1 U+FEA1 U+FEE1 U+FEA9</code>. الحرف واحد، والنقاط مختلفة تماماً.
  </p>
  <p>
    والنتيجة أن كل ما يعتمد على مطابقة الحروف يفشل: البحث عن «محمد» لا يجد
    <span class="sample">&#xFEE1;&#xFEA1;&#xFEE1;&#xFEA9;</span>، والتدقيق الإملائي لا يعرف الكلمة،
    وعدّاد الحروف يعدّها محارف غريبة، والفرز في الجداول يختلّ. والعلاج معياري لا اجتهادي: لكل شكل عرض
    تحليل توافقي (compatibility decomposition) يعيده إلى حرفه الأساسي، وهو ما يفعله التحويل
    <code>NFKC</code> في يونيكود. لذلك لا نبني جدولاً يدوياً ولا نخمّن، بل نستدعي
    <code>normalize("NFKC")</code> عند وجود أي محرف في نطاق أشكال العرض. وفائدة جانبية مفيدة: العلامة
    الواحدة «&#xFDFA;» تتحول إلى «صلى الله عليه وسلم».
  </p>

  <h2>الرموز الغريبة (&#xD9;&#xD8;&#xD9;&#xD8;&#xAF;) وسببها</h2>
  <p>
    إن رأيت نصاً مثل
    <span class="sample">&#xD8;&#xA7;&#xD9;&#x201E;&#xD8;&#xB3;&#xD9;&#x201E;&#xD8;&#xA7;&#xD9;&#x2026;</span>
    فأنت لا تنظر إلى عربية مشوّهة، بل إلى نص عربي سليم قُرئ بترميز خاطئ. والحكاية كلها في البايتات:
    الحرف العربي يُخزَّن في UTF-8 ببايتين، فالألف «ا» هي <code>D8 A7</code>، والميم «م» هي
    <code>D9 85</code>. فإن قرأ برنامج هذين البايتين على أنهما حرفان في ترميز لاتيني (Latin-1 أو
    windows-1252) ظهرا «&#xD8;&#xA7;» و«&#xD9;&#x2026;» بدل «ا» و«م». والحرف لم يتغيّر في الملف، وإنما
    تغيّرت القراءة. جرّبها بنفسك: «السلام» بايتاتها <code>D8 A7 D9 84 D8 B3 D9 84 D8 A7 D9 85</code>،
    واقرأها بـ windows-1252 فتصير
    <span class="sample">&#xD8;&#xA7;&#xD9;&#x201E;&#xD8;&#xB3;&#xD9;&#x201E;&#xD8;&#xA7;&#xD9;&#x2026;</span>.
  </p>
  <p>
    وفكّها عكس العملية نفسها: يُعاد كل محرف إلى البايت الذي جاء منه، ثم تُفكّ البايتات بترميز UTF-8.
    لكن الأداة لا تفعل ذلك على العموم، بل تتحقق أولاً وتقارن: لا تُطبّق الإصلاح إلا إذا أنتج الفكّ عدداً
    أكبر من الحروف العربية مما كان، ولم يبقَ فيه محرف غير صالح (<code>U+FFFD</code>). فإن لم يتحقق
    الشرطان تُركت الكلمة كما هي ونُبِّه عليها في سطر الفحص. وهذا مقصود: قد يكون النص عقداً أو رسالة
    علمية، وإفساده أسوأ من تركه على حاله.
  </p>
  <p>
    وثمة تفصيل يفسّر تفاوت الأشكال التي تراها: البايت الثاني في الحرف العربي يقع بين
    <code>0x80</code> و<code>0xBF</code>، وفي windows-1252 بعض هذه البايتات محارف مطبعية ظاهرة مثل
    «…» و«„» و«ˆ»، وبعضها محارف تحكم لا تُرى. ولهذا يظهر النص تارة بمنظر
    «&#xD9;&#xD8;&#xD9;&#xD8;&#xAF;» وتارة بمنظر
    «&#xD8;&#xA7;&#xD9;&#x201E;&#xD8;&#xB3;&#xD9;&#x201E;&#xD8;&#xA7;&#xD9;&#x2026;»، وهذا هو السبب
    الأشهر وراء شكوى «النص العربي يظهر رموزاً غريبة». ولهذا تجرّب الأداة القراءتين معاً: اللاتينية
    القياسية وwindows-1252. أما الأرقام وعلامات الترقيم والمسافات فلا تتأثر بهذا الإصلاح، لأن كل واحد
    منها بايت واحد في UTF-8 يعود كما كان.
  </p>

  <h2>متى لا تستطيع أي أداة إصلاح النص؟</h2>
  <p>
    هناك حالة واحدة لا ينفع فيها أي إصلاح برمجي، ومن الأمانة قولها بصراحة: أن يكون جدول التحويل
    (ToUnicode) في ملف PDF مفقوداً أو تالفاً من الأصل. في هذه الحالة لا يحمل الملف حروفاً على الإطلاق،
    بل أرقام أشكال (glyph IDs) فقط، والمعلومة الحرفية ضائعة في المصدر نفسه. ولا تستطيع أي أداة — ولا
    هذه — أن تخترع الحروف التي لم تُحفظ؛ وكل أداة تدّعي ذلك إنما تخمّن، وقد تخرج بنص عربي جميل المنظر
    لا علاقة له بما في الصفحة.
  </p>
  <p>
    وكذلك الحال إن كان الملف ممسوحاً ضوئياً بلا طبقة نصية أصلاً: لن ينسخ القارئ شيئاً لأنه لا يجد ما
    ينسخه، وستكتشف ذلك سريعاً لأن التحديد بالفأرة لا يلتقط شيئاً.
  </p>
  <p>وحين يضيع النص، لا يبقى أمامك إلا استعادة الحروف من الصورة أو من المصدر:</p>
  <ul>
    <li>
      <strong>التعرّف الضوئي على الحروف (OCR):</strong> تُحوَّل الصفحة إلى صورة ثم يُقرأ النص منها. هذه
      هي الطريقة الوحيدة لاستعادة نص من صفحة لا تحمل نصاً، ودقّتها تعتمد على وضوح المسح ونوع الخط
      وحجمه.
    </li>
    <li>
      <strong>النسخ من المصدر الأصلي:</strong> ملف Word أو محرّر النصوص الذي صُدِّر منه PDF، أو صفحة
      الويب، أو نص البريد الذي جاء بالملف. وهذا أدقّ الحلول دائماً إن كان متاحاً.
    </li>
    <li>
      <strong>إعادة الكتابة إن كان النص قصيراً:</strong> عقد من صفحتين أو فاتورة قد تكون إعادة كتابتها
      أسرع من أي إصلاح تقني، وأضمن للنتيجة.
    </li>
  </ul>
  <p>
    وإصلاح النص العربي في هذه الأداة لا يتجاوز هذا الحد: تعالج آثار الاستخراج — الترميز، وأشكال العرض،
    والمحارف الخفية، والمسافات بين الحروف، والترتيب — ولا تقرأ الصور ولا تخترع حروفاً. وإن لم تجد شيئاً
    تُصلحه فستقول لك ذلك صراحة، وتُظهر تنبيهاً يقول إن كان النص يبدو تالفاً رغم ذلك فالسبب على الأرجح
    جدول تحويل تالف في الأصل. وكل ذلك يجري داخل متصفحك: لا رفع ولا اتصال بالشبكة ولا مكتبات خارجية،
    فتصلح الأداة لنص قد يكون خاصاً أو محمياً.
  </p>

