---
import ToolLayout from "../layouts/ToolLayout.astro";
import { allTools } from "../data/tools";

const tool = allTools.find((t) => t.slug === "password-strength-checker")!;

const faqs = [
  {
    q: "Is my password sent anywhere or stored?",
    a: "No. The check runs entirely inside this page: the value is read from the input element by JavaScript on your device, measured, and thrown away. There is no network request, no analytics on the field, no cookie and no database. You can confirm this by opening your browser's network panel or by turning off your internet connection — the tool behaves identically offline, and your password disappears the moment you reload or close the tab.",
  },
  {
    q: "What does the entropy number actually mean?",
    a: "Entropy is a measure of how many guesses an attacker needs, expressed in bits. For a password of length L drawn from an alphabet of A characters, the keyspace is A^L and the entropy is L × log2(A). Each additional bit doubles the work. The number shown here is a best case: it assumes the password really was drawn uniformly at random. Passwords chosen by a human, or built from a dictionary word plus a digit, hold far less entropy than their character count suggests, which is why the tool reduces the figure when it recognises a pattern.",
  },
  {
    q: "Are the crack times realistic?",
    a: "Treat them as a range, not a promise. 1e6 guesses per second models a well-throttled online login where the attacker must talk to the server over the network. 1e10 per second models an offline attack on a leaked database that used a fast hash such as unsalted MD5 or SHA-1. 1e12 per second models a dedicated GPU cluster, or a nation-state budget, working on a fast hash. Real servers that follow modern advice hash with bcrypt, scrypt or Argon2, which cuts the rate by many orders of magnitude — so the online column is usually the realistic one for a live account.",
  },
  {
    q: "Should I use a long passphrase or a random string?",
    a: "Random strings win when software types for you, so let a password manager generate 20 characters and stop worrying about it. Passphrases win when a human must remember and retype the secret — a master password, a device unlock, a Wi-Fi key. Four random words are decent, six or more are strong, and the words must come from a generator rather than your own head: human word choices cluster tightly and cracking tools exploit exactly that clustering.",
  },
];

const sources = [
  {
    label: "NIST SP 800-63B — Digital Identity Guidelines",
    href: "https://pages.nist.gov/800-63-3/sp800-63b.html",
    note: "The source of the modern rules: judge length and check against blocklists, do not force composition rules, and never truncate the password before hashing.",
  },
  {
    label: "OWASP Authentication Cheat Sheet",
    href: "https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html",
    note: "Practical guidance on password policy, breached-password checks, rate limiting and the hashing algorithms that make the online crack-time estimate the realistic one.",
  },
  {
    label: "MDN — Crypto.getRandomValues()",
    href: "https://developer.mozilla.org/en-US/docs/Web/API/Crypto/getRandomValues",
    note: "The API behind every random value on this site, including the strong-password generator and the suggestions offered here.",
  },
];
---

<ToolLayout
  tool={tool}
  intro="Measure a password's character pool and entropy, see how long it would survive three realistic attack rates, and get specific warnings about the patterns that make it weaker than it looks. The value never leaves your browser."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div class="field">
          <label for="pwd">Password to check</label>
          <div class="pwd-row">
            <input
              type="password"
              id="pwd"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              aria-describedby="pwdHint pwdLive"
              placeholder="Type or paste a password"
            />
            <button type="button" class="btn btn--ghost" id="toggleBtn" aria-pressed="false" aria-controls="pwd">
              Show
            </button>
            <button type="button" class="btn btn--ghost" id="clearBtn">Clear</button>
          </div>
          <p class="note" id="pwdHint">
            Checked locally, character by character, in this tab only — never transmitted, never stored.
          </p>
        </div>

        <p class="sr-only" id="pwdLive" aria-live="polite"></p>

        <div class="bar" aria-hidden="true">
          <span class="bar__fill" id="barFill"></span>
        </div>

        <div class="stat-grid" style="margin-top:1rem">
          <div class="stat">
            <div class="stat__label">Detected character pool</div>
            <div class="stat__value" id="poolValue">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">Entropy</div>
            <div class="stat__value" id="entropyValue">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">Strength</div>
            <div class="stat__value" id="strengthValue">—</div>
          </div>
        </div>

        <div class="pool-note" id="poolNote">Type a password to see which character classes are present.</div>

        <h3 class="sub">Time to crack at three attack rates</h3>
        <div class="stat-grid">
          <div class="stat">
            <div class="stat__label">Online, throttled — 1e6 guesses/s</div>
            <div class="stat__value" id="rate1">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">Offline fast hash — 1e10 guesses/s</div>
            <div class="stat__value" id="rate2">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">GPU cluster — 1e12 guesses/s</div>
            <div class="stat__value" id="rate3">—</div>
          </div>
        </div>

        <div class="warn-box" id="warnBox">
          <h3 class="sub">Pattern warnings</h3>
          <ul class="warn-list" id="warnList">
            <li class="warn-list__ok">No password entered yet.</li>
          </ul>
        </div>

        <div class="tips">
          <h3 class="sub">What to change</h3>
          <ol class="tip-list" id="tipList">
            <li>Type a password above and concrete suggestions will appear here.</li>
          </ol>
        </div>

        <p class="note">
          Reminder: this page never sends, saves or logs the value you type. There is no server-side component at all —
          the whole check is arithmetic running in this tab.
        </p>
      </div>
      <div class="panel__foot">
        Analysed locally — nothing is uploaded, echoed back or stored. Close or reload the tab and it is gone for good.
      </div>
    </div>
  </Fragment>

  <h2>How the check works</h2>
  <p>
    As you type, the page reads the value from the password field and does four things, all of them locally. First it
    inspects the characters and works out the size of the alphabet an attacker would have to search: 26 for lowercase,
    26 for uppercase, 10 for digits, about 33 for the printable symbols this tool counts, plus one slot for any other
    character such as an accented letter or an emoji. Second it computes the raw keyspace as
    <code>pool ^ length</code> and converts that to bits: <code>entropy = length × log2(pool)</code>.
  </p>
  <pre><code>16 characters, 26-letter pool  → 16 × log2(26) = 75.2 bits
16 characters, 62-char pool    → 16 × log2(62) = 95.3 bits
8 characters,  62-char pool    →  8 × log2(62) = 47.6 bits
16 characters,  1-char pool    → 16 × log2(1)  =  0.0 bits</code></pre>
  <p>
    Third, the tool hunts for the patterns that make a password dramatically cheaper to guess than its length implies.
    And fourth, it converts the resulting entropy into time at three attack rates. Two numbers are shown: the raw
    figure, which is what the string's character classes alone would give, and the adjusted figure after pattern
    penalties. The gap between them is usually the interesting part of the result.
  </p>
  <p>
    The value is compared against an embedded list of the most common passwords — the kind that appear at the very top
    of every breach corpus — plus several hundred everyday English words. Because people rarely type their password
    exactly as the dictionary lists it, the check also maps leetspeak back to plain text:
    <code>@</code> and <code>4</code> to <code>a</code>, <code>3</code> to <code>e</code>, <code>1</code>,
    <code>!</code> and <code>|</code> to <code>i</code> or <code>l</code>, <code>0</code> to <code>o</code>,
    <code>5</code> and <code>$</code> to <code>s</code>, <code>7</code> to <code>t</code>. That means
    <code>P@ssw0rd</code> and <code>passw0rd!</code> are recognised for what they are, which a naive character-class
    count would happily score as strong.
  </p>
  <p>
    A caution about the formula: <code>length × log2(pool)</code> is the correct entropy <em>only</em> for a value drawn
    uniformly at random from that pool. Human-chosen passwords are not uniform — they cluster around words, dates,
    names and keyboard runs — so the raw number is an upper bound. That is exactly why the pattern penalties exist, and
    why the adjusted figure is the one used for the strength label and the strength bar.
  </p>

  <h2>What is measured, and what is only estimated</h2>
  <p>
    The character pool, the length, and the presence of the patterns listed below are measured exactly — they are
    properties of the string itself. The crack time is an estimate, and it depends on assumptions you cannot see from
    here. It assumes the attacker knows your pool and length, that they can test guesses as fast as the stated rate,
    that the hash is unsalted and fast for the offline columns, and that they must exhaust, on average, half the
    keyspace to succeed. Two numbers are reported honestly: the time is quoted for the full keyspace, so halve it
    mentally for the average case.
  </p>
  <ul>
    <li>
      <strong>The pool figure is what you used, not what was available.</strong> A single lowercase letter in an
      otherwise numeric password widens the pool by 26 characters. The pool is a property of the string, and an
      attacker who does not know the string must assume you drew from the full printable ASCII set — a real-world
      attacker usually knows better, and uses masks and rules.
    </li>
    <li>
      <strong>Character classes are not the whole story.</strong> A 30-character password made of four distinct
      characters has the same nominal entropy as one made of thirty distinct characters under this formula, yet the
      former falls to a mask attack almost immediately. The tool flags long repeats, but no simple formula models every
      way a human builds a weak password.
    </li>
    <li>
      <strong>Breach exposure is invisible here.</strong> If your password already appears in a public breach corpus,
      its entropy is irrelevant: it will be tried first. This page has no network access by design, so it cannot check
      that for you. Services such as Have I Been Pwned offer a k-anonymity range API for exactly this, and password
      managers can check locally.
    </li>
    <li>
      <strong>Strength is not the same as safety.</strong> Password reuse, no second factor, a keylogger, or a recovery
      email that anyone can read will defeat a 200-bit password. This tool measures one property of one string.
    </li>
  </ul>

  <h2>Using it well</h2>
  <ol>
    <li>
      <strong>Check before you commit.</strong> Paste a candidate password, read the warnings, fix the string, re-check.
      Nothing you type here is stored, so it is a safe scratchpad — but it is a scratchpad, not a vault, so save the
      final value into your password manager before you close the tab.
    </li>
    <li>
      <strong>Chase the warnings, not the bar.</strong> The bar is a summary. The warnings name the specific weakness:
      a dictionary word with a leet swap, a straight keyboard run, a year, a repeated block. Fixing the named problem
      is worth more than adding a symbol to move the bar one notch.
    </li>
    <li>
      <strong>Prefer length plus randomness.</strong> If the warnings show a recognisable word, the fix is not
      <code>Word1!</code> — it is either a genuinely random 20-character string from a generator, or four or more dice
      words chosen by software with a consistent separator.
    </li>
    <li>
      <strong>Re-check after every edit.</strong> Changing <code>Summer2026</code> to <code>Summer2027</code> keeps every
      pattern problem and moves the bar a fraction. Rewriting the middle of the string is what actually changes the
      result.
    </li>
    <li>
      <strong>Remember the two things this page cannot see.</strong> Whether the password is reused elsewhere, and
      whether the service storing it hashes it properly. Both matter more than a few bits of entropy.
    </li>
  </ol>
  <div class="callout callout--warn">
    <p>
      Do not paste a password you are actively using into any site you do not control — including this one, as a matter
      of habit. This page genuinely makes no network request, but the habit is what protects you from the page that
      does. Test a variant, or generate a fresh password instead.
    </p>
  </div>

  <style is:global>
    .pwd-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }
    .pwd-row input {
      flex: 1 1 12rem;
      min-width: 0;
      font-family: var(--font-mono);
    }
    .pwd-row .btn {
      flex: none;
    }

    .bar {
      height: 12px;
      margin-top: 1rem;
      background: var(--bg-sunken);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      overflow: hidden;
    }
    .bar__fill {
      display: block;
      width: 0;
      height: 100%;
      background: var(--danger);
      border-radius: var(--radius-pill);
      transition: width 0.18s ease, background-color 0.18s ease;
    }

    .sub {
      margin: 1.4rem 0 0.6rem;
      font-size: 1rem;
    }
    .note {
      margin: 0.5rem 0 0;
      font-size: 0.84rem;
      color: var(--text-faint);
    }
    .pool-note {
      margin-top: 0.75rem;
      font-size: 0.88rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
      word-break: break-word;
    }

    .warn-box {
      margin-top: 1.4rem;
      padding: 1rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface-2);
    }
    .warn-box .sub {
      margin-top: 0;
    }
    .warn-list,
    .tip-list {
      margin: 0;
      padding-left: 1.15rem;
      display: grid;
      gap: 0.45rem;
      font-size: 0.93rem;
      color: var(--text-muted);
    }
    .warn-list {
      list-style: none;
      padding-left: 0;
    }
    .warn-list li {
      padding-left: 1.5rem;
      position: relative;
    }
    .warn-list li::before {
      position: absolute;
      left: 0;
      font-weight: 700;
    }
    .warn-list__ok {
      color: var(--ok);
    }
    .warn-list__ok::before {
      content: "✓";
    }
    .warn-list__bad {
      color: var(--danger);
    }
    .warn-list__bad::before {
      content: "!";
      color: var(--danger);
    }
    .warn-list__warn {
      color: var(--warn);
    }
    .warn-list__warn::before {
      content: "•";
      color: var(--warn);
    }
    .warn-list__bad,
    .warn-list__warn,
    .warn-list__ok {
      color: var(--text);
    }
    .warn-list__bad strong {
      color: var(--danger);
      font-family: var(--font-mono);
    }
    .warn-list__warn strong {
      color: var(--warn);
      font-family: var(--font-mono);
    }

    .tips {
      margin-top: 1.25rem;
    }
    .tip-list li {
      color: var(--text-muted);
    }

    @media (max-width: 420px) {
      .pwd-row .btn {
        flex: 1 1 100%;
      }
    }
  </style>

  <script>
    // ---------- embedded weak-password corpus (261 entries) ----------
    const COMMON: string[] = [
      // all-time classics
      "123456", "password", "123456789", "12345678", "12345", "1234567", "qwerty", "abc123", "111111", "123123",
      "1234567890", "iloveyou", "000000", "qwerty123", "1q2w3e", "1q2w3e4r", "qwertyuiop", "asdfghjkl", "zxcvbnm",
      "letmein", "monkey", "dragon", "sunshine", "princess", "football", "baseball", "superman", "batman", "trustno1",
      "welcome", "welcome1", "welcome123", "admin", "administrator", "root", "toor", "guest", "user", "test",
      "test123", "testing", "changeme", "secret", "password1", "password123", "passw0rd", "p@ssw0rd", "p@ssword",
      "password!", "p@ssword1", "passwords", "mypassword", "mypass", "mypass123",
      // familiar words used as passwords
      "flower", "whatever", "hello", "hello123", "freedom", "starwars", "pokemon", "charlie", "donald", "jordan",
      "michael", "michelle", "jennifer", "jessica", "ashley", "amanda", "hunter", "killer", "soccer", "hockey",
      "ranger", "buster", "thomas", "robert", "daniel", "joshua", "andrew", "matthew", "william", "anthony",
      "nicole", "hannah", "summer", "winter", "autumn", "spring", "cookie", "banana", "orange", "purple",
      "yellow", "silver", "golden", "diamond", "flower1", "butterfly", "rainbow", "angel", "lovely", "chocolate",
      "computer", "internet", "samsung", "google", "facebook", "linkedin", "twitter", "instagram", "whatsapp",
      "network", "server", "database", "system", "manager", "operator", "security", "default", "unknown", "shadow",
      "master", "knight", "prince", "princess1", "queen", "kingdom", "phoenix", "tigger", "pepper", "ginger",
      "peanut", "muffin", "cookie123", "coffee", "cheese", "tomato", "potato", "apple", "apple123", "mango",
      "school", "student", "teacher", "college", "university", "library", "science", "history", "mathematics", "physics",
      "family", "mother", "father", "sister", "brother", "loveme", "iloveyou1", "trustme", "forget", "remember",
      "nothing", "anything", "something", "whatever1", "whatever123", "nopassword", "letmein1", "letmein123", "openup", "opensesame",
      "business", "success", "winner", "champion", "legend", "hero", "power", "energy", "strong", "stronger",
      // keyboard and numeric runs
      "qazwsx", "qwe123", "qwerty1", "qwerty12", "asdf1234", "asdfgh", "zxcvbn", "1qaz2wsx", "1q2w3e4r5t", "zaq12wsx",
      "121212", "112233", "123321", "654321", "987654321", "666666", "888888", "999999", "777777", "555555",
      "444444", "333333", "222222", "101010", "1234", "123", "1111", "0000", "147258369", "741852963",
      "159753", "159357", "2580", "0852", "102030", "123654", "456789", "789456", "0987654321", "987654",
      // pop culture and sports
      "arsenal", "chelsea", "liverpool", "barcelona", "madrid", "juventus", "messi", "ronaldo", "neymar", "kobe",
      "gandalf", "legolas", "aragorn", "hogwarts", "snape", "dumbledore", "voldemort", "skywalker", "vader", "yoda",
      "naruto", "sasuke", "goku", "vegeta", "pikachu", "charizard", "minecraft", "fortnite", "roblox", "zelda",
      "matrix", "inception", "titanic", "avengers", "ironman", "spiderman", "hulk", "thor", "loki", "joker",
      // Arabic-transliterated and locally common choices
      "habibi", "mohammed", "muhammad", "ahmed", "mustafa", "abdullah", "khalid", "omar", "hamza", "bilal",
      "fatima", "aisha", "maryam", "zainab", "layla", "nour", "sara", "sarah", "ali", "hassan",
      "hussein", "ibrahim", "yusuf", "karim", "tariq", "salem", "faisal", "sultan", "amir", "malik",
      "cairo", "dubai", "riyadh", "beirut", "amman", "tunis", "baghdad", "damascus", "doha", "muscat",
    ];

    const DICT_WORDS: string[] = [
      "password", "passcode", "passphrase", "login", "signin", "account", "username", "secret", "private", "hidden",
      "welcome", "hello", "howdy", "goodbye", "please", "thanks", "sorry", "happy", "lucky", "sunny",
      "summer", "winter", "spring", "autumn", "january", "february", "march", "april", "august", "september",
      "october", "november", "december", "monday", "friday", "sunday", "today", "tomorrow", "yesterday", "forever",
      "always", "never", "maybe", "because", "before", "after", "again", "another", "nothing", "something",
      "anything", "everything", "someone", "anyone", "everyone", "nobody", "somewhere", "nowhere", "anywhere", "everywhere",
      "monkey", "dragon", "tiger", "lion", "eagle", "falcon", "wolf", "bear", "snake", "horse",
      "rabbit", "mouse", "panda", "koala", "dolphin", "shark", "spider", "butterfly", "unicorn", "phoenix",
      "computer", "laptop", "keyboard", "monitor", "printer", "internet", "network", "server", "database", "software",
      "hardware", "website", "browser", "mobile", "phone", "camera", "screen", "system", "program", "python",
      "javascript", "android", "windows", "linux", "apple", "google", "amazon", "microsoft", "oracle", "cisco",
      "football", "soccer", "cricket", "tennis", "basket", "baseball", "hockey", "golf", "boxing", "racing",
      "family", "mother", "father", "sister", "brother", "daughter", "friend", "lover", "darling", "honey",
      "angel", "devil", "heaven", "earth", "world", "planet", "galaxy", "rocket", "pilot", "captain",
      "master", "knight", "prince", "queen", "kingdom", "castle", "sword", "shield", "arrow", "magic",
      "wizard", "warrior", "hunter", "ranger", "ninja", "pirate", "cowboy", "doctor", "nurse", "police",
      "freedom", "victory", "champion", "winner", "legend", "hero", "power", "energy", "strong", "silver",
      "golden", "diamond", "crystal", "shadow", "thunder", "storm", "winter", "summer", "rainbow", "sunshine",
      "flower", "orange", "banana", "cherry", "cookie", "coffee", "cheese", "chocolate", "vanilla", "caramel",
      "school", "student", "teacher", "college", "science", "history", "music", "guitar", "piano", "dance",
      "coffee123", "book", "novel", "story", "movie", "cinema", "theatre", "holiday", "travel", "airport",
      "london", "paris", "berlin", "tokyo", "china", "india", "africa", "america", "canada", "brazil",
    ];

    // plain letter → the characters people substitute for it
    const LEET_GROUPS: Array<[string, string[]]> = [
      ["a", ["4", "@"]],
      ["e", ["3"]],
      ["i", ["1", "!"]],
      ["l", ["1", "|"]],
      ["o", ["0"]],
      ["s", ["5", "$"]],
      ["t", ["7"]],
      ["b", ["8"]],
      ["g", ["9"]],
    ];

    const LEET_MAP: Record<string, string> = {};
    for (const [letter, swaps] of LEET_GROUPS) {
      for (const swap of swaps) LEET_MAP[swap] = letter;
    }

    const LEET_RE = /[4@31!|057$89]/g;

    /** Undo the usual substitutions: p@ssw0rd → password, 5unsh1ne → sunshine. */
    function deLeet(value: string): string {
      return value.replace(LEET_RE, (ch) => LEET_MAP[ch] ?? ch);
    }

    const LOWER_COMMON: string[] = COMMON.map((entry) => entry.toLowerCase());

    // Entries long enough and distinctive enough that an embedded match is a real signal.
    const EMBEDDED_PHRASES: string[] = (() => {
      const set = new Set<string>();
      for (const entry of COMMON) if (entry.length >= 6) set.add(entry.toLowerCase());
      for (const word of DICT_WORDS) if (word.length >= 6) set.add(word.toLowerCase());
      const list: string[] = [];
      for (const phrase of set) list.push(phrase);
      list.sort((a, b) => b.length - a.length);
      return list;
    })();

    /** Share of the password a match has to cover before it counts as a hit. */
    function densityThreshold(length: number): number {
      if (length <= 10) return 0.55;
      if (length <= 14) return 0.65;
      return 0.75;
    }

    function embeddedMatch(lower: string, list: string[]): string | null {
      const need = Math.ceil(lower.length * densityThreshold(lower.length));
      for (const phrase of list) {
        if (phrase.length >= need && lower.includes(phrase)) return phrase;
      }
      return null;
    }

    const WORD_EMBED: string[] = (() => {
      const set = new Set<string>();
      for (const word of DICT_WORDS) if (word.length >= 6) set.add(word.toLowerCase());
      const list: string[] = [];
      for (const word of set) list.push(word);
      list.sort((a, b) => b.length - a.length);
      return list;
    })();

    // ---------- keyboards and sequences ----------
    const KEYBOARD_ROWS = [
      "1234567890-=",
      "qwertyuiop[]\\",
      "asdfghjkl;'",
      "zxcvbnm,./",
      "qazwsxedcrfvtgbyhnujmik,ol.p;/",
    ];

    function keyboardRun(lower: string): string | null {
      for (let i = 0; i + 4 <= lower.length; i++) {
        for (const row of KEYBOARD_ROWS) {
          const slice = lower.slice(i, i + 4);
          const reversed = slice.split("").reverse().join("");
          if (row.includes(slice) || row.includes(reversed)) {
            let len = 4;
            while (i + len + 1 <= lower.length) {
              const next = lower.slice(i, i + len + 1);
              const nextReversed = next.split("").reverse().join("");
              if (!row.includes(next) && !row.includes(nextReversed)) break;
              len++;
            }
            return lower.slice(i, i + len);
          }
        }
      }
      return null;
    }

    function linearRun(value: string): { kind: string; text: string } | null {
      const codes: number[] = [];
      for (const ch of value) codes.push(ch.codePointAt(0) ?? 0);
      let start = 0;
      while (start + 3 < codes.length) {
        const delta = codes[start + 1] - codes[start];
        if (delta !== 1 && delta !== -1) {
          start++;
          continue;
        }
        let end = start + 1;
        while (end + 1 < codes.length && codes[end + 1] - codes[end] === delta) end++;
        if (end - start + 1 >= 4) {
          const text = value.slice(start, end + 1);
          const allDigits = /^\d+$/.test(text);
          return { kind: allDigits ? "run of digits" : "run of letters", text };
        }
        start = end;
      }
      return null;
    }

    function repeatedRun(value: string): { size: number; count: number; span: number } | null {
      for (let size = 1; size <= Math.floor(value.length / 2); size++) {
        const block = value.slice(0, size);
        let repeats = 1;
        let index = size;
        while (index + size <= value.length && value.slice(index, index + size) === block) {
          repeats++;
          index += size;
        }
        if (repeats >= 2 && repeats * size >= 6) return { size, count: repeats, span: size };
      }
      return null;
    }

    /**
     * Repetition means less guessing work than the character count suggests: a block
     * repeated over the whole string only has to be guessed once, and a string made of
     * a single repeated character has nothing to guess beyond that character.
     */
    function effectiveLength(value: string): number {
      const length = value.length;
      if (length === 0) return 0;
      if (longestSameCharRun(value) === length) return 1;
      const repeat = repeatedRun(value);
      if (repeat && repeat.count * repeat.size >= length - 1) return repeat.span;
      const run = longestSameCharRun(value);
      return run >= 4 ? length - (run - 3) : length;
    }

    function longestSameCharRun(value: string): number {
      let best = 0;
      let run = 0;
      let previous = "";
      for (const ch of value) {
        run = ch === previous ? run + 1 : 1;
        previous = ch;
        if (run > best) best = run;
      }
      return best;
    }

    function embeddedDate(value: string): string | null {
      const year = value.match(/(19[5-9]\d|20[0-4]\d)/);
      if (year) return year[0];
      const date = value.match(/\b(\d{1,2})[./-]?(\d{1,2})[./-]?(\d{2,4})\b/);
      if (date && (date[1].length + date[2].length + date[3].length) >= 6) return date[0];
      return null;
    }

    function bestPhraseMatch(lower: string, deleeted: string): { text: string; leet: boolean } | null {
      const plain = embeddedMatch(lower, EMBEDDED_PHRASES);
      if (plain) return { text: plain, leet: false };
      if (deleeted === lower) return null;
      const viaLeet = embeddedMatch(deleeted, WORD_EMBED);
      return viaLeet ? { text: viaLeet, leet: true } : null;
    }

    // ---------- measurement ----------
    interface Finding {
      level: "danger" | "warn";
      text: string;
    }

    interface Analysis {
      length: number;
      pool: number;
      dominant: number;
      rawBits: number;
      actualBits: number;
      adjustedBits: number;
      score: number;
      label: string;
      classes: string[];
      findings: Finding[];
    }

    function classSize(ch: string): number {
      if (/[a-z]/.test(ch)) return 26;
      if (/[A-Z]/.test(ch)) return 26;
      if (/[0-9]/.test(ch)) return 10;
      if (ch.codePointAt(0)! > 127) return 100;
      if (/[ -~]/.test(ch)) return 33;
      return 33;
    }

    function analyze(value: string): Analysis {
      const chars = Array.from(value);
      const length = chars.length;
      let pool = 0;
      let dominant = 0;
      let lower = false;
      let upper = false;
      let digit = false;
      let symbol = false;
      let other = false;
      for (const ch of chars) {
        const size = classSize(ch);
        dominant = Math.max(dominant, size);
        if (/[a-z]/.test(ch)) lower = true;
        else if (/[A-Z]/.test(ch)) upper = true;
        else if (/[0-9]/.test(ch)) digit = true;
        else if (ch.codePointAt(0)! > 127) other = true;
        else symbol = true;
      }
      const classes: string[] = [];
      if (lower) {
        pool += 26;
        classes.push("lowercase a–z");
      }
      if (upper) {
        pool += 26;
        classes.push("uppercase A–Z");
      }
      if (digit) {
        pool += 10;
        classes.push("digits 0–9");
      }
      if (other) {
        pool += 100;
        classes.push("non-ASCII characters");
      }
      if (symbol) {
        pool += 33;
        classes.push("symbols and punctuation");
      }

      const effective = length > 0 ? effectiveLength(value) : 0;
      const rawBits = effective > 0 ? effective * Math.log2(Math.max(pool, 1)) : 0;
      const actualBits = length > 0 ? length * Math.log2(Math.max(pool, 1)) : 0;
      const lowerValue = value.toLowerCase();
      const deleeted = deLeet(lowerValue);
      const findings: Finding[] = [];
      let penalty = 0;

      if (COMMON.includes(lowerValue)) {
        penalty += 12;
        findings.push({
          level: "danger",
          text: "This password appears in public breach wordlists. Nothing else about it matters — it will be tried in the first few guesses.",
        });
      }

      const phrase = bestPhraseMatch(lowerValue, deleeted);
      if (phrase) {
        penalty += phrase.leet ? 7 : 6;
        findings.push({
          level: "danger",
          text: phrase.leet
            ? "Leetspeak spelling of a dictionary word: strip the substitutions (0→o, @→a, 3→e, 5→s, 1→i) and this reads as “" +
              phrase.text +
              "”. Every cracking tool applies those swaps as its first rule."
            : "Contains the common word or password “" +
              phrase.text +
              "”, which is a large share of the whole value. Dictionary and rule-based attacks test exactly this kind of string first.",
        });
      }

      const sameRun = longestSameCharRun(value);
      if (sameRun >= 4) {
        penalty += 3;
        findings.push({
          level: "danger",
          text: sameRun + " identical characters in a row (“" + value.slice(0, 1) + "”). Repetition adds length without adding guessing work.",
        });
      }

      const repeat = repeatedRun(lowerValue);
      if (repeat && sameRun < 4) {
        penalty += 3;
        findings.push({
          level: "warn",
          text: "A block repeats " + repeat.count + " times (a " + repeat.size + "-character block), so only that block has to be guessed.",
        });
      }

      const lowerRun = linearRun(value);
      if (lowerRun) {
        penalty += 4;
        findings.push({
          level: "warn",
          text: "A straight " + lowerRun.kind + " (“" + lowerRun.text + "”) is on every attacker's short list of first attempts.",
        });
      }

      const kb = keyboardRun(lowerValue);
      if (kb) {
        penalty += 4;
        findings.push({
          level: "warn",
          text: "A straight keyboard run (“" + kb + "”) is one of the first patterns cracking tools try, in either direction.",
        });
      }

      const date = embeddedDate(value);
      if (date) {
        penalty += 3;
        findings.push({
          level: "warn",
          text: "An embedded date or year (“" + date + "”) is guessed early: such patterns cover only a few thousand realistic options.",
        });
      }

      let adjusted = rawBits;
      const dictionaryDriven = COMMON.includes(lowerValue) || phrase !== null;
      if (dictionaryDriven) adjusted = Math.min(adjusted, 22);
      adjusted = Math.max(0, adjusted - penalty * 1.6);
      if (effective > 0 && adjusted > effective * Math.log2(200)) adjusted = effective * Math.log2(200);

      if (length > 0 && findings.length === 0) {
        findings.push({
          level: "warn",
          text: "No known weak pattern was detected in this string. That does not prove it is randomly chosen — the formula still assumes it is.",
        });
      }

      let score = 0;
      if (length > 0) {
        score =
          5 +
          Math.min(4, Math.max(0, (Math.min(length, 24) - 8) / 4)) +
          (lower ? 0.75 : 0) +
          (upper ? 0.75 : 0) +
          (digit ? 0.5 : 0) +
          (symbol ? 0.5 : 0) -
          penalty;
        if (score < 0) score = 0;
        if (score > 5) score = 5;
      }

      let label = "—";
      if (length > 0) {
        if (adjusted < 28) label = "Very weak";
        else if (adjusted < 36) label = "Weak";
        else if (adjusted < 60) label = "Fair";
        else if (adjusted < 90) label = "Strong";
        else label = "Very strong";
      }

      return { length, pool, dominant, rawBits, actualBits, adjustedBits: adjusted, score, label, classes, findings };
    }

    // ---------- formatting ----------
    function humanTime(seconds: number): string {
      if (!isFinite(seconds) || seconds >= 3.15e15) return "centuries";
      if (seconds < 1) return "well under a second";
      const units: Array<[number, string]> = [
        [60, "second"],
        [3600, "minute"],
        [86400, "hour"],
        [31557600, "day"],
        [31557600 * 100, "year"],
        [31557600 * 10000, "century"],
      ];
      let chosen: [number, string] = units[0];
      for (const unit of units) {
        if (seconds >= unit[0]) chosen = unit;
      }
      const value = seconds / chosen[0];
      const rounded = value >= 100 ? Math.round(value) : value >= 10 ? Math.round(value * 10) / 10 : Math.round(value * 100) / 100;
      const plural = rounded === 1 ? "" : chosen[1].endsWith("y") ? "ies" : "s";
      const unit = rounded === 1 || !chosen[1].endsWith("y") ? chosen[1] : chosen[1].slice(0, -1);
      return "about " + rounded.toLocaleString("en-US") + " " + unit + plural;
    }

    function timeAtRate(bits: number, rate: number): string {
      if (bits <= 0) return "instantly";
      const seconds = Math.pow(2, bits) / rate;
      return humanTime(seconds);
    }

    // ---------- rendering ----------
    const byId = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

    function clearNode(node: HTMLElement): void {
      node.textContent = "";
    }

    function suggest(a: Analysis): string[] {
      const tips: string[] = [];
      const raw = byId<HTMLInputElement>("pwd").value;
      const lowerValue = raw.toLowerCase();
      const phrase = bestPhraseMatch(lowerValue, deLeet(lowerValue));
      const repeated = repeatedRun(lowerValue);
      const run = linearRun(raw);
      const keyboard = keyboardRun(lowerValue);
      const date = embeddedDate(raw);

      if (COMMON.includes(lowerValue)) {
        tips.push("Replace it entirely: this exact string sits near the top of every breach corpus. A new 20-character random password is the only fix worth making.");
      }
      if (phrase) {
        if (phrase.leet) {
          tips.push("Undo the decoration rather than adding more of it: the substitutions hide a plain word, and rule-based cracking tools undo them automatically. Three software-chosen words joined by hyphens would be genuinely stronger.");
        } else {
          tips.push("Drop the word “" + phrase.text + "” instead of decorating it. Turning a into @ and o into 0 is rule 1 in every cracking tool; software-chosen words beat a human-chosen word every time.");
        }
      }
      if (repeated) {
        tips.push("Replace the repeated block with unrelated characters. Guessing a 6-character block once and repeating it adds almost nothing over the shorter string.");
      }
      if (keyboard) {
        tips.push("Break up the keyboard run “" + keyboard + "” — insert two characters that are not neighbours on the same row, or drop the run and use a generated string.");
      }
      if (run) {
        tips.push("Break the straight " + run.kind + " “" + run.text + "” by inserting an unrelated character between its elements.");
      }
      if (date) {
        tips.push("Remove the date or year “" + date + "” altogether. Years, birthdays and anniversaries are covered by a few thousand guesses.");
      }
      if (a.length > 0 && a.length < 12) {
        tips.push("Go longer, and let software choose the characters. This password is " + a.length + " characters; a managed 20-character random value is far easier to live with than a 12-character one you have to invent.");
      } else if (a.length > 0 && a.length < 16) {
        tips.push("Aim for at least 16 characters. If a site caps you below that, switch on two-factor authentication and treat the cap as a reason to stop reusing it.");
      }
      if (a.dominant > 0 && a.pool === 10) {
        tips.push("Digits alone are a tiny space. Add letters and, if the site allows them, symbols — or better, abandon the pattern entirely.");
      }
      if (a.length > 0 && a.pool < 62 && a.pool > 0) {
        tips.push("Widen the character pool as well as the length: lowercase plus uppercase plus digits plus symbols moves the pool from a few dozen to roughly 95 possibilities per character.");
      }
      if (a.length >= 12 && a.findings.every((f) => !f.text.startsWith("No known weak pattern"))) {
        tips.push("Save this one in a password manager now, and use it on exactly one account. Reuse is what turns somebody else's breach into your problem.");
      }
      if (tips.length === 0) {
        tips.push("Nothing weak was detected. Keep it unique to this one account, store it in a password manager, and enable two-factor authentication where the service offers it.");
      }
      return tips;
    }

    function render(): void {
      const input = byId<HTMLInputElement>("pwd");
      const value = input.value;
      const a = analyze(value);

      const fill = byId<HTMLElement>("barFill");
      const percent = Math.round((a.score / 5) * 100);
      fill.style.width = percent + "%";
      fill.style.background = a.adjustedBits >= 60 ? "var(--ok)" : a.adjustedBits >= 36 ? "var(--warn)" : "var(--danger)";

      byId<HTMLElement>("poolValue").textContent = a.pool > 0 ? a.pool + " characters" : "—";
      byId<HTMLElement>("entropyValue").textContent =
        a.length > 0 ? a.actualBits.toFixed(1) + " bits raw · " + a.adjustedBits.toFixed(1) + " adjusted" : "—";
      byId<HTMLElement>("strengthValue").textContent = a.label;

      const poolNote = byId<HTMLElement>("poolNote");
      if (a.length === 0) {
        poolNote.textContent = "Type a password to see which character classes are present.";
      } else {
        poolNote.textContent =
          a.length +
          " characters · detected classes: " +
          (a.classes.length ? a.classes.join(", ") : "none") +
          " · " +
          a.length +
          " × log2(" +
          a.pool +
          ") = " +
          a.actualBits.toFixed(1) +
          " bits" +
          (a.rawBits < a.actualBits
            ? " · repetition reduces the guessable length to " + Math.round(a.rawBits / Math.log2(Math.max(a.pool, 1))) + " characters"
            : "");
      }

      byId<HTMLElement>("rate1").textContent = a.length > 0 ? timeAtRate(a.adjustedBits, 1e6) : "—";
      byId<HTMLElement>("rate2").textContent = a.length > 0 ? timeAtRate(a.adjustedBits, 1e10) : "—";
      byId<HTMLElement>("rate3").textContent = a.length > 0 ? timeAtRate(a.adjustedBits, 1e12) : "—";

      const warnList = byId<HTMLUListElement>("warnList");
      clearNode(warnList);
      if (a.length === 0) {
        const item = document.createElement("li");
        item.className = "warn-list__ok";
        item.textContent = "No password entered yet.";
        warnList.appendChild(item);
      } else {
        for (const finding of a.findings) {
          const item = document.createElement("li");
          item.className = finding.level === "danger" ? "warn-list__bad" : "warn-list__warn";
          const strong = document.createElement("strong");
          strong.textContent = finding.level === "danger" ? "Weak: " : "Attention: ";
          item.appendChild(strong);
          item.appendChild(document.createTextNode(finding.text));
          warnList.appendChild(item);
        }
      }

      const tipList = byId<HTMLOListElement>("tipList");
      clearNode(tipList);
      for (const tip of suggest(a)) {
        const item = document.createElement("li");
        item.textContent = tip;
        tipList.appendChild(item);
      }

      const live = byId<HTMLElement>("pwdLive");
      if (a.length === 0) {
        live.textContent = "No password entered.";
      } else {
        live.textContent =
          a.length +
          " characters. Pool " +
          a.pool +
          ". " +
          a.adjustedBits.toFixed(1) +
          " bits of entropy. Strength: " +
          a.label +
          ". Estimated times to crack: " +
          timeAtRate(a.adjustedBits, 1e6) +
          " online, " +
          timeAtRate(a.adjustedBits, 1e10) +
          " offline against a fast hash, " +
          timeAtRate(a.adjustedBits, 1e12) +
          " on a GPU cluster.";
      }
    }

    function init(): void {
      const input = byId<HTMLInputElement>("pwd");
      const toggle = byId<HTMLButtonElement>("toggleBtn");

      toggle.addEventListener("click", () => {
        const show = input.type === "password";
        input.type = show ? "text" : "password";
        toggle.textContent = show ? "Hide" : "Show";
        toggle.setAttribute("aria-pressed", String(show));
      });

      byId<HTMLButtonElement>("clearBtn").addEventListener("click", () => {
        input.value = "";
        input.focus();
        render();
      });

      input.addEventListener("input", render);

      const form = input.closest("form");
      if (form) form.addEventListener("submit", (event) => event.preventDefault());

      render();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>
</ToolLayout>
