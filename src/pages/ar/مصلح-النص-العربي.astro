      }

      /* ---------------- ١) إصلاح الترميز (mojibake) ---------------- */

      // إعادة كل محرف إلى بايته. المسار الأول هو القراءة اللاتينية القياسية
      // (codeUnit & 0xff)، والمسار الثاني يعيد محارف windows-1252 المطبعية إلى
      // بايتاتها الأصلية، لأن كثراً من البرامج تقرأ UTF-8 بها لا بـ Latin-1.
      function decodeRun(run, useCp1252) {
        var bytes = new Uint8Array(run.length);
        for (var i = 0; i < run.length; i += 1) {
          var ch = run.charAt(i);
          var code = ch.charCodeAt(0);
          var mapped = CP1252[ch];
          bytes[i] =
            useCp1252 && code > 0xff && typeof mapped === "number"
              ? mapped
              : code & 0xff;
        }
        return UTF8.decode(bytes);
      }

      // كل مقطع على حدة: فإصلاح جزء مكسور لا يمسّ ما كُتب سليماً في موضع آخر.
      function repairEncoding(text) {
        var result = { found: false, blocked: false, changed: false, text: text };
        if (!UTF8) return result;

        result.text = text.replace(BYTE_RUN, function (run) {
          var before = countArabicLetters(run);
          var needsCp1252 = /[^\u0000-\u00FF]/.test(run);
          var decoded = decodeRun(run, needsCp1252);
          if (decoded.indexOf(FFFD) !== -1) decoded = decodeRun(run, !needsCp1252);

          var after = countArabicLetters(decoded);

          // إن بقي محرف غير صالح فالفكّ غير آمن: لا نُطبّقه أبداً.
          if (decoded.indexOf(FFFD) !== -1) {
            if (after > before) result.blocked = true;
            return run;
          }
          // الشرط الوحيد للقبول: حروف عربية أكثر مما كان.
          if (after > before) {
            result.found = true;
            result.changed = true;
            return decoded;
          }
          return run;
        });

        return result;
      }

      /* ---------------- ٤) المسافات بين الحروف المفردة ---------------- */

      // تُحذف المسافة فقط إذا كان الحرف قبلها والحرف بعدها حرفين عربيين مفردين،
      // أي غير ملتصقين بحرف آخر. فلا تُدمج كلمتان حقيقيتان أبداً.
      function collapseLetterSpacing(text) {
        var chars = Array.from(text);
        var letterAt = function (i) {
          return i >= 0 && i < chars.length && AR_LETTER.test(chars[i]) === true;
        };
        var out = [];
        var joins = 0;
        for (var i = 0; i < chars.length; i += 1) {
          if (
            chars[i] === " " &&
            letterAt(i - 1) &&
            !letterAt(i - 2) &&
            letterAt(i + 1) &&
            !letterAt(i + 2)
          ) {
            joins += 1;
            continue;
          }
          out.push(chars[i]);
        }
        return { text: out.join(""), joins: joins };
      }

      /* ---------------- ٥) الترتيب ---------------- */

      // كل سطر على حدة، حتى لا تنتقل الأسطر من مواضعها.
      function mapLines(text, fn) {
        return text
          .split(/(\r\n|\r|\n)/)
          .map(function (part, index) {
            return index % 2 === 1 ? part : fn(part);
          })
          .join("");
      }

      function reverseCharacters(line) {
        var core = line.trim();
        if (!core) return line;
        var lead = /^\s/.test(line) ? " " : "";
        var tail = /\s$/.test(line) ? " " : "";
        return lead + Array.from(core).reverse().join("") + tail;
      }

      function reverseWordOrder(line) {
        var words = line.split(/\s+/).filter(function (word) {
          return word.length > 0;
        });
        if (words.length < 2) return line;
        var lead = /^\s/.test(line) ? " " : "";
        var tail = /\s$/.test(line) ? " " : "";
        return lead + words.reverse().join(" ") + tail;
      }

      /* ---------------- الخطّ الأنبوبي ---------------- */

      function runPipeline(raw, opts) {
        var report = {
          encoding: false,
          encodingBlocked: false,
          forms: false,
          hidden: 0,
          spacing: 0
        };
        var applied = { hidden: false, encoding: false, forms: false, spacing: false };
        var text = raw;

        // ١) المحارف الخفية أولاً، لأنها تقطع مقاطع الترميز وتُفشل فكّه.
        report.hidden = countHidden(text);
        if (report.hidden > 0 && opts.hidden) {
          var noHidden = text.replace(HIDDEN_ALL, "");
          applied.hidden = noHidden !== text;
          text = noHidden;
        }

        // ٢) الترميز: UTF-8 قُرئ بترميز لاتيني.
        var encoding = repairEncoding(text);
        report.encoding = encoding.found;
        report.encodingBlocked = encoding.blocked;
        if (encoding.changed && opts.encoding) {
          text = encoding.text;
          applied.encoding = true;
        }

        // ٣) أشكال العرض: NFKC يعيد كل شكل إلى حرفه الأساسي.
        if (PRESENTATION.test(text)) {
          report.forms = true;
          if (opts.forms) {
            var composed = text.normalize("NFKC");
            applied.forms = composed !== text;
            text = composed;
          }
        }

        // ٤) المسافات بين الحروف المفردة.
        var spacing = collapseLetterSpacing(text);
        report.spacing = spacing.joins;
        if (spacing.joins > 0 && opts.spacing) {
          text = spacing.text;
          applied.spacing = true;
        }

        // ٥) الترتيب: لا يحدث إلا بطلب صريح من المستخدم.
        if (opts.order === "chars") text = mapLines(text, reverseCharacters);
        else if (opts.order === "words") text = mapLines(text, reverseWordOrder);

        return { text: text, report: report, applied: applied };
      }

      /* ---------------- الكلمات الشائعة (لاقتراح القلب فقط) ---------------- */

      function normalizeWord(word) {
