<script>
  /* ================================================================
     محوّل التقويم الهجري والميلادي — كل الحساب داخل المتصفح وحده.
     البيانات تأتي من تقويم islamic-umalqura المدمج في المتصفح.
     ================================================================ */

  var ARABIC_DIGITS = "٠١٢٣٤٥٦٧٨٩";
  var DAY_MS = 86400000;
  var CALENDAR = "islamic-umalqura";

  var arabicDigits = function (value) {
    return String(value).replace(/[0-9]/g, function (digit) {
      return ARABIC_DIGITS[Number(digit)];
    });
  };
  var latinDigits = function (value) {
    return String(value);
  };

  var hijriParts = new Intl.DateTimeFormat("en-US-u-ca-" + CALENDAR, {
    day: "numeric",
    month: "numeric",
    year: "numeric"
  });
  var hijriMonthName = new Intl.DateTimeFormat("ar-SA-u-ca-" + CALENDAR, { month: "long" });
  var weekdayName = new Intl.DateTimeFormat("ar-SA-u-ca-gregory", { weekday: "long" });
  var gregorianDisplay = new Intl.DateTimeFormat("ar-SA-u-ca-gregory-nu-latn", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });

  /* ---------- أدوات التاريخ: أرقام أيام ثابتة لا تتأثر بالتوقيت الصيفي ---------- */

  var dayNumberOf = function (date) {
    return Math.round(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_MS);
  };
  var dateOfDayNumber = function (number) {
    var utc = new Date(number * DAY_MS);
    return new Date(utc.getUTCFullYear(), utc.getUTCMonth(), utc.getUTCDate());
  };
  var todayDate = function () {
    var now = new Date();
    return new Date(now.getFullYear(), now.getMonth(), now.getDate());
  };
  var pad2 = function (value) {
    return String(value).padStart(2, "0");
  };
  var isoOf = function (date) {
    return date.getFullYear() + "-" + pad2(date.getMonth() + 1) + "-" + pad2(date.getDate());
  };
  var dateFromIso = function (value) {
    var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || "");
    if (!match) return null;
    var year = Number(match[1]);
    var month = Number(match[2]);
    var day = Number(match[3]);
    var date = new Date(year, month - 1, day);
    if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) return null;
    return date;
  };

  /* ---------- تقويم أم القرى: الثلاثية الهجرية <-> رقم اليوم الميلادي ---------- */

  var hijriOnDayNumber = function (number) {
    var parts = hijriParts.formatToParts(dateOfDayNumber(number));
    var year = 0;
    var month = 0;
    var day = 0;
    for (var i = 0; i < parts.length; i += 1) {
      if (parts[i].type === "year") year = Number(parts[i].value);
      else if (parts[i].type === "month") month = Number(parts[i].value);
      else if (parts[i].type === "day") day = Number(parts[i].value);
    }
    return { year: year, month: month, day: day };
  };

  /* نافذة البحث الميلادية أوسع قليلاً من النطاق المعلن، ثم نضبط حدّي النطاق بالتقويم الهجري نفسه. */
  var SEARCH_START = dayNumberOf(new Date(1937, 0, 1));
  var SEARCH_END = dayNumberOf(new Date(2077, 11, 31));
  var SEARCH_FIRST = hijriOnDayNumber(SEARCH_START);
  var SEARCH_LAST = hijriOnDayNumber(SEARCH_END);

  var compare = function (a, b) {
    return a.year - b.year || a.month - b.month || a.day - b.day;
  };

  /* Intl ينسّق ولا يحلّل: نبحث ثنائياً عن أول يوم ميلادي لا يسبق التاريخ الهجري المطلوب. */
  var searchDay = function (year, month, day) {
    var target = { year: year, month: month, day: day };
    if (compare(SEARCH_FIRST, target) > 0 || compare(SEARCH_LAST, target) < 0) return null;
    var low = SEARCH_START;
    var high = SEARCH_END;
    while (low < high) {
      var mid = low + Math.floor((high - low) / 2);
      if (compare(hijriOnDayNumber(mid), target) < 0) low = mid + 1;
      else high = mid;
    }
    return compare(hijriOnDayNumber(low), target) === 0 ? low : null;
  };

  /* النطاق المعلن: من ١ محرم ١٣٥٦ هـ إلى آخر يوم من ذي الحجة ١٥٠٠ هـ (١٩٣٧–٢٠٧٧ م). */
  var RANGE_FIRST = { year: 1356, month: 1, day: 1 };
  var AFTER_RANGE = searchDay(1501, 1, 1);
  var RANGE_LAST = hijriOnDayNumber(AFTER_RANGE === null ? SEARCH_END : AFTER_RANGE - 1);

  var inRange = function (triple) {
    return compare(triple, RANGE_FIRST) >= 0 && compare(triple, RANGE_LAST) <= 0;
  };

  var hijriToDayNumber = function (year, month, day) {
    var target = { year: year, month: month, day: day };
    if (!inRange(target)) return null;
    return searchDay(year, month, day);
  };

  var FALLBACK_MONTHS = [
    "محرم", "صفر", "ربيع الأول", "ربيع الآخر", "جمادى الأولى", "جمادى الآخرة",
    "رجب", "شعبان", "رمضان", "شوال", "ذو القعدة", "ذو الحجة"
  ];

  /* أسماء الأشهر تُقرأ من بيانات المتصفح نفسه، ولها قائمة احتياطية إن فشل ذلك. */
  var readMonthNames = function () {
    var names = [];
    for (var month = 1; month <= 12; month += 1) {
      var day = hijriToDayNumber(1446, month, 1);
      if (day === null) return FALLBACK_MONTHS.slice();
      var name = hijriMonthName.format(dateOfDayNumber(day)).replace(/[٠-٩0-9]/g, "").trim();
      if (!name) return FALLBACK_MONTHS.slice();
      names.push(name);
    }
    return names;
  };
  var MONTHS = readMonthNames();

  var monthLength = function (year, month) {
    var first = searchDay(year, month, 1);
    if (first === null) return 30;
    var nextYear = month === 12 ? year + 1 : year;
    var nextMonth = month === 12 ? 1 : month + 1;
    var next = searchDay(nextYear, nextMonth, 1);
    return next === null ? 30 : next - first;
  };

  /* ---------- صياغة العبارات العربية ---------- */

  var hijriSentence = function (triple, date) {
    return weekdayName.format(date) + " " + arabicDigits(triple.day) + " " +
      MONTHS[triple.month - 1] + " " + arabicDigits(triple.year) + " هـ";
  };

  var unitPhrase = function (count, one, two, many, format) {
    if (count === 1) return one;
    if (count === 2) return two;
    if (count >= 3 && count <= 10) return format(count) + " " + many;
    return format(count) + " " + one.replace(/ واحد$/, "");
  };

  var joinParts = function (parts) {
    var kept = [];
    for (var i = 0; i < parts.length; i += 1) {
      if (parts[i].count > 0) kept.push(parts[i]);
    }
    if (!kept.length) return "أقل من يوم";
    var words = [];
    for (var j = 0; j < kept.length; j += 1) {
      var part = kept[j];
      words.push(unitPhrase(part.count, part.one, part.two, part.many, part.format));
    }
    return words.join(" و");
  };

  var hijriAgeParts = function (age, format) {
    return [
      { count: age.years, one: "سنة واحدة", two: "سنتان", many: "سنوات", format: format },
      { count: age.months, one: "شهر واحد", two: "شهران", many: "أشهر", format: format },
      { count: age.days, one: "يوم واحد", two: "يومان", many: "أيام", format: format }
    ];
  };

  /* ---------- الحساب بالاستعارة، لا بقسمة مجموع الأيام ---------- */

  var hijriAgeBetween = function (from, to) {
    var years = to.year - from.year;
    var months = to.month - from.month;
    var days = to.day - from.day;
    if (days < 0) {
      months -= 1;
      var prevMonth = to.month === 1 ? 12 : to.month - 1;
      var prevYear = to.month === 1 ? to.year - 1 : to.year;
      days += monthLength(prevYear, prevMonth);
    }
    if (months < 0) {
      years -= 1;
      months += 12;
    }
    return { years: years, months: months, days: days };
  };

  var gregorianAgeBetween = function (from, to) {
    var years = to.getFullYear() - from.getFullYear();
    var months = to.getMonth() - from.getMonth();
    var days = to.getDate() - from.getDate();
    if (days < 0) {
      months -= 1;
      var prevMonth = to.getMonth() === 0 ? 11 : to.getMonth() - 1;
      var prevYear = to.getMonth() === 0 ? to.getFullYear() - 1 : to.getFullYear();
      days += new Date(prevYear, prevMonth + 1, 0).getDate();
    }
    if (months < 0) {
      years -= 1;
      months += 12;
    }
    return { years: years, months: months, days: days };
  };

  var nextHijriBirthday = function (birth, todayTriple, todayNumber) {
    for (var step = 0; step <= 2; step += 1) {
      var year = todayTriple.year + step;
      var length = monthLength(year, birth.month);
      var day = Math.min(birth.day, length);
      var number = hijriToDayNumber(year, birth.month, day);
      if (number === null) continue;
      if (number >= todayNumber) return { dayNumber: number, days: number - todayNumber };
    }
    return null;
  };

  /* ---------- عناصر الصفحة ---------- */

  var byId = function (id) {
    return document.getElementById(id);
  };
  var el = {
    dirG: byId("hij-dir-g"),
    dirH: byId("hij-dir-h"),
    sideG: byId("hij-side-g"),
    sideH: byId("hij-side-h"),
    g: byId("hij-g"),
    hd: byId("hij-hd"),
    hm: byId("hij-hm"),
    hy: byId("hij-hy"),
    todayButton: byId("hij-today"),
    out: byId("hij-out"),
    outAlt: byId("hij-out-alt"),
    verified: byId("hij-verified"),
    warn: byId("hij-warn"),
    warnText: byId("hij-warn-text"),
    born: byId("hij-born"),
    until: byId("hij-until"),
    bornNote: byId("hij-born-hijri"),
    ageHij: byId("hij-age-hij"),
    ageGreg: byId("hij-age-greg"),
    ageDays: byId("hij-age-days"),
    ageNext: byId("hij-age-next"),
    ageWarn: byId("hij-age-warn"),
    ageWarnText: byId("hij-age-warn-text"),
    from: byId("hij-from"),
    to: byId("hij-to"),
    diffDays: byId("hij-diff-days"),
    diffWeeks: byId("hij-diff-weeks"),
    diffHijri: byId("hij-diff-hijri"),
    diffNote: byId("hij-diff-note"),
    gridCaption: byId("hij-grid-cap"),
    gridBody: byId("hij-grid-body")
  };

  var direction = "g2h";

  var showWarn = function (box, textNode, message) {
    if (!box || !textNode) return;
    textNode.textContent = message;
    box.hidden = false;
  };
  var hideWarn = function (box) {
    if (box) box.hidden = true;
  };
  var setOut = function (text, state) {
    el.out.textContent = text;
    el.out.dataset.state = state;
  };
  var blankAge = function () {
    el.ageHij.textContent = "—";
    el.ageGreg.textContent = "—";
    el.ageDays.textContent = "—";
    el.ageNext.textContent = "—";
  };

  var fillHijriFields = function (triple) {
    el.hd.value = String(triple.day);
    el.hm.value = String(triple.month);
    el.hy.value = String(triple.year);
  };

  /* ---------- جدول الشهر ---------- */

  var renderGrid = function (year, month) {
    var first = hijriToDayNumber(year, month, 1);
    el.gridBody.replaceChildren();
    if (first === null) {
      el.gridCaption.textContent = "لا تتوفر بيانات أم القرى لهذا الشهر داخل متصفحك.";
      return;
    }
    var length = monthLength(year, month);
    var last = first + length - 1;
    el.gridCaption.textContent = "شهر " + MONTHS[month - 1] + " " + arabicDigits(year) +
      " هـ — الموافق " + gregorianDisplay.format(dateOfDayNumber(first)) + " إلى " +
      gregorianDisplay.format(dateOfDayNumber(last)) + " م. الرقم الأعلى هو اليوم الهجري، والأسفل هو يوم الشهر الميلادي.";

    var lead = dateOfDayNumber(first).getDay();
    var todayNumber = dayNumberOf(todayDate());
    var row = document.createElement("tr");
    var cells = 0;

    for (var i = 0; i < lead; i += 1) {
      var empty = document.createElement("td");
      empty.className = "hij-cell-empty";
      row.append(empty);
      cells += 1;
    }

    for (var day = 1; day <= length; day += 1) {
      if (cells === 7) {
        el.gridBody.append(row);
        row = document.createElement("tr");
        cells = 0;
      }
      var number = first + day - 1;
      var date = dateOfDayNumber(number);
      var cell = document.createElement("td");
      var main = document.createElement("span");
      main.className = "hij-cell-day";
      main.textContent = arabicDigits(day);
      var sub = document.createElement("span");
      sub.className = "hij-cell-sub";
      sub.textContent = latinDigits(date.getDate());
      cell.append(main, sub);
      if (number === todayNumber) {
        cell.classList.add("is-today");
        cell.setAttribute("aria-current", "date");
      }
      cell.setAttribute("aria-label", hijriSentence({ year: year, month: month, day: day }, date) +
        " — الموافق " + gregorianDisplay.format(date) + " م" + (number === todayNumber ? "، وهو اليوم" : ""));
      row.append(cell);
      cells += 1;
    }
    if (cells > 0) el.gridBody.append(row);
  };

  /* ---------- المحوّل ---------- */

  var runConvert = function () {
    hideWarn(el.warn);
    el.verified.hidden = true;

    if (direction === "g2h") {
      var date = dateFromIso(el.g.value);
      if (!date) {
        setOut("اختر تاريخاً ميلادياً صحيحاً.", "muted");
        el.outAlt.textContent = "";
        return;
      }
      var number = dayNumberOf(date);
      var triple = hijriOnDayNumber(number);
      fillHijriFields(triple);
      setOut(hijriSentence(triple, date), "ok");
      el.outAlt.textContent = "الموافق " + gregorianDisplay.format(date) + " م";
      if (inRange(triple)) {
        var back = hijriToDayNumber(triple.year, triple.month, triple.day);
        if (back === number) el.verified.hidden = false;
      } else {
        showWarn(el.warn, el.warnText,
          "هذا التاريخ خارج نطاق بيانات تقويم أم القرى في متصفحك، وهي تغطي نحو 1356–1500 هـ (1937–2077 م). النتيجة المعروضة تقديرية ولا يُعتمد عليها.");
      }
      renderGrid(triple.year, triple.month);
      return;
    }

    var day = Number(el.hd.value);
    var month = Number(el.hm.value);
    var year = Number(el.hy.value);
    if (!el.hd.value || !el.hy.value || !Number.isInteger(day) || !Number.isInteger(month) ||
        !Number.isInteger(year) || month < 1 || month > 12) {
      setOut("أكمل اليوم والشهر والسنة الهجرية.", "muted");
      el.outAlt.textContent = "";
      return;
    }

    var target = { year: year, month: month, day: day };
    var found = hijriToDayNumber(year, month, day);
    if (found === null) {
      setOut("تعذّر التحويل.", "muted");
      el.outAlt.textContent = "";
      if (!inRange(target)) {
        showWarn(el.warn, el.warnText,
          "هذا التاريخ خارج النطاق المدعوم: بيانات أم القرى في المتصفح تغطي نحو 1356–1500 هـ، أي ما يوافق 1937–2077 م.");
      } else {
        showWarn(el.warn, el.warnText,
          "اليوم " + arabicDigits(day) + " غير موجود في " + MONTHS[month - 1] + " " + arabicDigits(year) +
          " هـ؛ أقصى هذا الشهر " + arabicDigits(monthLength(year, month)) + " يوماً.");
      }
      return;
    }

    var gregorian = dateOfDayNumber(found);
    el.g.value = isoOf(gregorian);
    setOut(hijriSentence(target, gregorian), "ok");
    el.outAlt.textContent = "الموافق " + gregorianDisplay.format(gregorian) + " م";
    if (compare(hijriOnDayNumber(dayNumberOf(gregorian)), target) === 0) el.verified.hidden = false;
    renderGrid(year, month);
  };

  var setDirection = function (next) {
    direction = next;
    var gregorianFirst = next === "g2h";
    el.dirG.setAttribute("aria-pressed", gregorianFirst ? "true" : "false");
    el.dirH.setAttribute("aria-pressed", gregorianFirst ? "false" : "true");
    el.sideG.dataset.active = gregorianFirst ? "true" : "false";
    el.sideH.dataset.active = gregorianFirst ? "false" : "true";
    runConvert();
  };

  /* ---------- حاسبة العمر ---------- */

  var updateAge = function () {
    hideWarn(el.ageWarn);
    var bornDate = dateFromIso(el.born.value);
    var untilDate = dateFromIso(el.until.value) || todayDate();

    if (!bornDate) {
      el.bornNote.textContent = "اكتب تاريخ ميلادك لعرض العمر بالتقويمين.";
      blankAge();
      return;
    }
    if (untilDate.getTime() < bornDate.getTime()) {
      showWarn(el.ageWarn, el.ageWarnText, "تاريخ «حتى تاريخ» يسبق تاريخ الميلاد، فلا يوجد عمر يُحسب.");
      el.bornNote.textContent = "";
      blankAge();
      return;
    }

    var bornNumber = dayNumberOf(bornDate);
    var untilNumber = dayNumberOf(untilDate);
    var bornHijri = hijriOnDayNumber(bornNumber);
    var untilHijri = hijriOnDayNumber(untilNumber);

    el.bornNote.textContent = "تاريخ ميلادك هجرياً: " + arabicDigits(bornHijri.day) + " " +
      MONTHS[bornHijri.month - 1] + " " + arabicDigits(bornHijri.year) + " هـ";

    var totalDays = untilNumber - bornNumber;
    el.ageDays.textContent = latinDigits(totalDays);

    var gregorianAge = gregorianAgeBetween(bornDate, untilDate);
    el.ageGreg.textContent = joinParts([
      { count: gregorianAge.years, one: "سنة واحدة", two: "سنتان", many: "سنوات", format: latinDigits },
      { count: gregorianAge.months, one: "شهر واحد", two: "شهران", many: "أشهر", format: latinDigits },
      { count: gregorianAge.days, one: "يوم واحد", two: "يومان", many: "أيام", format: latinDigits }
    ]);

    if (inRange(bornHijri) && inRange(untilHijri)) {
      var hijriAge = hijriAgeBetween(bornHijri, untilHijri);
      el.ageHij.textContent = joinParts(hijriAgeParts(hijriAge, arabicDigits));
      var next = nextHijriBirthday(bornHijri, untilHijri, untilNumber);
      if (next === null) el.ageNext.textContent = "غير متاح";
      else if (next.days === 0) el.ageNext.textContent = "اليوم";
      else el.ageNext.textContent = joinParts([
        { count: next.days, one: "يوم واحد", two: "يومان", many: "أيام", format: arabicDigits }
      ]);
    } else {
      el.ageHij.textContent = "خارج النطاق";
      el.ageNext.textContent = "خارج النطاق";
      showWarn(el.ageWarn, el.ageWarnText,
        "بيانات تقويم أم القرى في متصفحك لا تغطي هذا التاريخ؛ فما قبل 1356 هـ (نحو 1937 م) قد يُحسب بحساب هجري مختلف من دون تنبيه. حسبنا لك العمر الميلادي وإجمالي الأيام فقط.");
    }
  };

  /* ---------- الفرق بين تاريخين ---------- */

  var updateDiff = function () {
    var first = dateFromIso(el.from.value);
    var second = dateFromIso(el.to.value);
    if (!first || !second) {
      el.diffDays.textContent = "—";
      el.diffWeeks.textContent = "—";
      el.diffHijri.textContent = "—";
      el.diffNote.textContent = "اختر تاريخين لعرض الفرق بينهما.";
      return;
    }
    var swapped = first.getTime() > second.getTime();
    var start = swapped ? second : first;
    var end = swapped ? first : second;
    var total = dayNumberOf(end) - dayNumberOf(start);

    el.diffDays.textContent = total === 0
      ? "نفس اليوم"
      : joinParts([{ count: total, one: "يوم واحد", two: "يومان", many: "أيام", format: latinDigits }]);

    var weeks = Math.floor(total / 7);
    var rest = total % 7;
    var weekText = weeks === 0 ? "" : unitPhrase(weeks, "أسبوع واحد", "أسبوعان", "أسابيع", latinDigits);
    var restText = rest === 0 ? "" : unitPhrase(rest, "يوم واحد", "يومان", "أيام", latinDigits);
    if (total === 0) el.diffWeeks.textContent = "لا فرق";
    else if (weekText && restText) el.diffWeeks.textContent = weekText + " و" + restText;
    else el.diffWeeks.textContent = weekText || restText || "أقل من أسبوع";

    var startHijri = hijriOnDayNumber(dayNumberOf(start));
    var endHijri = hijriOnDayNumber(dayNumberOf(end));
    if (inRange(startHijri) && inRange(endHijri)) {
      var diff = hijriAgeBetween(startHijri, endHijri);
      el.diffHijri.textContent = joinParts(hijriAgeParts(diff, arabicDigits)) +
        " (" + arabicDigits(startHijri.year) + " هـ ← " + arabicDigits(endHijri.year) + " هـ)";
    } else {
      el.diffHijri.textContent = "خارج النطاق";
    }
    el.diffNote.textContent = swapped
      ? "التاريخ الثاني أسبق من الأول، فحسبنا الفرق بالمطلق بين التاريخين."
      : "";
  };

  /* ---------- التهيئة ---------- */

  var init = function () {
    for (var month = 1; month <= 12; month += 1) {
      var option = document.createElement("option");
      option.value = String(month);
      option.textContent = MONTHS[month - 1];
      el.hm.append(option);
    }

    var today = todayDate();
    var todayIso = isoOf(today);
    var todayHijri = hijriOnDayNumber(dayNumberOf(today));

    el.g.value = todayIso;
    fillHijriFields(todayHijri);
    el.until.value = todayIso;
    el.from.value = todayIso;
    el.to.value = todayIso;

    el.dirG.addEventListener("click", function () {
      setDirection("g2h");
    });
    el.dirH.addEventListener("click", function () {
      setDirection("h2g");
    });

    el.g.addEventListener("input", function () {
      if (direction !== "g2h") setDirection("g2h");
      else runConvert();
    });
    el.g.addEventListener("change", function () {
      if (direction !== "g2h") setDirection("g2h");
      else runConvert();
    });

    var hijriInputs = [el.hd, el.hm, el.hy];
    for (var i = 0; i < hijriInputs.length; i += 1) {
      (function (input) {
        var react = function () {
          if (direction !== "h2g") setDirection("h2g");
          else runConvert();
        };
        input.addEventListener("input", react);
        input.addEventListener("change", react);
      })(hijriInputs[i]);
    }

    el.todayButton.addEventListener("click", function () {
      var now = todayDate();
      var nowIso = isoOf(now);
      el.g.value = nowIso;
      fillHijriFields(hijriOnDayNumber(dayNumberOf(now)));
      el.until.value = nowIso;
      runConvert();
      updateAge();
      updateDiff();
    });

    var ageInputs = [el.born, el.until];
    for (var a = 0; a < ageInputs.length; a += 1) {
      ageInputs[a].addEventListener("input", updateAge);
      ageInputs[a].addEventListener("change", updateAge);
    }

    var diffInputs = [el.from, el.to];
    for (var d = 0; d < diffInputs.length; d += 1) {
      diffInputs[d].addEventListener("input", updateDiff);
      diffInputs[d].addEventListener("change", updateDiff);
    }

    setDirection("g2h");
    updateAge();
    updateDiff();
  };

  init();
</script>
