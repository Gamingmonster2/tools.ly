trail", "train", "tram", "transfer", "transit", "trap", "travel", "assay", "treasure", "treat", "tree", "tremble", "trend", "trial", "triangle", "tribe", "tricky", "trigger", "trim", "trip", "trophy", "tropic", "trot", "trouble", "truck", "true", "trumpet", "trunk", "trust", "truth", "tube", "tuck", "tuft", "tulip", "tumble", "tuna", "tundra", "tune", "tunnel", "turbo", "turf", "turkey", "turn", "turnip", "turtle", "twelve", "twenty", "twice", "twig", "twilight", "twin", "twist", "type", "typical", "ultra", "umbrella", "unable", "uncle", "under", "unfold", "uniform", "union", "unique", "unit", "unite", "universe", "unknown", "unless", "unlike", "unlock", "until", "unusual", "upbeat", "update", "upgrade", "uphill", "upon", "upper", "upset", "urban", "urge", "usage", "useful", "usual", "utility", "vacant", "vacuum", "vague", "valley", "valve", "vase", "vanish", "vapor", "variety", "various", "atlas2", "vast", "vault", "vector", "venture", "vehicle", "velvet", "vendor", "auger", "venue", "verb", "verify", "verse", "version", "vertical", "vessel", "veteran", "viaduct", "vibrant", "victory", "video", "view", "vigor", "villa", "village", "vine", "vinegar", "vintage", "viola", "violent", "violet", "violin", "viper", "virtual", "virtue", "virus", "visa", "visible", "vision", "visit", "visual", "vital", "vivid", "vocal", "voice", "void", "volcano", "volume", "voltage", "vote", "vowel", "voyage", "waddle", "wade", "waffle", "wage", "wagon", "waist", "wait", "wake", "walk", "wall", "walnut", "walrus", "wander", "want", "warden", "aunt2", "warm", "warn", "warrant", "warrior", "wary", "wash", "wasp", "waste", "watch", "water", "watt", "wave", "wisp", "wand", "weak", "wealth", "weapon", "wear", "weather", "weave", "weld", "wedge", "weed", "week", "weight", "weird", "welcome", "aural", "well", "west", "wetland", "whale", "wharf", "wheat", "wheel", "when", "where", "while", "whim", "whip", "whirl", "whisk", "whisper", "whistle", "white", "whole", "wide", "widget", "width", "wild", "willow", "winch", "wind", "window", "wine", "wing", "wink", "winner", "winter", "wire", "wisdom", "wise", "wish", "avail", "wilt", "witness", "wolf", "wonder", "wood", "wool", "word", "workshop", "world", "worm", "worry", "worth", "wound", "wrap", "wreath", "wren", "wrench", "wrist", "write", "wrong", "yacht", "yard", "yarn", "yawn", "year", "yeast", "yellow", "yield", "yogurt", "young", "youth", "zebra", "zenith", "zephyr", "zero", "zest", "zigzag", "zinc", "zipper", "zone", "zoom"];

    const WORD_BITS = Math.log2(WORDS.length);
    const SYMBOL_CHARS = "!@#$%^&*";

    function el<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }

    function rand(max: number): number {
      if (max <= 0) return 0;
      const c = (window.crypto || (window as unknown as { msCrypto: Crypto }).msCrypto);
      const limit = Math.floor(4294967296 / max) * max;
      const buf = new Uint32Array(1);
      let x = 0;
      do {
        c.getRandomValues(buf);
        x = buf[0];
      } while (x >= limit);
      return x % max;
    }

    function shuffle<T>(arr: T[]): T[] {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = rand(i + 1);
        const t = arr[i];
        arr[i] = arr[j];
        arr[j] = t;
      }
      return arr;
    }

    interface Cfg {
      length: number;
      upper: boolean;
      lower: boolean;
      digits: boolean;
      symbols: boolean;
      noLookAlike: boolean;
      requireEach: boolean;
      exclude: string;
    }

    function makePool(cfg: Cfg): string[] {
      const drop = new Set<string>();
      for (const ch of cfg.exclude) drop.add(ch);
      if (cfg.noLookAlike) for (const ch of LOOK_ALIKE) drop.add(ch);
      const sets: string[] = [];
      if (cfg.lower) sets.push(LOWER);
      if (cfg.upper) sets.push(UPPER);
      if (cfg.digits) sets.push(DIGITS);
      if (cfg.symbols) sets.push(SYMBOLS);
      const cleaned = sets.map((s) => [...s].filter((ch) => !drop.has(ch)));
      const pool = cleaned.join("");
      return [pool, ...cleaned];
    }

    interface Est {
      bits: number;
      label: string;
      crack: string;
      level: "danger" | "warn" | "ok";
    }

    function estimateFromBits(bits: number): Est {
      let label = "Very weak";
      let level: Est["level"] = "danger";
      if (bits >= 90) {
        label = "Very strong";
        level = "ok";
      } else if (bits >= 60) {
        label = "Strong";
        level = "ok";
      } else if (bits >= 36) {
        label = "Fair";
        level = "warn";
      } else if (bits >= 28) {
        label = "Weak";
        level = "danger";
      }
      return { bits, label, crack: crackTime(bits), level };
    }

    function crackTime(bits: number): string {
      if (!isFinite(bits) || bits <= 0) return "instantly";
      const guessRate = 1e10;
      const combos = Math.pow(2, Math.min(bits, 1023));
      const secs = combos / guessRate;
      if (secs < 1) return "under a second";
      const MIN = 60;
      const HOUR = 3600;
      const DAY = 86400;
      const YEAR = 31557600;
      const CENTURY = YEAR * 100;
      if (secs < MIN) return "about " + fmt(secs) + " seconds";
      if (secs < HOUR) return "about " + fmt(secs / MIN) + " minutes";
      if (secs < DAY) return "about " + fmt(secs / HOUR) + " hours";
      if (secs < YEAR) return "about " + fmt(secs / DAY) + " days";
      if (secs < CENTURY) return "about " + fmt(secs / YEAR) + " years";
      return "over " + fmt(secs / CENTURY) + " centuries";
    }

    function fmt(n: number): string {
      if (!isFinite(n)) return "countless";
      if (n >= 1e18) return n.toExponential(1);
      if (n >= 1000) {
        if (n >= 1e9) return Math.round(n / 1e6) / 1000 + " billion";
        if (n >= 1e6) return Math.round(n / 1e4) / 100 + " million";
        return Math.round(n).toLocaleString("en-US");
      }
      const rounded = Math.round(n * 10) / 10;
      return String(rounded);
    }

    function meterScale(bits: number): number {
      return Math.max(0, Math.min(100, (bits / 100) * 100));
    }

    const state: { mode: Mode } = { mode: "chars" };

    function readCfg(): Cfg {
      return {
        length: Number(el<HTMLInputElement>("length").value),
        upper: el<HTMLInputElement>("useUpper").checked,
        lower: el<HTMLInputElement>("useLower").checked,
        digits: el<HTMLInputElement>("useDigits").checked,
        symbols: el<HTMLInputElement>("useSymbols").checked,
        noLookAlike: el<HTMLInputElement>("excludeLookAlike").checked,
        requireEach: el<HTMLInputElement>("requireEach").checked,
        exclude: el<HTMLInputElement>("excludeChars").value,
      };
    }

    interface GenResult {
      text: string;
      bits: number;
    }

    function randomString(cfg: Cfg): GenResult {
      const parts = makePool(cfg);
      const pool = parts[0];
      if (!pool) {
        return { text: "", bits: 0 };
      }
      const chars = [...pool];
      const required: string[][] = [];
      if (cfg.requireEach) {
        for (let i = 1; i < parts.length; i++) {
          if (parts[i].length > 0) required.push([...parts[i]]);
        }
      }
      const usable = Math.min(required.length, cfg.length);
      const out: string[] = [];
      for (let i = 0; i < usable; i++) out.push(required[i][rand(required[i].length)]);
      while (out.length < cfg.length) out.push(chars[rand(chars.length)]);
      shuffle(out);
      return { text: out.join(""), bits: cfg.length * Math.log2(chars.length) };
    }

    function buildPassphrase(): GenResult {
      const count = Number(el<HTMLInputElement>("wordCount").value);
      const casing = el<HTMLSelectElement>("wordCase").value;
      const sep = el<HTMLSelectElement>("separator").value;
      const digits = Number(el<HTMLSelectElement>("wordNumber").value === "none" ? 0 : el<HTMLSelectElement>("wordNumber").value);
      const symbolCount = Number(el<HTMLSelectElement>("wordSymbol").value === "none" ? 0 : el<HTMLSelectElement>("wordSymbol").value);
      const picked: string[] = [];
      for (let i = 0; i < count; i++) picked.push(WORDS[rand(WORDS.length)]);
      const words = picked.map((w) => {
        if (casing === "title") return w.charAt(0).toUpperCase() + w.slice(1);
        if (casing === "upper") return w.toUpperCase();
        return w;
      });
      let text = words.join(sep);
      let bits = count * WORD_BITS;
      if (digits > 0) {
        let s = "";
        for (let i = 0; i < digits; i++) s += String(rand(10));
        text += s;
        bits += digits * Math.log2(10);
      }
      if (symbolCount > 0) {
        let s = "";
        for (let i = 0; i < symbolCount; i++) s += SYMBOL_CHARS[rand(SYMBOL_CHARS.length)];
        text += s;
        bits += symbolCount * Math.log2(SYMBOL_CHARS.length);
      }
      return { text, bits };
    }

    function unicodeLength(s: string): number {
      return [...s].length;
    }

    function poolSize(s: string): number {
      let lower = false;
      let upper = false;
      let digit = false;
      let symbol = false;
      for (const ch of s) {
        if (/[a-z]/.test(ch)) lower = true;
        else if (/[A-Z]/.test(ch)) upper = true;
        else if (/[0-9]/.test(ch)) digit = true;
        else symbol = true;
      }
      let size = 0;
      if (lower) size += 26;
      if (upper) size += 26;
      if (digit) size += 10;
      if (symbol) size += 32;
      return size;
    }

    function current(): GenResult {
      return state.mode === "chars" ? randomString(readCfg()) : buildPassphrase();
    }

    function paint(est: Est, note: string) {
      const fill = el<HTMLSpanElement>("meterFill");
      fill.style.width = meterScale(est.bits) + "%";
      const colour = est.level === "ok" ? "var(--ok)" : est.level === "warn" ? "var(--warn)" : "var(--danger)";
      fill.style.background = colour;
      el<HTMLElement>("meterNote").textContent = note;
    }

    function showPrimary() {
      const result = current();
      el<HTMLElement>("primaryResult").textContent = result.text || "Select at least one character set.";
      if (!result.text) {
        el<HTMLElement>("entropyValue").textContent = "0";
        el<HTMLElement>("strengthLabel").textContent = "No pool";
        el<HTMLElement>("crackValue").textContent = "—";
        el<HTMLSpanElement>("meterFill").style.width = "0%";
        el<HTMLElement>("meterNote").textContent = "Tick at least one character set to generate a password.";
        el<HTMLButtonElement>("copyBtn").disabled = true;
        return;
      }
      el<HTMLButtonElement>("copyBtn").disabled = false;
      const est = estimateFromBits(result.bits);
      el<HTMLElement>("entropyValue").textContent = est.bits.toFixed(1) + " bits";
      el<HTMLElement>("strengthLabel").textContent = est.label;
      el<HTMLElement>("crackValue").textContent = est.crack;
      paint(est, est.bits.toFixed(1) + " bits of entropy for this " + unicodeLength(result.text) + "-character value.");
    }

    function showBulk() {
      const n = Number(el<HTMLInputElement>("bulkCount").value);
      const list = el<HTMLUListElement>("bulkList");
      list.textContent = "";
      for (let i = 0; i < n; i++) {
        const result = current();
        const li = document.createElement("li");
        li.className = "list__row";
        const index = document.createElement("span");
        index.className = "list__index";
        index.textContent = String(i + 1);
        const text = document.createElement("span");
        text.className = "list__text";
        text.textContent = result.text;
        const copy = document.createElement("button");
        copy.type = "button";
        copy.className = "btn btn--ghost btn--sm";
        copy.textContent = "Copy";
        copy.addEventListener("click", () => {
          void copyText(result.text, copy);
        });
        li.appendChild(index);
        li.appendChild(text);
        li.appendChild(copy);
        list.appendChild(li);
      }
    }

    function flash(btn: HTMLButtonElement, message: string, original: string) {
      btn.textContent = message;
      const timer = Number(btn.dataset.timer || 0);
      if (timer) window.clearTimeout(timer);
      const id = window.setTimeout(() => {
        btn.textContent = original;
        delete btn.dataset.timer;
      }, 1600);
      btn.dataset.timer = String(id);
    }

    function legacyCopy(value: string): boolean {
      const ta = document.createElement("textarea");
      ta.value = value;
      ta.setAttribute("readonly", "readonly");
      ta.style.position = "fixed";
      ta.style.top = "-1000px";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, value.length);
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      document.body.removeChild(ta);
      return ok;
    }

    async function copyText(value: string, btn: HTMLButtonElement) {
      if (!value) return;
      const original = btn.dataset.label || btn.textContent || "Copy";
      btn.dataset.label = original;
      let done = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          done = true;
        } else {
          done = legacyCopy(value);
        }
      } catch {
        done = legacyCopy(value);
      }
      flash(btn, done ? "Copied!" : "Copy failed", original);
    }

    function refreshAll() {
      el<HTMLOutputElement>("lengthOut").textContent = el<HTMLInputElement>("length").value;
      el<HTMLOutputElement>("wordCountOut").textContent = el<HTMLInputElement>("wordCount").value;
      el<HTMLOutputElement>("bulkCountOut").textContent = el<HTMLInputElement>("bulkCount").value;
      showPrimary();
      showBulk();
    }

    function modeSwitched() {
      const isChars = state.mode === "chars";
      el<HTMLElement>("charsPanel").hidden = !isChars;
      el<HTMLElement>("wordsPanel").hidden = isChars;
      el<HTMLButtonElement>("modeChars").setAttribute("aria-selected", String(isChars));
      el<HTMLButtonElement>("modeWords").setAttribute("aria-selected", String(!isChars));
      refreshAll();
    }

    function init() {
      document.querySelectorAll<HTMLButtonElement>("#modeTabs .seg__btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          state.mode = (btn.dataset.mode as Mode) || "chars";
          modeSwitched();
        });
      });

      const autoIds = [
        "length",
        "useUpper",
        "useLower",
        "useDigits",
        "useSymbols",
        "excludeLookAlike",
        "requireEach",
        "excludeChars",
        "wordCount",
        "wordCase",
        "separator",
        "wordNumber",
        "wordSymbol",
        "bulkCount",
      ];
      for (const id of autoIds) {
        const node = document.getElementById(id);
        if (!node) continue;
        node.addEventListener("input", refreshAll);
        node.addEventListener("change", refreshAll);
      }

      el<HTMLButtonElement>("regenBtn").addEventListener("click", refreshAll);
      el<HTMLButtonElement>("bulkRegenBtn").addEventListener("click", showBulk);
      el<HTMLButtonElement>("copyBtn").addEventListener("click", (ev) => {
        const btn = ev.currentTarget as HTMLButtonElement;
        void copyText(el<HTMLElement>("primaryResult").textContent || "", btn);
      });
      el<HTMLButtonElement>("copyAllBtn").addEventListener("click", (ev) => {
        const btn = ev.currentTarget as HTMLButtonElement;
        const values = Array.from(document.querySelectorAll("#bulkList .list__text")).map(
          (node) => node.textContent || ""
        );
        el<HTMLElement>("bulkStatus").textContent = "Copied " + values.length + " passwords.";
        void copyText(values.join("\n"), btn);
      });

      el<HTMLInputElement>("tester").addEventListener("input", (ev) => {
        const value = (ev.currentTarget as HTMLInputElement).value;
        if (!value) {
          el<HTMLElement>("testerOut").textContent =
            "Nothing is uploaded — the estimate is computed locally.";
          return;
        }
        const size = Math.max(poolSize(value), 1);
        const bits = unicodeLength(value) * Math.log2(size);
        const est = estimateFromBits(bits);
        el<HTMLElement>("testerOut").textContent =
          "≈ " + bits.toFixed(1) + " bits · " + est.label + " · " + est.crack + " to crack.";
      });

      el<HTMLButtonElement>("copyBtn").dataset.label = "Copy";
      el<HTMLButtonElement>("copyAllBtn").dataset.label = "Copy all";
      refreshAll();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>
</ToolLayout>
