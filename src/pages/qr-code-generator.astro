---
import ToolLayout from "../layouts/ToolLayout.astro";
import { allTools } from "../data/tools";
const tool = allTools.find((t) => t.slug === "qr-code-generator")!;
const faqs = [
  {
    q: "Which QR versions and error-correction levels does this page support?",
    a: "Versions 1 to 40, the complete range defined by ISO/IEC 18004, at all four error-correction levels L, M, Q and H. The page always chooses the smallest version whose data capacity fits your payload at the level you picked, so a short link usually lands on version 2 or 3 while a long Wi-Fi string may need version 10 or more. Anything that will not fit in version 40 at the selected level is reported as too long instead of being encoded into an invalid symbol.",
  },
  {
    q: "Does the payload leave my device, and can the page work offline?",
    a: "No and yes. The encoder, the Reed–Solomon arithmetic, the mask scoring and the rendering all run as plain JavaScript in this tab, with no network requests, no external scripts, no fonts and no QR library. You can load the page once, switch off Wi-Fi and keep generating codes. The trade-off is that nothing is stored: close or reload the tab and your payload is gone, so keep the downloaded file or the original text if you need it later.",
  },
  {
    q: "Why does a code sometimes fail to scan even though it looks fine on screen?",
    a: "Most reader failures are optical rather than mathematical. Inverted colours, a foreground and background that are too close in brightness, a quiet zone that is too narrow, a very small print size, a glossy screen, or a camera that is too close and cannot focus all cause a miss. A code with a large module count is also harder to read from a distance than a short one. High error-correction levels tolerate more damage and smudging, but they cannot compensate for a symbol that is simply too small or too low in contrast.",
  },
  {
    q: "What does the self-check indicator actually verify?",
    a: "After building a matrix, the script reads the 15 format-information modules back out of the finished grid, removes the fixed mask and decodes them, then compares the recovered error-correction level and mask number with the ones it intended to write. If those agree it reports that the self-check passed; if they do not, it says so loudly rather than shipping a silently broken image. That check is a sanity test on the reserved format area, not a full independent scanner, so a standard reader is still the final word.",
  },
];

const sources = [
  {
    label: "ISO/IEC 18004 — QR Code bar code symbology specification",
    href: "https://www.iso.org/standard/62021.html",
    note: "The normative standard this encoder follows: byte-mode encoding, the version 1–40 capacity and block tables, Reed–Solomon error correction, mask evaluation and the format and version information layout.",
  },
  {
    label: "MDN Web Docs — Canvas API",
    href: "https://developer.mozilla.org/en-US/docs/Web/API/Canvas_API",
    note: "Documents the canvas element, 2D context drawing calls and toBlob() used to rasterise the module matrix into the downloadable PNG.",
  },
  {
    label: "MDN Web Docs — SVG: Scalable Vector Graphics",
    href: "https://developer.mozilla.org/en-US/docs/Web/SVG",
    note: "Reference for the SVG elements, namespace and viewBox scaling used to build the vector version of the symbol that stays crisp when printed.",
  },
];
---

<ToolLayout
  tool={tool}
  intro="Type a link, some text, a Wi-Fi network or an email, and this page encodes a standards-compliant QR symbol in your browser, shows you the version it chose, and exports it as a PNG or a crisp SVG."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body qg">
        <p class="qg__note" id="qg-prerender">
          Everything below is generated locally in this tab. The form works without JavaScript, but the
          QR image itself is produced by the script on this page, so enable JavaScript to see and download
          a symbol.
        </p>

        <div class="field-grid">
          <div class="field">
            <label for="qg-mode">What does the code contain?</label>
            <select id="qg-mode">
              <option value="text" selected>Plain text or a link</option>
              <option value="wifi">Wi-Fi network</option>
              <option value="email">Email (mailto)</option>
              <option value="phone">Phone number (tel)</option>
              <option value="sms">SMS message</option>
            </select>
          </div>

          <div class="field">
            <label for="qg-ec">Error-correction level</label>
            <select id="qg-ec">
              <option value="L">L — about 7% recovery</option>
              <option value="M" selected>M — about 15% recovery</option>
              <option value="Q">Q — about 25% recovery</option>
              <option value="H">H — about 30% recovery</option>
            </select>
            <p class="qg__help">
              Higher levels add error-correction codewords, which makes the symbol larger for the same
              payload but far more tolerant of scratches, glare and smudges.
            </p>
          </div>
        </div>

        <div class="fieldset">
          <fieldset>
            <legend>Payload</legend>

            <div class="qg__group" data-qg-group="text">
              <div class="field">
                <label for="qg-text">Text or URL</label>
                <textarea
                  id="qg-text"
                  rows="4"
                  spellcheck="false"
                  autocomplete="off"
                  placeholder="https://example.com/page"
                  aria-describedby="qg-text-help"></textarea>
                <p class="qg__help" id="qg-text-help">
                  Encoded as UTF-8 bytes. Accented characters and emoji are fine, but each one costs more
                  than a single byte of capacity.
                </p>
              </div>
            </div>

            <div class="qg__group" data-qg-group="wifi" hidden>
              <div class="field-grid">
                <div class="field">
                  <label for="qg-wifi-ssid">Network name (SSID)</label>
                  <input
                    type="text"
                    id="qg-wifi-ssid"
                    autocomplete="off"
                    spellcheck="false"
                    placeholder="MyNetwork"
                    aria-describedby="qg-wifi-help" />
                </div>
                <div class="field">
                  <label for="qg-wifi-pass">Password</label>
                  <input
                    type="text"
                    id="qg-wifi-pass"
                    autocomplete="off"
                    spellcheck="false"
                    placeholder="Leave empty for an open network"
                    aria-describedby="qg-wifi-help" />
                </div>
              </div>
              <div class="field">
                <label for="qg-wifi-auth">Security</label>
                <select id="qg-wifi-auth">
                  <option value="WPA" selected>WPA / WPA2 / WPA3 (password)</option>
                  <option value="WEP">WEP (legacy)</option>
                  <option value="nopass">Open network (no password)</option>
                </select>
              </div>
              <label class="check">
                <input type="checkbox" id="qg-wifi-hidden" />
                The network does not broadcast its SSID
              </label>
              <p class="qg__help" id="qg-wifi-help">
                The result follows the common <code>WIFI:T:…;S:…;P:…;;</code> convention, which stores the
                password in clear text inside the symbol. Anyone who scans or photographs it can read that
                password, so do not publish a code for a network you care about.
              </p>
            </div>

            <div class="qg__group" data-qg-group="email" hidden>
              <div class="field">
                <label for="qg-email-to">To</label>
                <input type="email" id="qg-email-to" autocomplete="off" placeholder="hello@example.com" />
              </div>
              <div class="field">
                <label for="qg-email-subject">Subject</label>
                <input type="text" id="qg-email-subject" autocomplete="off" placeholder="Optional subject" />
              </div>
              <div class="field">
                <label for="qg-email-body">Body</label>
                <textarea
                  id="qg-email-body"
                  rows="3"
                  autocomplete="off"
                  placeholder="Optional message body"></textarea>
              </div>
            </div>

            <div class="qg__group" data-qg-group="phone" hidden>
              <div class="field">
                <label for="qg-phone">Phone number</label>
                <input
                  type="tel"
                  id="qg-phone"
                  autocomplete="off"
                  placeholder="+1 555 0100"
                  aria-describedby="qg-phone-help" />
                <p class="qg__help" id="qg-phone-help">
                  Keep the leading <code>+</code> and country code for an international number, or use the
                  local format if the code will only ever be scanned inside one country.
                </p>
              </div>
            </div>

            <div class="qg__group" data-qg-group="sms" hidden>
              <div class="field">
                <label for="qg-sms-to">Phone number</label>
                <input type="tel" id="qg-sms-to" autocomplete="off" placeholder="+1 555 0100" />
              </div>
              <div class="field">
                <label for="qg-sms-body">Message</label>
                <textarea
                  id="qg-sms-body"
                  rows="3"
                  autocomplete="off"
                  placeholder="Optional pre-filled message"></textarea>
              </div>
              <p class="qg__help">
                The number and message are packed into one <code>SMSTO:</code> string, so keep the message
                short if you want to stay on a low version.
              </p>
            </div>
          </fieldset>
        </div>

        <div class="fieldset">
          <fieldset>
            <legend>Appearance</legend>
            <div class="field-grid">
              <div class="field">
                <label for="qg-size">Output size (pixels)</label>
                <input type="number" id="qg-size" min="128" max="1024" step="16" value="320" />
              </div>
              <div class="field">
                <label for="qg-margin">Quiet-zone margin (modules)</label>
                <input type="number" id="qg-margin" min="0" max="8" step="1" value="4" />
              </div>
              <div class="field">
                <label for="qg-fg">Foreground colour</label>
                <input type="color" id="qg-fg" value="#101314" />
              </div>
              <div class="field">
                <label for="qg-bg">Background colour</label>
                <input type="color" id="qg-bg" value="#ffffff" />
              </div>
            </div>
            <p class="qg__help">
              The specification asks for a light background with dark modules and a margin of at least four
              modules. Inverting the two, or choosing colours of similar brightness, makes the symbol
              unreadable for many scanners even though it still looks like a QR code.
            </p>
          </fieldset>
        </div>

        <div class="qg__actions">
          <button type="button" class="btn btn--primary" id="qg-generate">Generate QR code</button>
          <button type="button" class="btn btn--ghost btn--sm" id="qg-download-png" disabled>
            Download PNG
          </button>
          <button type="button" class="btn btn--ghost btn--sm" id="qg-download-svg" disabled>
            Download SVG
          </button>
        </div>

        <p class="qg__status" id="qg-status" role="status" aria-live="polite">
          No code generated yet.
        </p>
        <p class="qg__check readout" id="qg-check" role="status" aria-live="polite">
          Self-check: not run yet.
        </p>
      </div>

      <div class="panel__foot">
        Encoded on this device with no library and no network request — the symbol is built from the raw
        ISO/IEC 18004 rules, then drawn to both a canvas and an SVG.
      </div>
    </div>

    <div class="card qg__out">
      <h2>Output</h2>
      <div class="qg__figure">
        <div class="qg__canvas-wrap" id="qg-canvas-wrap">
          <canvas
            id="qg-canvas"
            width="320"
            height="320"
            role="img"
            aria-label="QR code preview. No code has been generated yet."></canvas>
          <p class="qg__fallback" id="qg-fallback">
            The QR image appears here once JavaScript has drawn it.
          </p>
        </div>
      </div>

      <div class="stat-grid">
        <div class="stat">
          <span class="stat__label">Version</span>
          <span class="stat__value" id="qg-stat-version">—</span>
        </div>
        <div class="stat">
          <span class="stat__label">Size</span>
          <span class="stat__value" id="qg-stat-size">—</span>
        </div>
        <div class="stat">
          <span class="stat__label">Mask</span>
          <span class="stat__value" id="qg-stat-mask">—</span>
        </div>
        <div class="stat">
          <span class="stat__label">Payload</span>
          <span class="stat__value" id="qg-stat-bytes">—</span>
        </div>
      </div>

      <div class="field">
        <label for="qg-preview-payload">Text carried by this code</label>
        <textarea id="qg-preview-payload" rows="2" readonly spellcheck="false"></textarea>
        <p class="qg__help">
          This is exactly what a reader will receive. For a Wi-Fi payload it includes the password in
          clear text, so treat the preview like the code itself.
        </p>
      </div>
    </div>
  </Fragment>

  <h2>How it works</h2>
  <p>
    A QR code is not an image format, it is a specification for arranging binary data on a square grid.
    This page implements that specification directly: the same steps a commercial encoder performs, in
    plain JavaScript, with no library in the middle. Encoding starts by serialising your payload to
    UTF-8 bytes, writing the four-bit mode indicator for byte mode and a character-count indicator whose
    width depends on the version. Then it picks the version. Versions 1 to 40 define matrices of
    21×21 up to 177×177 modules, and each version and error-correction level has a fixed capacity, so the
    encoder walks the capacity table and takes the first version that fits.
  </p>
  <p>
    The data codewords are split into blocks, and each block gains Reed–Solomon parity codewords computed
    over GF(256) with the primitive polynomial 0x11d and the standard generator polynomials. The blocks
    are then interleaved — data codewords first, then parity — so that a scratch or a smear damages a
    little of every block instead of destroying one whole block. The resulting bit stream is poured into
    the matrix in the two-module-wide zigzag defined by the standard, skipping the function patterns that
    were drawn first: the three finder patterns and their separators, the timing patterns, the alignment
    patterns and the single dark module. Because the character-count indicator and capacity depend on the
    version, and the version partly depends on the payload length, the smallest-fit search is done before
    any bits are written.
  </p>
  <p>
    A finished matrix is rarely readable as-is, so a mask is applied. The standard defines eight mask
    patterns, and the encoder builds all eight candidate matrices and scores each one with four penalty
    rules: runs of five or more same-coloured modules in a row or column, 2×2 blocks of one colour,
    finder-like patterns that could confuse a locator, and an imbalance between dark and light modules
    across the whole symbol. The mask with the lowest total penalty wins. Finally the encoder writes the
    format information — the error-correction level and mask number, protected by a BCH(15,5) code and
    XORed with the fixed mask 0x5412 — and for version 7 and above the 18-bit version information, also
    BCH-protected. Both of those are redundant copies placed in two locations, which is what lets a reader
    lock on to a symbol that is partly damaged.
  </p>

  <h2>Accuracy, limits and honest caveats</h2>
  <p>
    The encoder is complete for byte mode across the whole standard, and it is deliberately strict about
    what it will not do. Byte mode encodes UTF-8 text as a sequence of bytes; the numeric and
    alphanumeric modes that the standard defines for digits and uppercase ASCII are not implemented, so a
    payload made only of digits takes more room here than a dedicated encoder would use. That is a size
    difference, never a correctness one — a reader sees a perfectly ordinary byte-mode symbol either way.
  </p>
  <ul>
    <li>
      <strong>Version 40 is the ceiling.</strong> Version 40 is 177×177 modules and holds 2,953 bytes at
      level L, 2,331 at M, 1,663 at Q and 1,273 at H. If your payload still does not fit, the page says so
      and produces nothing rather than emitting a truncated or malformed symbol. In practice this is not a
      wall you hit often: a very long URL or a whole paragraph of text gets there first, and the honest
      answer at that point is to shorten the content or split it across codes.
    </li>
    <li>
      <strong>Error correction is not magic.</strong> The percentages are roughly 7, 15, 25 and 30 per
      cent, and they describe how much of the symbol can be damaged or misread, not how small the symbol
      can be printed. Choosing H to make a code "safer" also increases the module count for the same
      payload, which can make the printed result harder to resolve. For a clean screen or a clean label,
      M is usually the sensible middle.
    </li>
    <li>
      <strong>Colour and contrast decide whether it scans.</strong> Most decoders assume dark modules on a
      light background, and a colour-inverted code may be rejected outright by older or stricter readers
      even when a modern phone camera handles it. Low contrast is worse: a pale grey on white, a mid-tone
      accent on a slightly lighter tint, or a dark red on black all fail the brightness difference the
      image-processing step relies on. Dark on light, comfortably far apart in luminance, is the rule.
    </li>
    <li>
      <strong>The quiet zone matters more than people expect.</strong> The standard asks for at least four
      light modules of margin on every side; the default here is four, and you can add more. Shrinking it
      to zero, or placing the symbol flush against a dark border or another graphic, removes the
      separation a locator needs and is one of the most common causes of a code that "should work" but
      does not.
    </li>
    <li>
      <strong>The preview is a preview.</strong> The canvas is scaled to the pixel size you asked for and
      the SVG is exact, but a very small output size on a high-density screen, or a browser zoom level,
      can make the on-screen version look softer than the exported file. Judge print quality from the
      downloaded PNG or SVG, not from the preview.
    </li>
    <li>
      <strong>This is an encoder, not a scanner.</strong> The page builds symbols and verifies its own
      reserved areas; it does not decode with a camera. Before you print a run of labels, scan the
      exported file with the reader you expect your audience to use.
    </li>
  </ul>
  <div class="callout callout--warn">
    <p>
      Wi-Fi payloads contain the network password in plain text, and a QR code is simply a picture of
      that string. Anyone who can photograph the code can read the password. Treat a Wi-Fi code the way
      you would treat a written-down password, and use the guest network for anything you are going to
      print or post.
    </p>
  </div>

  <h2>How to use this tool</h2>
  <ol>
    <li>
      <strong>Choose what the code holds.</strong> Pick plain text or a link, a Wi-Fi network, an email,
      a phone number or an SMS. The form swaps in the fields that payload needs — for Wi-Fi that is the
      network name, the password and the security type, and for email it is a recipient, a subject and a
      body.
    </li>
    <li>
      <strong>Pick the error-correction level.</strong> Levels L, M, Q and H trade capacity for resilience.
      M is the usual default for screens and clean print; use Q or H when the code will be exposed to wear
      or partial damage, and expect a larger symbol or a higher version in exchange.
    </li>
    <li>
      <strong>Set the size, margin and colours.</strong> The pixel size drives the PNG; the SVG is
      resolution-independent, so a modest size is fine for print. Leave the margin at four modules unless
      you have a reason to change it, and keep a light background with dark modules.
    </li>
    <li>
      <strong>Generate, then read the readouts.</strong> The status line reports the version chosen, the
      matrix size and the mask number, and the payload preview shows the exact string a scanner will
      receive. If the payload is too long for version 40 at that level, the message says so — lower the
      level or shorten the content.
    </li>
    <li>
      <strong>Check the self-check line before you download.</strong> The script re-reads the format
      information out of its own finished matrix, removes the fixed mask and confirms the decoded
      error-correction level and mask match the intent. A "self-check passed" line means the reserved
      areas are internally consistent.
    </li>
    <li>
      <strong>Export the format that suits the job.</strong> PNG is a fixed-size raster, ideal for a
      screen, a slide or a chat message. SVG is vector, so it stays sharp at any print size and is the
      better choice for labels, posters and anything that may be enlarged later.
    </li>
  </ol>
  <p>
    The tests get shorter as the payload gets shorter, but the principle is the same: a plain URL such as
    <code>https://example.com</code> is only 19 bytes, so at level M the encoder fits it into a small
    version and produces a chunky, easy-to-scan symbol, while the same text at level H pushes the version
    up and the modules get finer. If a code is hard to scan in the wild, the fix is almost always to
    shorten the payload, raise the contrast or increase the printed size — not to change the mask.
  </p>
</ToolLayout>

<style is:global>
  .qg {
    display: grid;
    gap: clamp(1.1rem, 2.5vw, 1.75rem);
  }
  .qg [hidden] {
    display: none;
  }
  .qg__note,
  .qg__help {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .qg__note {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
  }
  .qg__help code {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .qg__group {
    display: grid;
    gap: 0.85rem;
  }
  .qg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .qg__actions .btn {
    flex: 0 1 auto;
  }
  .qg__status {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .qg__check {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .qg__check--ok {
    border-color: var(--ok);
    background: var(--ok-soft);
    color: var(--text);
  }
  .qg__check--bad {
    border-color: var(--danger);
    background: var(--danger-soft);
    color: var(--text);
  }
  .qg__out {
    display: grid;
    gap: 1rem;
  }
  .qg__out h2 {
    font-size: 1.05rem;
    margin: 0;
  }
  .qg__figure {
    display: flex;
    justify-content: center;
  }
  .qg__canvas-wrap {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 360px;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .qg__canvas-wrap canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .qg__canvas-wrap svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
  .qg__canvas-wrap--painted canvas {
    position: static;
    width: 100%;
    max-width: 100%;
    height: auto;
    opacity: 1;
    pointer-events: auto;
  }
  .qg__canvas-wrap--painted svg {
    display: none;
  }
  .qg__canvas-wrap--painted .qg__fallback {
    display: none;
  }
  .qg__fallback {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
  }
  .qg__out textarea {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  @media (max-width: 420px) {
    .qg__canvas-wrap {
      padding: 0.6rem;
    }
    .qg__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    "use strict";

    /* ------------------------------------------------------------------ *
     * Static tables from ISO/IEC 18004.
     * ------------------------------------------------------------------ */

    // [total codewords, L data, M data, Q data, H data] for versions 1..40.
    var CAPS = [
      [26, 19, 16, 13, 9],
      [44, 34, 28, 22, 16],
      [70, 55, 44, 34, 26],
      [100, 80, 64, 48, 36],
      [134, 108, 86, 62, 46],
      [172, 136, 108, 76, 60],
      [196, 156, 124, 88, 66],
      [242, 194, 154, 110, 86],
      [292, 232, 182, 132, 100],
      [346, 274, 216, 154, 122],
      [404, 324, 254, 180, 140],
      [466, 370, 290, 206, 158],
      [532, 428, 334, 244, 180],
      [581, 461, 365, 261, 197],
      [655, 523, 415, 295, 223],
      [733, 589, 453, 325, 253],
      [815, 647, 507, 367, 283],
      [901, 721, 563, 397, 313],
      [991, 795, 627, 445, 341],
      [1085, 861, 669, 485, 385],
      [1156, 932, 714, 512, 406],
      [1258, 1006, 782, 568, 442],
      [1364, 1094, 860, 614, 464],
      [1474, 1174, 914, 664, 514],
      [1588, 1276, 1000, 718, 538],
      [1706, 1370, 1062, 754, 596],
      [1828, 1468, 1128, 808, 628],
      [1921, 1531, 1193, 871, 661],
      [2051, 1631, 1267, 911, 701],
      [2185, 1735, 1373, 985, 745],
      [2323, 1843, 1455, 1033, 793],
      [2465, 1955, 1541, 1115, 845],
      [2611, 2071, 1631, 1171, 901],
      [2761, 2191, 1725, 1231, 961],
      [2876, 2306, 1812, 1286, 986],
