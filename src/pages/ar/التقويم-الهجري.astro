---
import ArToolLayout from "../../layouts/ArToolLayout.astro";
import { arTools } from "../../data/arTools";

const tool = arTools.find((t) => t.slug === "التقويم-الهجري")!;

const faqs = [
  {
    q: "هل تعطي الأداة التاريخ الهجري الرسمي المعتمد في بلدي؟",
    a: "لا تدّعي ذلك. الأداة تعرض ما يحسبه تقويم أم القرى كما هو مضمَّن في متصفحك، وهو تقويم حسابي تعتمده السعودية رسمياً، لكن دولاً كثيرة تُعلن بداية الشهر الهجري بناءً على الرؤية أو على قرار جهتها الشرعية أو الفلكية، وقد يختلف إعلانها عن الحساب بيوم أو يومين. فإذا كان التاريخ يخص معاملة رسمية أو موعداً لعبادة، فاعتمد إعلان الجهة المختصة في بلدك، وخذ رقم هذه الأداة كمرجع تقريبي لا أكثر.",
  },
  {
    q: "لماذا تختلف النتيجة أحياناً بيوم عن تقويم آخر أو عن تطبيق في هاتفي؟",
    a: "لثلاثة أسباب متراكمة. الأول أن التقاويم الهجرية ليست تقويماً واحداً: منها الحسابي، ومنها القائم على الرؤية، ومنها ما يعتمد قاعدة مختلفة في تحديد بداية الشهر. والثاني أن نسخة بيانات أم القرى داخل المتصفح قد تختلف من إصدار إلى آخر ومن نظام إلى آخر. والثالث أن التحويل يعتمد على المنطقة الزمنية لجهازك، فالتاريخ القريب من منتصف الليل قد يقع في يوم هجري مختلف. لذلك قد ترى فرق يوم واحد بين هذه الصفحة وتطبيق آخر، وهذا أمر طبيعي ومتوقَّع.",
  },
  {
    q: "ما نطاق التواريخ الذي يدعمه المحوّل؟",
    a: "نقتصر على ما بين 1356 و1500 هجرية تقريباً، أي ما يوافق 1937 و2077 ميلادياً، لأن بيانات أم القرى في المتصفحات لا تغطي ما قبل ذلك بثقة، وقد يعيد المتصفح تواريخ قديمة بحساب هجري مختلف من دون أن ينبّهك. إن أدخلت تاريخاً خارج هذا النطاق فستظهر لك رسالة صريحة بدل نتيجة مضلِّلة. أما حساب العمر الميلادي وإجمالي الأيام فيبقيان صحيحين مع أي تاريخ يقبله المتصفح.",
  },
  {
    q: "هل تُرسل التواريخ التي أكتبها إلى أي مكان؟ وهل تعمل الأداة بلا إنترنت؟",
    a: "لا يُرسل شيء على الإطلاق: الصفحة لا تجري أي طلب شبكة، ولا تحتفظ بتواريخك بعد إغلاقها، بل تحسب كل شيء داخل متصفحك اعتماداً على بيانات التقويم المدمجة فيه. ولهذا تعمل الأداة كاملة بلا إنترنت، وتعمل أيضاً عند فتح الملف محلياً. الشرط الوحيد أن يدعم متصفحك تقويم islamic-umalqura؛ وإن كان قديماً جداً فقد تظهر رسالة بدل النتيجة.",
  },
  {
    q: "كم تاريخ اليوم بالهجري؟",
    a: "تجد الجواب في أعلى الأداة بلا أي خطوة منك: بمجرد فتح الصفحة يُقرأ تاريخ جهازك ويُعرض هجرياً مع يوم الأسبوع وما يوافقه ميلادياً، ويمكنك إعادته متى شئت بالضغط على زر «اليوم». والقيمة محسوبة بتقويم أم القرى المدمج في متصفحك، وهو تقويم حسابي؛ فإن أعلنت جهة الرؤية في بلدك بداية شهر مختلفة ظهر فرق يوم واحد، وعندها يُعتمد الإعلان الرسمي لا الحساب.",
  },
  {
    q: "كيف أحول التاريخ الميلادي إلى هجري؟",
    a: "اترك المحوّل على اتجاه «ميلادي ← هجري» واكتب التاريخ في خانة التاريخ الميلادي، فيظهر المقابل الهجري فوراً أسفل الأزرار. وإن أردت العكس فاضغط زر «هجري ← ميلادي» ثم أدخل اليوم والشهر والسنة الهجرية في الخانات الثلاث، فيُملأ التاريخ الميلادي تلقائياً.",
  },
];

const sources = [
  {
    label: "MDN — Intl.DateTimeFormat",
    href: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/DateTimeFormat",
    note: "المرجع الذي يوضح تنسيق التواريخ بحسب تقويم المتصفح، ومنه تقويم islamic-umalqura، وكذلك الدالة formatToParts التي نقرأ بها اليوم والشهر والسنة.",
  },
  {
    label: "CLDR — بيانات التقويم في مشروع يونيكود",
    href: "https://github.com/unicode-org/cldr/blob/main/common/supplemental/supplementalData.xml",
    note: "ملف بيانات CLDR الذي يجعل islamic-umalqura تقويم أم القرى المفضَّل للسعودية، وعليه تبني المتصفحات أسماء الأشهر الهجرية وترتيبها.",
  },
  {
    label: "تقويم أم القرى الرسمي",
    href: "https://www.ummulqura.org.sa/",
    note: "الموقع الرسمي لتقويم أم القرى الصادر عن مدينة الملك عبدالعزيز للعلوم والتقنية، وفيه التقويم المعتمد رسمياً في السعودية؛ وهو المرجع الذي تُقابَل به أرقام هذه الأداة عند أي اختلاف.",
  },
];
---

<ArToolLayout
  tool={tool}
  intro="حوّل التاريخ بين الهجري والميلادي في الاتجاهين، واعرف تاريخ اليوم بالهجري بمجرد فتح الصفحة، مع فرق الأيام وجدول الشهر، وكل ذلك بتقويم أم القرى داخل متصفحك وبلا اتصال بالشبكة."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div class="callout callout--warn hij-flag" id="hij-warn" role="status" aria-live="polite" hidden>
          <p id="hij-warn-text"></p>
        </div>

        <section class="hij-sec" aria-labelledby="hij-conv-h">
          <h2 class="hij-h" id="hij-conv-h">محوّل التاريخ</h2>
          <p class="hij-lead">
            اختر اتجاه التحويل، ثم اكتب التاريخ في الجهة المُظلَّلة. الجهة الأخرى تُملأ تلقائياً بعد التحويل.
          </p>

          <div class="hij-seg" role="group" aria-label="اتجاه التحويل">
            <button type="button" class="btn btn--sm" id="hij-dir-g" aria-pressed="true">ميلادي ← هجري</button>
            <button type="button" class="btn btn--sm" id="hij-dir-h" aria-pressed="false">هجري ← ميلادي</button>
          </div>

          <div class="hij-cols">
            <div class="hij-side" id="hij-side-g" data-active="true">
              <div class="field">
                <label for="hij-g">التاريخ الميلادي</label>
                <input type="date" id="hij-g" autocomplete="off" />
              </div>
            </div>

            <div class="hij-side" id="hij-side-h" data-active="false">
              <div class="hij-hgrid">
                <div class="field">
                  <label for="hij-hd">اليوم الهجري</label>
                  <input type="number" id="hij-hd" min="1" max="30" step="1" inputmode="numeric" autocomplete="off" />
                </div>
                <div class="field">
                  <label for="hij-hm">الشهر الهجري</label>
                  <select id="hij-hm"></select>
                </div>
                <div class="field">
                  <label for="hij-hy">السنة الهجرية</label>
                  <input type="number" id="hij-hy" min="1356" max="1500" step="1" inputmode="numeric" autocomplete="off" />
                </div>
              </div>
            </div>
          </div>

          <div class="hij-row">
            <button type="button" class="btn btn--primary" id="hij-today">اليوم</button>
            <span class="badge badge--ok hij-flag" id="hij-verified" hidden>تم التحقق من التحويل</span>
          </div>

          <p class="hij-out" id="hij-out" data-state="muted" aria-live="polite"></p>
          <p class="hij-note" id="hij-out-alt" aria-live="polite"></p>
        </section>

        <section class="hij-sec" aria-labelledby="hij-age-h">
          <h2 class="hij-h" id="hij-age-h">حاسبة العمر بالهجري</h2>
          <p class="hij-lead">
            اكتب تاريخ ميلادك، واترك «حتى تاريخ» على اليوم إن أردت معرفة عمرك حتى الآن.
          </p>

          <div class="hij-cols">
            <div class="field">
              <label for="hij-born">تاريخ الميلاد (ميلادي)</label>
              <input type="date" id="hij-born" autocomplete="off" />
            </div>
            <div class="field">
              <label for="hij-until">حتى تاريخ</label>
              <input type="date" id="hij-until" autocomplete="off" />
            </div>
          </div>

          <p class="hij-note" id="hij-born-hijri" aria-live="polite"></p>

          <div class="stat-grid hij-stats">
            <div class="stat">
              <div class="stat__label">العمر بالهجري</div>
              <div class="stat__value" id="hij-age-hij">—</div>
            </div>
            <div class="stat">
              <div class="stat__label">العمر بالميلادي</div>
              <div class="stat__value" id="hij-age-greg">—</div>
            </div>
            <div class="stat">
              <div class="stat__label">إجمالي الأيام</div>
              <div class="stat__value" id="hij-age-days">—</div>
            </div>
            <div class="stat">
              <div class="stat__label">حتى عيد ميلادك الهجري القادم</div>
              <div class="stat__value" id="hij-age-next">—</div>
            </div>
          </div>

          <div class="callout callout--warn hij-flag" id="hij-age-warn" role="status" aria-live="polite" hidden>
            <p id="hij-age-warn-text"></p>
          </div>
        </section>

        <section class="hij-sec" aria-labelledby="hij-diff-h">
          <h2 class="hij-h" id="hij-diff-h">الفرق بين تاريخين</h2>
          <p class="hij-lead">اختر تاريخين، والناتج يشمل الأيام والأسابيع والفرق بالتقويم الهجري.</p>

          <div class="hij-cols">
            <div class="field">
              <label for="hij-from">من تاريخ</label>
              <input type="date" id="hij-from" autocomplete="off" />
            </div>
            <div class="field">
              <label for="hij-to">إلى تاريخ</label>
              <input type="date" id="hij-to" autocomplete="off" />
            </div>
          </div>

          <div class="stat-grid hij-stats">
            <div class="stat">
              <div class="stat__label">إجمالي الأيام</div>
              <div class="stat__value" id="hij-diff-days">—</div>
            </div>
            <div class="stat">
              <div class="stat__label">الأسابيع والأيام</div>
              <div class="stat__value" id="hij-diff-weeks">—</div>
            </div>
            <div class="stat">
              <div class="stat__label">الفرق الهجري</div>
              <div class="stat__value" id="hij-diff-hijri">—</div>
            </div>
          </div>

          <p class="hij-note" id="hij-diff-note" aria-live="polite"></p>
        </section>

        <section class="hij-sec" aria-labelledby="hij-grid-h">
          <h2 class="hij-h" id="hij-grid-h">جدول الشهر</h2>
          <p class="hij-lead" id="hij-grid-cap"></p>

          <div class="table-wrap hij-grid-wrap">
            <table class="data hij-grid">
              <caption class="sr-only">أيام الشهر الهجري المختار وما يوافقها من التاريخ الميلادي</caption>
              <thead>
                <tr>
                  <th scope="col">الأحد</th>
                  <th scope="col">الاثنين</th>
                  <th scope="col">الثلاثاء</th>
                  <th scope="col">الأربعاء</th>
                  <th scope="col">الخميس</th>
                  <th scope="col">الجمعة</th>
                  <th scope="col">السبت</th>
                </tr>
              </thead>
              <tbody id="hij-grid-body"></tbody>
            </table>
          </div>
        </section>
      </div>

      <div class="panel__foot">
        كل الحسابات تجري داخل متصفحك اعتماداً على بيانات تقويم أم القرى المدمجة فيه؛ لا يُرسل أي تاريخ ولا يُخزَّن بعد إغلاق الصفحة.
      </div>
    </div>
  </Fragment>

  <h2>كم التاريخ الهجري اليوم؟</h2>
  <p>
    بمجرد أن تُفتح الصفحة تجد تاريخ اليوم بالهجري معروضاً في أعلى الأداة: اليوم والشهر والسنة، ويوم الأسبوع، وما يوافقه
    في التقويم الميلادي؛ فلا حاجة إلى كتابة أي شيء ولا إلى الضغط على أي زر، وإن أردت إعادته لاحقاً فزر «اليوم» يكفي.
    والحساب يجري بتقويم أم القرى المدمج في متصفحك، وهو تقويم حسابي تعتمده السعودية رسمياً. لكن بداية الشهر الهجري في
    بلدك قد تُعلن بالرؤية أو بقرار الجهة الشرعية أو الفلكية المختصة، ولهذا قد يختلف ما تراه هنا عن الإعلان الرسمي بيوم
    واحد. فإن كان التاريخ يخص معاملة رسمية أو موعداً لعبادة، فاعتمد إعلان الجهة المختصة في بلدك، وخذ ما تعرضه الصفحة
    كمرجع تقريبي.
  </p>

  <h2>تحويل التاريخ الميلادي إلى هجري والعكس</h2>
  <p>
    تعمل الأداة في الاتجاهين، وتبدّل بينهما من زرّي الاتجاه أعلى المحوّل. في الاتجاه الميلادي تكفيك خانة واحدة بتاريخ
    بنسق السنة-الشهر-اليوم الذي يعرفه المتصفح؛ أما في الاتجاه الهجري فلا توجد خانة إدخال قياسية من هذا النوع، لأن
    التقويم الهجري لا يعرفه المتصفح بصيغة إدخال موحّدة، ولذلك يلزمك إدخال اليوم الهجري والشهر الهجري والسنة الهجرية
    صراحةً. اكتب الثلاثية كما تُكتب عادةً — مثل ١ رمضان ١٤٤٧ هـ — فيظهر المقابل الميلادي فوراً في الجهة الأخرى،
    ويفعل الاتجاه المعاكس الشيء نفسه. ومن يريد معرفة عمره فقط فليستخدم
    <a href="/ar/احسب-عمرك-بالهجري/">حاسبة العمر بالهجري</a>.
  </p>

  <h2>كيف يعمل التحويل</h2>
  <p>
    لا تحمل هذه الصفحة أي جداول تواريخ هجرية ولا أي بيانات عن الأشهر، بل تسأل المتصفح نفسه. فعند التحويل من الميلادي إلى الهجري
    نُنشئ كائن <code>Intl.DateTimeFormat</code> بالمعرّف <code>ar-SA-u-ca-islamic-umalqura</code>، ثم نُنسّق اليوم المطلوب ونقرأ
    أجزاءه (اليوم، الشهر، السنة) عبر <code>formatToParts</code>، فيكون الناتج هو التاريخ الهجري الذي يعتمده متصفحك وفق تقويم
    أم القرى. أما الاتجاه المعاكس فأصعب، لأن <code>Intl</code> يُنسّق ولا يُحلّل: لا توجد دالة تقبل «٣ ربيع الأول ١٤٤٧» وتُعيد
    التاريخ الميلادي المقابل. لذلك نستعمل بحثاً ثنائياً: نحدّد نطاقاً ميلادياً واسعاً، ثم نختبر اليوم الأوسط فيه، وننسّقه هجرياً،
    ونقارن الثلاثية (سنة، شهر، يوم) بالتاريخ المطلوب، ثم نضيّق النطاق من الجهة الصحيحة ونُعيد الاختبار حتى تتقارب النتيجتان في
    نحو ست عشرة خطوة. وبعد كل تحويل نُعيد التحويل في الاتجاه المعاكس ونتأكد من العودة إلى اليوم نفسه، فإن تطابق الناتج ظهرت
    إشارة «تم التحقق من التحويل».
  </p>

  <h2>دقة التقويم الهجري وحدوده</h2>
  <p>
    تقويم أم القرى تقويم <strong>حسابي</strong> لا تقويم رؤية: تُحسب بداية الشهر فلكياً وفق شروط محدّدة، ثم تُعلن الجهة الرسمية في
    كل بلد بداية الشهر بناءً على الرؤية أو على إعلانها الخاص. لذلك قد يختلف اليوم الذي تعرضه هذه الأداة عن التقويم المُعلن في
    بلدك بيوم أو يومين، وقد يختلف كذلك عن تقاويم إسلامية أخرى تعتمد قواعد مختلفة. وهذه الأداة ليست حكماً شرعياً ولا فتوى، ولا
    تُبنى عليها مواعيد العبادات؛ فالمُعتمد شرعاً هو إعلان الجهة المختصة في بلدك. وثمة حدود تقنية ينبغي معرفتها: بيانات أم القرى
    داخل المتصفحات تغطي نطاقاً محدوداً حول 1356–1500 هجرية (1937–2077 ميلادياً)، وما قبل ذلك قد يُنسَّق بحساب هجري آخر من دون
    تنبيه، ولذلك يقتصر البحث هنا على هذا النطاق ويُنبّهك صراحةً عند تجاوزه. كما أن الناتج يتبع المنطقة الزمنية لجهازك، فقد يقع
    التاريخ على يوم هجري مختلف إذا حلّلته قرب منتصف الليل أو كنت في منطقة بعيدة عن مكة المكرمة.
  </p>

  <h2>كيف تستخدمه عملياً</h2>
  <p>
    ابدأ من المحوّل: اختر الاتجاه، واكتب التاريخ في الجهة المُظلَّلة، أو اضغط «اليوم» لتُملأ الجهتان بتاريخ اليوم، ثم اقرأ السطر
    الكبير مثل «الخميس ٣ ربيع الأول ١٤٤٨ هـ» وتحته ما يوافقه ميلادياً. إن لم تظهر إشارة التحقق فذلك يعني أن التاريخ خارج نطاق
    بيانات متصفحك، وستجد التنبيه واضحاً أعلى الأداة. وبعد ذلك:
  </p>
  <ul>
    <li>حاسبة العمر: اكتب تاريخ ميلادك، وسيُحسب العمر بالسنوات والأشهر والأيام الهجرية بمقارنة الثلاثيات واستعارة أيام الشهر الفعلي، لا بقسمة مجموع الأيام، مع العمر الميلادي وإجمالي الأيام والعدّ التنازلي إلى عيد ميلادك الهجري القادم.</li>
    <li>الفرق بين تاريخين: يمنحك عدد الأيام الكامل، وما يعادله بالأسابيع والأيام، والفرق بالتقويم الهجري.</li>
    <li>جدول الشهر: يعرض الشهر الهجري المختار شبكةً من الأحد إلى السبت، وتحت كل يوم هجري رقمه الميلادي، ويُظلَّل يومك الحالي بلون مميّز.</li>
  </ul>
  <p>
    كل الحقول تُعبَّأ بلوحة المفاتيح، وكل النتائج تُعلَن لقارئات الشاشة، والصفحة تعمل بلا إنترنت وبلا حساب. وإن كان التاريخ حساساً
    — عقد، أو سفر، أو موعد عبادة — فقابله مع التقويم الرسمي في بلدك قبل الاعتماد عليه.
  </p>
</ArToolLayout>

