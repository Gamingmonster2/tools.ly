---
import Icon from "./Icon.astro";
import ToolCard from "./ToolCard.astro";
import { allTools, categories, urlOf, type Tool } from "../data/tools";

interface Props {
  /** Show only the first N tools (used on the homepage). */
  limit?: number;
  heading?: string;
}

const { limit, heading = "Browse every tool" } = Astro.props;
const tools: Tool[] = limit ? allTools.slice(0, limit) : allTools;
const usedCategories = categories.filter((c) => allTools.some((t) => t.category === c.id));
---

<section class="section" id="all-tools">
  <div class="container">
    <div
      style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:flex-end;margin-bottom:1.25rem"
    >
      <div>
        <p class="eyebrow">Tool directory</p>
        <h2 style="margin-bottom:0.25rem">{heading}</h2>
        <p class="lede" style="margin:0">
          {allTools.length} browser tools and counting. No installs, no accounts, nothing uploaded.
        </p>
      </div>

      <div class="field dir-search" style="flex:1 1 260px">
        <label for="tool-search">Search tools</label>
        <input
          id="tool-search"
          type="search"
          placeholder="Try “color”, “password”, “convert”…"
          autocomplete="off"
          data-tool-search
        />
      </div>
    </div>

    <div class="cat-nav" role="group" aria-label="Filter by category">
      <button type="button" data-cat="all" aria-pressed="true">All</button>
      {
        usedCategories.map((c) => (
          <button type="button" data-cat={c.id} aria-pressed="false">{c.label}</button>
        ))
      }
    </div>

    <div class="tool-grid" data-tool-grid>
      {
        tools.map((tool) =>
          tool.status === "live" ? (
            <ToolCard tool={tool} />
          ) : (
            <div class="tool-card tool-card--soon" data-search={`${tool.title} ${tool.description}`} data-cat={tool.category}>
              <span class="tool-card__icon" aria-hidden="true"><Icon name={tool.icon} size={20} /></span>
              <span>
                <span class="tool-card__title">{tool.title}</span>
                <span class="tool-card__desc">{tool.description}</span>
                <span class="badge" style="margin-top:0.4rem">Coming soon</span>
              </span>
            </div>
          )
        )
      }
    </div>

    <p class="empty-state" data-empty hidden style="margin-top:1rem">
      No tools match that search yet. Try a different word, or <a href="/7b3c2-contact/">suggest a tool</a>.
    </p>
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>("[data-tool-grid]");
  const search = document.querySelector<HTMLInputElement>("[data-tool-search]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".cat-nav button"));

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".tool-card")).map((el) => ({
      el,
      category: el.dataset.cat ?? "",
      text: ((el.dataset.search ?? "") + " " + (el.textContent ?? "")).toLowerCase(),
    }));

    let activeCat = "all";

    const apply = () => {
      const q = (search?.value ?? "").trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const okCat = activeCat === "all" || card.category === activeCat;
        const okText = q === "" || card.text.includes(q);
        const show = okCat && okText;
        card.el.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        activeCat = chip.dataset.cat ?? "all";
        for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
        apply();
      });
    }

    search?.addEventListener("input", apply);
  }
</script>
