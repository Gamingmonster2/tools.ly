---
import ArToolLayout from "../../layouts/ArToolLayout.astro";
import { arTools } from "../../data/arTools";

const tool = arTools.find((t) => t.slug === "احسب-عمرك-بالهجري")!;

const faqs = [
  {
    q: "كيف أحسب عمري بالهجري بدون تطبيق؟",
    a: "اكتب تاريخ ميلادك الميلادي في الحقل الأول من الأداة أعلاه، واقرأ الجواب في السطر الكبير مباشرة، فلا تحتاج إلى تنزيل أي شيء ولا إلى حساب يدوي. وإن أردت أن تفعلها بالورقة والقلم فحوّل تاريخ ميلادك إلى الهجري، وحوّل تاريخ اليوم كذلك، ثم قارن الثلاثيتين: اطرح الأيام من الأيام والأشهر من الأشهر والسنوات من السنوات. فإن كانت أيام تاريخ الحساب أقل من أيام الميلاد فاستعر شهراً كاملاً من الشهر السابق وأضف إلى الأيام عدد أيامه الفعلية، وهو ٢٩ أو ٣٠ بحسب الشهر والسنة، ثم استعر سنة من السنوات إن احتجت. هذا الاقتراض هو الفرق بين حساب صحيح وحساب تقريبي.",
  },
  {
    q: "لماذا عمري بالهجري أقل من عمري الميلادي؟",
    a: "أكثر الناس يجدون الأمر معكوساً: لأن السنة الهجرية أقصر بنحو أحد عشر يوماً من الميلادية، فإن عدد سنواتك الهجرية يسبق عدد سنواتك الميلادية، فقد يكون عمرك ٣٣ سنة ميلادية و٣٤ سنة هجرية في الوقت نفسه. فإن ظهر لك رقم أقل في موقع آخر فالسبب غالباً أحد أمرين: إما أن ذلك الموقع يقسم مجموع أيامك على ٣٥٤٫٢٥ ثم يقرّب الناتج، وهو تقريب يخطئ عند حدود السنة، وإما أنك قارنت تاريخاً هجرياً بتاريخ ميلادي مختلف، فاختلط التقويمان في المقارنة. أما عدد الأيام فمقياس واحد في التقويمين، فلا يتغير بتغيّر التقويم.",
  },
  {
    q: "هل الحساب دقيق؟",
    a: "دقيق في حدود يوم واحد تقريباً. الحساب نفسه بلا تقريب: نقارن الثلاثيات الهجرية ونستعير أيام الشهر الفعلي (٢٩ أو ٣٠)، ولا نقسم مجموع الأيام على ٣٥٤٫٢٥. لكن بداية الشهر في تقويم أم القرى محسوبة فلكياً، بينما تُعلن في كل بلد بناءً على رؤية الهلال أو قرار الجهة المختصة، فقد يختلف الإعلان عن الحساب بيوم أو يومين. ويُضاف إلى ذلك أن بيانات التقويم مضمّنة في متصفحك وقد تختلف قليلاً بين إصدار وآخر، وأن اليوم الهجري شرعاً يبدأ من المغرب لا من منتصف الليل. فاعتبر الرقم صحيحاً في حدود يوم، ولا تعتمد عليه في موعد عبادة أو معاملة رسمية.",
  },
  {
    q: "كيف أعرف عيد ميلادي الهجري ومتى يوافق بالميلادي؟",
    a: "الأداة تحسبه لك تلقائياً في البطاقة الأخيرة: تأخذ يوم ميلادك وشهره في التقويم الهجري، وتضعهما في السنة الهجرية التي لم يأتِ موعدهما فيها بعد، فإن كان الموعد قد مضى هذا العام انتقلت إلى السنة التالية. وإن كان شهرك القادم أقصر من يوم ميلادك (شهر من ٢٩ يوماً) ضُبط اليوم على آخر يوم فيه كما يفعل الناس في التقويم الميلادي مع ٢٩ فبراير. ثم تبحث الأداة عن التاريخ الميلادي المقابل لهذا اليوم وتكتبه أمامك، مع عدد الأيام الباقية حتى يحين. فإن أردت تحويل تواريخ أخرى بحرية — سفر أو عقد أو تاريخ قديم — فالمحوّل المخصص في الصفحة المرتبطة أسفل الأداة يفعل ذلك.",
  },
];

const sources = [
  {
    label: "MDN — Intl.DateTimeFormat وتقويم islamic-umalqura",
    href: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/DateTimeFormat",
    note: "المرجع الذي يوضح كيف يُنسّق المتصفح التواريخ بحسب التقويم المطلوب، ومنه تقويم أم القرى، وكيف تُقرأ أجزاء التاريخ (اليوم والشهر والسنة) عبر formatToParts؛ وعليه يقوم كل حساب في هذه الصفحة.",
  },
  {
    label: "يونيكود CLDR — بيانات التقويمات (UTS #35: Dates)",
    href: "https://unicode.org/reports/tr35/tr35-dates.html",
    note: "المواصفة التي تعرّف بيانات التقويمات في مشروع يونيكود، ومنها التقويم الإسلامي بأم القرى، وأسماء الأشهر الهجرية العربية وترتيبها؛ ومن هذه البيانات تبني المتصفحات أسماء مثل «ربيع الأول» و«ذو الحجة».",
  },
  {
    label: "تقويم أم القرى الرسمي",
    href: "https://www.ummulqura.org.sa/",
    note: "الموقع الرسمي لتقويم أم القرى الصادر عن مدينة الملك عبدالعزيز للعلوم والتقنية، وهو التقويم المعتمد رسمياً في السعودية والمرجع الذي تُقابَل به أرقام هذه الأداة عند أي اختلاف.",
  },
];
---

<ArToolLayout
  tool={tool}
  intro="اكتب تاريخ ميلادك واقرأ فوراً كم عمرك بالسنوات والأشهر والأيام الهجرية، مع عمرك الميلادي وإجمالي أيامك وموعد عيد ميلادك الهجري القادم — والحساب كله يجري داخل متصفحك."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div class="ha-fields">
          <div class="field">
            <label for="ha-born">تاريخ الميلاد (ميلادي)</label>
            <input type="date" id="ha-born" name="ha-born" autocomplete="off" />
            <p class="ha-hint">اكتب تاريخ ميلادك كما هو في التقويم الميلادي.</p>
          </div>
          <div class="field">
            <label for="ha-until">احسب العمر حتى تاريخ</label>
            <input type="date" id="ha-until" name="ha-until" autocomplete="off" />
            <p class="ha-hint">افتراضياً اليوم؛ غيّره إن أردت معرفة عمرك في تاريخ آخر.</p>
          </div>
        </div>

        <div class="ha-actions">
          <button type="button" class="btn btn--soft btn--sm" id="ha-today">اليوم</button>
        </div>

        <div class="callout callout--warn ha-alert" id="ha-alert" role="alert" hidden>
          <p id="ha-alert-text"></p>
        </div>

        <p class="ha-answer" id="ha-answer" aria-live="polite" data-state="muted">
          اكتب تاريخ ميلادك بالأعلى، وسيظهر عمرك بالتقويم الهجري في هذه المساحة مباشرة.
        </p>
        <p class="ha-born-note" id="ha-born-note" aria-live="polite"></p>

        <div class="stat-grid ha-stats">
          <div class="stat">
            <div class="stat__label">العمر بالسنوات الهجرية (إجمالي)</div>
            <div class="stat__value" id="ha-years-hij">—</div>
            <div class="ha-sub" id="ha-years-hij-sub"></div>
          </div>
          <div class="stat">
            <div class="stat__label">العمر بالأشهر الهجرية</div>
            <div class="stat__value" id="ha-months-hij">—</div>
            <div class="ha-sub" id="ha-months-hij-sub"></div>
          </div>
          <div class="stat">
            <div class="stat__label">العمر بالأيام</div>
            <div class="stat__value" id="ha-days-hij">—</div>
            <div class="ha-sub" id="ha-days-hij-sub"></div>
          </div>
          <div class="stat">
            <div class="stat__label">العمر الميلادي (سنوات وأشهر وأيام)</div>
            <div class="stat__value" id="ha-greg-age">—</div>
            <div class="ha-sub" id="ha-greg-age-sub"></div>
          </div>
          <div class="stat">
            <div class="stat__label">إجمالي الأيام الميلادية</div>
            <div class="stat__value" id="ha-days-greg">—</div>
            <div class="ha-sub" id="ha-days-greg-sub"></div>
          </div>
          <div class="stat ha-stat-wide">
            <div class="stat__label">عيد ميلادك الهجري القادم</div>
            <div class="stat__value" id="ha-next-hij">—</div>
            <div class="ha-sub" id="ha-next-hij-sub"></div>
          </div>
        </div>

        <p class="ha-more">
          هذه الصفحة تحسب العمر وحده. وإن أردت تحويل تاريخ بعينه — ميلادي إلى هجري أو هجري إلى ميلادي — أو معرفة التاريخ الهجري
          لليوم أو الفرق بين تاريخين، فاستعمل <a href="/ar/التقويم-الهجري/">محوّل التاريخ الهجري والميلادي</a>.
        </p>
      </div>

      <div class="panel__foot">
        الحساب يعتمد تقويم أم القرى <strong>المحسوب</strong> المدمج في متصفحك؛ وبداية الشهر المُعلنة في بلدك قد تختلف عنه بيوم أو
        يومين، فخُذ الرقم صحيحاً في حدود يوم تقريباً. لا يُرسل أي تاريخ ولا يُحفظ بعد إغلاق الصفحة.
      </div>
    </div>
  </Fragment>

  <h2>كيف أحسب عمري بالهجري؟</h2>
  <p>
    إن كان سؤالك «كم عمري بالهجري» فله جواب واحد مباشر، ولهذا وُضع في هذه الصفحة سطر كبير لا يقول شيئاً آخر: تكتب تاريخ ميلادك
    الميلادي، وتترك «احسب العمر حتى تاريخ» على اليوم، فيظهر فوراً جواب من قبيل «عمرك ٣٤ سنة و٧ أشهر و١٢ يوماً بالتقويم الهجري».
    لا تحتاج إلى تطبيق، ولا إلى حفظ أطوال الأشهر الهجرية، ولا إلى تحويل يدوي قبل ذلك.
  </p>
  <p>
    أما كيف احسب عمري بالهجري بنفسي، فالطريق الصحيح أن تحوّل تاريخ ميلادك إلى التاريخ الهجري المقابل، وتحوّل تاريخ الحساب كذلك،
    ثم تقارن الثلاثيتين: سنة بسنة، وشهر بشهر، ويوم بيوم. فإن كانت أيام تاريخ الحساب أقل من أيام تاريخ الميلاد استعرت شهراً كاملاً
    من الشهر السابق وزدت على الأيام عدد أيامه الفعلية، وهو ٢٩ أو ٣٠ بحسب الشهر والسنة، ثم استعرت سنة من السنوات إن لزم الأمر. ولهذا
    لا تصلح قسمة مجموع الأيام على ٣٥٤٫٢٥ لتقول إن هذا عمرك: فهي قسمة تعطي رقماً تقريبياً وتخطئ حين يقترب يوم الحساب من يوم
    الميلاد. وحساب العمر بالهجري والميلادي معاً هو ما تعرضه الأداة: العمر الهجري في السطر الكبير، والعمر الميلادي وإجمالي الأيام
    وموعد عيد ميلادك الهجري القادم في البطاقات تحته.
  </p>

  <h2>الفرق بين العمر الهجري والعمر الميلادي</h2>
  <p>
    السنة الهجرية أقصر من الميلادية بنحو أحد عشر يوماً، لأنها اثنا عشر شهراً قمرياً يتراوح مجموعها بين ٣٥٤ و٣٥٥ يوماً، بينما
    السنة الميلادية ٣٦٥ أو ٣٦٦ يوماً. ونتيجة هذا الفرق أن عدد سنواتك الهجرية يسبق عدد سنواتك الميلادية مع مرور الوقت: من كان عمره
    ٣٣ سنة ميلادية قد يكون ٣٤ سنة هجرية، ويتراكم الفرق سنة كاملة كل ثلاث وثلاثين سنة ميلادية تقريباً. فإذا اختلف الرقمان فليس
    أحدهما خطأً، بل هما قياسان مختلفان للمدة نفسها.
  </p>
  <p>
    والفرق لا يقف عند السنوات: الشهر الهجري ٢٩ أو ٣٠ يوماً فقط، فسبعة أشهر هجرية ليست سبعة أشهر ميلادية ولا تساويها في عدد
    الأيام. أما الأيام فمقياس واحد في التقويمين، لأن اليوم نفسه هو اليوم؛ ولهذا تجد بطاقتي «العمر بالأيام» و«إجمالي الأيام
    الميلادية» بالرقم نفسه، والفرق بينهما أن الثانية تبيّن ما يعادله بالأسابيع والأيام. وهذه المساواة مقصودة ومكتوبة هنا صراحةً
    حتى لا تظن أن في الأداة تكراراً بلا معنى.
  </p>

  <h2>لماذا يختلف عمرك الهجري بيوم أو يومين</h2>
  <p>
    تقويم أم القرى تقويم <strong>حسابي</strong>: تُحسب بداية الشهر فلكياً وفق شروط محدّدة، لا برؤية الهلال. أما التقويم المعمول
    به رسمياً في بلدك فقد يقوم على الرؤية أو على إعلان الجهة الشرعية أو الفلكية، ويجوز أن يختلف إعلانه عن الحساب بيوم أو يومين.
    فإن ظهر لك في هذه الصفحة «١٢ يوماً» وظهر عند الجهة الرسمية في بلدك «١١» أو «١٣»، فالفارق يوم واحد، وليس خطأً في الحساب.
  </p>
  <p>
    ويُضاف إلى ذلك سببان آخران. الأول أن بيانات التقويم تأتي من مكتبة التقويم المضمّنة في نظامك، وقد تختلف بدايات بعض الأشهر
    اختلافاً طفيفاً بين إصدار وآخر. والثاني هو المنطقة الزمنية: نحن نحسب باليوم لا باللحظة، لكن اليوم الهجري شرعاً يبدأ من غروب
    الشمس بينما المتصفح يبدأ يومه من منتصف الليل؛ فإن حسبت قرب منتصف الليل أو كنت في بلد بعيد عن مكة المكرمة فقد يقع يومك في
    تاريخ هجري مختلف. ولهذا نقول إن الفرق قد يبلغ يوماً أو يومين، ولا نقول إن الرقم قطعي.
  </p>

  <h2>دقة النتيجة وحدودها</h2>
  <p>
    النتيجة دقيقة في حدود يوم واحد تقريباً. هي صحيحة تماماً ما دامت بداية الشهر في بلدك موافقة لما يحسبه أم القرى، وتنقص أو
    تزيد يوماً حين يختلف الإعلان الرسمي عن الحساب. وليست هذه الأداة حكماً شرعياً ولا فتوى ولا مرجعاً قانونياً، فلا تُبنى عليها
    مواعيد عبادة ولا مواعيد عقود ومعاملات رسمية؛ المرجع في ذلك إعلان الجهة المختصة في بلدك، وما هنا مرجع تقريبي مفيد للمعرفة
    اليومية.
  </p>
  <p>
    وثمة حدّ تقني صريح: بيانات أم القرى في المتصفحات موثوقة في نطاق يقع بين ١٣٥٦ و١٥٠٠ هجرية، أي ما يوافق ١٩٣٧ و٢٠٧٧ ميلادياً
    تقريباً. فإن أدخلت تاريخاً خارج هذا النطاق نبّهتك الأداة صراحةً بدل أن تعطيك رقماً مضلِّلاً، وتبقى عندئذ أرقام العمر
    الميلادي وإجمالي الأيام صحيحة لأنها لا تعتمد على التقويم الهجري. وأخيراً، مهمة هذه الصفحة حساب العمر وحده؛ فمن أراد تحويل
    تاريخ بعينه أو عرض جدول الشهر أو الفرق بين تاريخين، فـ
    <a href="/ar/التقويم-الهجري/">محوّل التاريخ الهجري والميلادي</a> أنسب له من هذه الصفحة.
  </p>
</ArToolLayout>

