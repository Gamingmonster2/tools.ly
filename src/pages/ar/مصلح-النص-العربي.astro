      // والمراسلات لأنها أكثر ما يُنسخ من PDF.
      var COMMON = new Set(
        (
          "من في على إلى عن مع هذا هذه ذلك تلك هؤلاء الذي التي الذين اللاتي ما لا لم لن قد كل بعض غير سوى بين قبل بعد حتى إذا كما لكن بل أو ثم أن إن كان كانت يكون تكون ليس ليست هو هي هم هن نحن أنا أنت له لها لهم به بها بهم فيه فيها فيهم منه منها منهم عليه عليها عليهم إليه إليها إليهم عند عندنا لديه معه معها بينما حيث متى أين كيف لماذا ماذا هل نعم أيضا كذلك هكذا هنا هناك الآن اليوم أمس غدا سنة سنوات شهر أشهر يوم أيام ساعة وقت دقيقة لحظة صباح مساء ليل نهار أسبوع عام قرن ماء طعام بيت منزل مدينة قرية بلد دولة عالم أرض سماء شمس قمر نجم بحر نهر جبل شجرة طريق شارع باب غرفة كتاب كتب قلم ورق صفحة مدرسة جامعة طالب طلاب أستاذ معلم درس علم عمل وظيفة شركة مكتب اجتماع مشروع خطة هدف نتيجة سبب مشكلة حل سؤال جواب خبر كلام حديث لغة كلمة كلمات جملة نص معنى فكرة رأي حق واجب قانون حكم قرار حكومة رئيس ملك وزير شعب ناس رجل امرأة ولد بنت طفل أب أم أخ أخت جد جدة زوج زوجة ابن ابنة عائلة أسرة صديق أصدقاء جار ضيف إنسان شخص أحد أحدهم نفس ذاته شيء أشياء أمر حال وضع جزء نصف عدد مرة مرات أول آخر ثاني ثالث جديد قديم كبير صغير طويل قصير كثير قليل أفضل أحسن أهم جيد سيئ سهل صعب سريع بطيء جميل قوي ضعيف صحيح خطأ ممكن مستحيل ضروري مهم خاص يعني أي بسبب لذلك وفق حسب خلال ضمن دون بدون سوف أبدا دائما غالبا أحيانا ربما لعل كأن إلا جميع كلا كلاهما أكثر أقل أكبر أصغر نفسه نفسها مادة بند عقد اتفاق طرف يحق يجب يجوز مبلغ تاريخ رقم اسم عنوان توقيع ختم نسخة أصل أولا ثانيا ثالثا رابعا خامسا الله رسول صلى وسلم بسم الرحمن الرحيم الحمد رب سلام"
        )
          .split(" ")
          .map(normalizeWord)
          .filter(Boolean)
      );

      function isKnownWord(word) {
        var key = normalizeWord(word);
        if (!key) return false;
        if (COMMON.has(key)) return true;
        // «السلام» معروفة لأن «سلام» معروفة.
        if (key.length > 3 && key.slice(0, 2) === "\u0627\u0644") {
          return COMMON.has(key.slice(2));
        }
        return false;
      }

      function scoreRecognised(text) {
        var score = 0;
        var words = text.split(WORD_SPLIT);
        for (var i = 0; i < words.length; i += 1) {
          if (words[i] && isKnownWord(words[i])) score += 1;
        }
        return score;
      }

      // نقترح القلب فقط إذا كان مقلوب النص يحمل كلمات معروفة أكثر بوضوح،
      // وإلا فالسكوت أصدق من التخمين.
      function suggestReversal(raw) {
        if (!raw.trim()) return null;
        var base = scoreRecognised(raw);
        var byChars = scoreRecognised(mapLines(raw, reverseCharacters));
        var byWords = scoreRecognised(mapLines(raw, reverseWordOrder));
        var clearlyMore = function (candidate) {
          return candidate >= 3 && candidate >= base + 2 && candidate > base * 1.6;
        };
        if (clearlyMore(byChars) && byChars >= byWords) return "chars";
        if (clearlyMore(byWords)) return "words";
        return null;
      }

      /* ---------------- التقرير والملخّص ---------------- */

      function fixCount(flags) {
        var n = 0;
        if (flags.hidden) n += 1;
        if (flags.encoding) n += 1;
        if (flags.forms) n += 1;
        if (flags.spacing) n += 1;
        return n;
      }

      function fixesLabel(n) {
        if (n === 0) return "لا شيء";
        if (n === 1) return "إصلاح واحد";
        if (n === 2) return "إصلاحان";
        if (n <= 10) return NUM.format(n) + " إصلاحات";
        return NUM.format(n) + " إصلاحاً";
      }

      function describe(state) {
        if (!state.raw) {
          return { text: "الصق نصاً في الأعلى ليبدأ الفحص.", clean: false };
        }

        var report = state.report;
        var found = [];
        if (report.encoding) found.push("رموز غريبة من الترميز");
        else if (report.encodingBlocked) found.push("رموز غريبة تعذّر فكّها بأمان");
        if (report.forms) found.push("أشكال عرض");
        if (report.hidden > 0) found.push("محارف مخفية (" + NUM.format(report.hidden) + ")");
        if (report.spacing > 0) {
          found.push("مسافات بين الحروف (" + NUM.format(report.spacing) + ")");
        }
        if (state.reversal) found.push("ترتيب يبدو مقلوباً");

        if (!found.length && state.out === state.raw) {
          return { text: "النص يبدو سليماً — لم يُغيَّر شيء.", clean: true };
        }

        var parts = [
          found.length
            ? "تم اكتشاف: " + found.join(" · ")
            : "لم نكتشف مشكلة معروفة في الترميز ولا في العرض"
        ];

        if (state.out === state.raw) {
          parts.push("ولم يتغيّر النص لأن الإصلاحات المقابلة موقوفة في الخيارات أدناه");
        } else if (state.order !== "none") {
          parts.push(
            "وطُبِّق " +
              (state.order === "chars" ? "قلب ترتيب الحروف" : "قلب ترتيب الكلمات") +
              " بطلب منك"
          );
        }

        return { text: parts.join("؛ ") + ".", clean: found.length === 0 };
      }

      function getOrder() {
        for (var i = 0; i < orderRadios.length; i += 1) {
          if (orderRadios[i].checked) return orderRadios[i].value;
        }
        return "none";
      }

      /* ---------------- التحديث الحيّ ---------------- */

      function update() {
        var raw = input.value;
        var order = getOrder();
        var opts = {
          hidden: optHidden.checked,
          encoding: optEncoding.checked,
          forms: optForms.checked,
          spacing: optSpacing.checked,
          order: order
        };

        // مسار الفحص: كل الإصلاحات مفعّلة وبلا قلب، حتى يكون التقرير صادقاً
        // حتى حين يُوقف أحد الخيارات.
        var everyRepair = {
          hidden: true,
          encoding: true,
          forms: true,
          spacing: true,
          order: "none"
        };
        var probe = runPipeline(raw, everyRepair);

        var isDefault =
          opts.hidden && opts.encoding && opts.forms && opts.spacing && order === "none";
        var applied = isDefault ? probe : runPipeline(raw, opts);
        var out = applied.text;

        var reversal = suggestReversal(raw);
        var info = describe({
          raw: raw,
          out: out,
          report: applied.report,
          reversal: reversal,
          order: order
        });

        output.value = out;
        detect.textContent = info.text;
        detect.classList.toggle("detect--ok", info.clean);
        warnBox.hidden = !(info.clean && raw.length > 0);

        suggestBox.hidden = !reversal;
        if (reversal) {
          suggestText.textContent =
            reversal === "chars"
              ? "يبدو أن ترتيب الحروف مقلوب؛ جرّب «اقلب ترتيب الحروف» ثم راجع الناتج."
              : "يبدو أن ترتيب الكلمات مقلوب؛ جرّب «اقلب ترتيب الكلمات» ثم راجع الناتج.";
        }

        var before = measure(raw);
        var after = measure(out);
        $("st-letters-before").textContent = NUM.format(before.letters);
        $("st-letters-after").textContent = NUM.format(after.letters);
        $("st-words-before").textContent = NUM.format(before.words);
        $("st-words-after").textContent = NUM.format(after.words);
        $("st-lines").textContent = NUM.format(after.lines);
        $("st-fixed").textContent = fixesLabel(fixCount(applied.applied));
      }

      /* ---------------- الأزرار ---------------- */

      $("btn-copy").addEventListener("click", function () {
        var text = output.value;
        if (!text) {
          copyStatus.textContent = "لا يوجد ناتج لنسخه بعد.";
          return;
        }
        var done = function () {
          copyStatus.textContent = "تم نسخ الناتج إلى الحافظة.";
        };
        var fail = function () {
          copyStatus.textContent = "تعذّر النسخ تلقائياً؛ حدّد النص في المربع وانسخه يدوياً.";
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, fail);
          return;
        }
        // مسار بديل للمتصفحات التي لا تسمح بالوصول إلى الحافظة.
        var helper = document.createElement("textarea");
        helper.value = text;
        helper.setAttribute("readonly", "readonly");
        helper.setAttribute("aria-hidden", "true");
        helper.style.position = "absolute";
        helper.style.insetInlineStart = "-9999px";
        document.body.appendChild(helper);
        helper.select();
        var ok = false;
        try {
          ok = document.execCommand("copy");
        } catch (err) {
          ok = false;
        }
        document.body.removeChild(helper);
        if (ok) done();
        else fail();
      });

      $("btn-clear").addEventListener("click", function () {
        input.value = "";
        copyStatus.textContent = "تم تفريغ الحقل.";
        update();
        input.focus();
      });

      input.addEventListener("input", update);
      [optHidden, optEncoding, optForms, optSpacing].forEach(function (box) {
        box.addEventListener("change", update);
      });
      orderRadios.forEach(function (radio) {
        radio.addEventListener("change", update);
      });

      update();
    })();
  </script>
</ArToolLayout>
