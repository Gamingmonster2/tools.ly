      var matchB = true;
      for (var i = 0; i < 11; i++) {
        if (bits[i] !== a[i]) matchA = false;
        if (bits[i] !== b[i]) matchB = false;
      }
      return matchA || matchB;
    }

    function computePenalty(grid) {
      var size = grid.length;
      var score = 0;
      var i;
      var j;
      var k;

      // Rule 1: runs of five or more identical modules.
      for (i = 0; i < size; i++) {
        for (j = 0; j < size; j++) {
          if (i === 0 || grid[i][j] !== grid[i - 1][j]) {
            var runV = 1;
            while (i + runV < size && grid[i + runV][j] === grid[i][j]) runV++;
            if (runV >= 5) score += 3 + (runV - 5);
          }
          if (j === 0 || grid[i][j] !== grid[i][j - 1]) {
            var runH = 1;
            while (j + runH < size && grid[i][j + runH] === grid[i][j]) runH++;
            if (runH >= 5) score += 3 + (runH - 5);
          }
        }
      }

      // Rule 2: 2x2 blocks of one colour.
      for (i = 0; i < size - 1; i++) {
        for (j = 0; j < size - 1; j++) {
          var v = grid[i][j];
          if (v === grid[i][j + 1] && v === grid[i + 1][j] && v === grid[i + 1][j + 1]) score += 3;
        }
      }

      // Rule 3: finder-like 1:1:3:1:1 patterns with a four-module light run.
      for (i = 0; i < size; i++) {
        for (j = 0; j + 11 <= size; j++) {
          var rowBits = [];
          var colBits = [];
          for (k = 0; k < 11; k++) {
            rowBits.push(grid[i][j + k]);
            colBits.push(grid[j + k][i]);
          }
          if (finderLike(rowBits)) score += 40;
          if (finderLike(colBits)) score += 40;
        }
      }

      // Rule 4: deviation of the dark-module share from 50%.
      var dark = 0;
      for (i = 0; i < size; i++) {
        for (j = 0; j < size; j++) dark += grid[i][j];
      }
      var total = size * size;
      var percent = (dark * 100) / total;
      var step = Math.floor(Math.abs(percent - 50) / 5);
      score += step * 10;

      return score;
    }

    function buildMatrix(bytes, version, levelName, levelIndex) {
      var size = version * 4 + 17;
      var base = blankGrid(size);
      var reserved = blankGrid(size);
      placeFunctionPatterns(base, reserved, version);

      var codewords = makeCodewords(bytes, version, levelIndex);
      var data = blankGrid(size);
      placeData(data, reserved, codewords);

      var best = null;
      for (var mask = 0; mask < 8; mask++) {
        var candidate = new Array(size);
        for (var r = 0; r < size; r++) {
          var row = new Uint8Array(size);
          for (var c = 0; c < size; c++) {
            var value = base[r][c];
            if (!reserved[r][c]) {
              value = data[r][c] ^ (MASK_RULES[mask](r, c) ? 1 : 0);
            }
            row[c] = value;
          }
          candidate[r] = row;
        }
        drawFormat(candidate, levelName, mask);
        if (version >= 7) drawVersionInfo(candidate, version);

        var penalty = computePenalty(candidate);
        if (!best || penalty < best.penalty) {
          best = { grid: candidate, mask: mask, penalty: penalty };
        }
      }

      return { grid: best.grid, mask: best.mask, size: size, version: version, penalty: best.penalty };
    }

    /* ------------------------------------------------------------------ *
     * Self-check: read the format information back out of the matrix.
     * ------------------------------------------------------------------ */

    function readFormat(grid) {
      var groups = formatInfoCells(grid.length);
      var raw = 0;
      var second = 0;
      var i;

      // Both copies are stored most-significant bit first. Copy two has no cell
      // for bit 7, which is the always-dark module, so read it in two runs.
      for (i = 0; i < 7; i++) {
        raw = (raw << 1) | grid[groups[0][i][0]][groups[0][i][1]];
        second = (second << 1) | grid[groups[1][i][0]][groups[1][i][1]];
      }
      for (i = 7; i < 15; i++) {
        raw = (raw << 1) | grid[groups[0][i][0]][groups[0][i][1]];
        if (i > 7) second = (second << 1) | grid[groups[1][i - 1][0]][groups[1][i - 1][1]];
      }

      var unmasked = raw ^ FORMAT_MASK;
      var data = unmasked >> 10;
      var levelBits = (data >> 3) & 3;
      var mask = data & 7;

      var level = null;
      for (var name in LEVEL_BITS) {
        if ((LEVEL_BITS[name][0] << 1 | LEVEL_BITS[name][1]) === levelBits) level = name;
      }

      return {
        raw: raw,
        second: second,
        level: level,
        mask: mask,
        copiesAgree: raw === second,
      };
    }

    /* ------------------------------------------------------------------ *
     * Payload building.
     * ------------------------------------------------------------------ */

    function escapeWifi(value) {
      return String(value).replace(/([\\;,:"])/g, "\\$1");
    }

    function element(id) {
      return document.getElementById(id);
    }

    function currentMode() {
      return element("qg-mode").value;
    }

    function buildPayload() {
      var mode = currentMode();

      if (mode === "wifi") {
        var ssid = element("qg-wifi-ssid").value.trim();
        if (ssid === "") return { error: "Enter the network name (SSID) before generating a code." };
        var auth = element("qg-wifi-auth").value;
        var out = "WIFI:T:" + auth + ";S:" + escapeWifi(ssid) + ";";
        if (auth !== "nopass") {
          var pass = element("qg-wifi-pass").value;
          if (pass === "") return { error: "Enter the network password, or choose the open-network security type." };
          out += "P:" + escapeWifi(pass) + ";";
        }
        if (element("qg-wifi-hidden").checked) out += "H:true;";
        out += ";";
        return { text: out };
      }

      if (mode === "email") {
        var to = element("qg-email-to").value.trim();
        if (to === "") return { error: "Enter a recipient address before generating a code." };
        var subject = element("qg-email-subject").value;
        var body = element("qg-email-body").value;
        var params = [];
        if (subject !== "") params.push("subject=" + encodeURIComponent(subject));
        if (body !== "") params.push("body=" + encodeURIComponent(body));
        var mailto = "mailto:" + to;
        if (params.length) mailto += "?" + params.join("&");
        return { text: mailto };
      }

      if (mode === "phone") {
        var number = element("qg-phone").value.trim();
        if (number === "") return { error: "Enter a phone number before generating a code." };
        return { text: "tel:" + number.replace(/[\s().-]/g, "") };
      }

      if (mode === "sms") {
        var smsTo = element("qg-sms-to").value.trim();
        if (smsTo === "") return { error: "Enter a phone number before generating a code." };
        var message = element("qg-sms-body").value;
        return { text: "SMSTO:" + smsTo.replace(/[\s().-]/g, "") + (message === "" ? "" : ":" + message) };
      }

      var text = element("qg-text").value;
      if (text === "") return { error: "Type some text or a URL before generating a code." };
      return { text: text };
    }

    function toUtf8(text) {
      if (typeof TextEncoder !== "undefined") return new TextEncoder().encode(text);
      var out = [];
      for (var i = 0; i < text.length; i++) {
        var code = text.charCodeAt(i);
        if (code < 0x80) out.push(code);
        else if (code < 0x800) out.push(0xc0 | (code >> 6), 0x80 | (code & 63));
        else out.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 63), 0x80 | (code & 63));
      }
      return Uint8Array.from(out);
    }

    /* ------------------------------------------------------------------ *
     * Rendering.
     * ------------------------------------------------------------------ */

    var SVG_NS = "http://www.w3.org/2000/svg";
    var last = null;

    function clampNumber(value, min, max, fallback) {
      var n = Number(value);
      if (!isFinite(n)) return fallback;
      if (n < min) return min;
      if (n > max) return max;
      return n;
    }

    function safeColor(value, fallback) {
      return /^#[0-9a-fA-F]{6}$/.test(String(value)) ? String(value) : fallback;
    }

    function renderSvg(svg, matrix, margin, fg, bg) {
      var size = matrix.length;
      var span = size + margin * 2;

      while (svg.firstChild) svg.removeChild(svg.firstChild);

      var title = document.createElementNS(SVG_NS, "title");
      title.textContent =
        "QR code, version " +
        last.version +
        ", error-correction level " +
        last.level +
        ", mask " +
        last.mask +
        ", " +
        size +
        " by " +
        size +
        " modules.";
      svg.appendChild(title);

      var bgRect = document.createElementNS(SVG_NS, "rect");
      bgRect.setAttribute("x", "0");
      bgRect.setAttribute("y", "0");
      bgRect.setAttribute("width", String(span));
      bgRect.setAttribute("height", String(span));
      bgRect.setAttribute("fill", bg);
      svg.appendChild(bgRect);

      var parts = [];
      for (var r = 0; r < size; r++) {
        for (var c = 0; c < size; c++) {
          if (!matrix[r][c]) continue;
          parts.push("M" + (c + margin) + " " + (r + margin) + "h1v1h-1z");
        }
      }
      var path = document.createElementNS(SVG_NS, "path");
      path.setAttribute("d", parts.join(""));
      path.setAttribute("fill", fg);
      path.setAttribute("shape-rendering", "crispEdges");
      svg.appendChild(path);

      svg.setAttribute("xmlns", SVG_NS);
      svg.setAttribute("viewBox", "0 0 " + span + " " + span);
      svg.setAttribute("width", String(span * 8));
      svg.setAttribute("height", String(span * 8));
      svg.setAttribute("role", "img");
      svg.setAttribute("aria-label", title.textContent);
      svg.setAttribute(
        "aria-describedby",
        "qg-fallback qg-preview-payload"
      );
    }

    function renderCanvas(canvas, matrix, margin, sizePx, fg, bg) {
      var size = matrix.length;
      var span = size + margin * 2;
      var scale = Math.max(1, Math.round(sizePx / span));
      var total = scale * span;

      canvas.width = total;
      canvas.height = total;

      var ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, total, total);
      ctx.fillStyle = fg;
      for (var r = 0; r < size; r++) {
        for (var c = 0; c < size; c++) {
          if (!matrix[r][c]) continue;
          ctx.fillRect((c + margin) * scale, (r + margin) * scale, scale, scale);
        }
      }
    }

    function paintStats(info) {
      element("qg-stat-version").textContent = info.version + " / 40";
      element("qg-stat-size").textContent = info.size + " × " + info.size;
      element("qg-stat-mask").textContent = String(info.mask);
      element("qg-stat-bytes").textContent = info.bytes.length + " bytes";
    }

    function clearCheck(kind, text) {
      var node = element("qg-check");
      node.textContent = text;
      node.classList.remove("qg__check--ok", "qg__check--bad");
      if (kind === "ok") node.classList.add("qg__check--ok");
      if (kind === "bad") node.classList.add("qg__check--bad");
    }

    function setStatPlaceholder() {
      element("qg-stat-version").textContent = "—";
      element("qg-stat-size").textContent = "—";
      element("qg-stat-mask").textContent = "—";
      element("qg-stat-bytes").textContent = "—";
    }

    function generate() {
      var status = element("qg-status");
      var payload = buildPayload();
      if (payload.error) {
        status.textContent = payload.error;
        return;
      }

      var levelName = element("qg-ec").value;
      var levelIndex = LEVEL_INDEX[levelName];
      var bytes = toUtf8(payload.text);
      var version = chooseVersion(bytes.length, levelIndex);

      if (version === -1) {
        var maxBytes = dataCapacityBytes(40, levelIndex) - (40 < 10 ? 2 : 3);
        status.textContent =
          "That payload is " +
          bytes.length +
          " bytes, which is more than version 40 can hold at level " +
          levelName +
          " (about " +
          maxBytes +
          " bytes). Shorten the content or choose a lower error-correction level.";
        clearCheck("bad", "Self-check: not run — no symbol was produced.");
        setStatPlaceholder();
        return;
      }

      var info;
      try {
        info = buildMatrix(bytes, version, levelName, levelIndex);
      } catch (err) {
        status.textContent =
          "The encoder stopped: " + (err && err.message ? err.message : "unknown error") + ".";
        clearCheck("bad", "Self-check: not run — encoding failed.");
        setStatPlaceholder();
        return;
      }

      info.level = levelName;
      info.bytes = bytes;
      last = info;

      var fg = safeColor(element("qg-fg").value, "#000000");
      var bg = safeColor(element("qg-bg").value, "#ffffff");
      var margin = Math.round(clampNumber(element("qg-margin").value, 0, 8, 4));
      var sizePx = Math.round(clampNumber(element("qg-size").value, 128, 1024, 320));

      var wrap = element("qg-canvas-wrap");
      var canvas = element("qg-canvas");
      var svg = document.getElementById("qg-svg");
      if (!svg) {
        svg = document.createElementNS(SVG_NS, "svg");
        svg.id = "qg-svg";
        wrap.insertBefore(svg, element("qg-fallback"));
      }

      renderSvg(svg, info.grid, margin, fg, bg);
      renderCanvas(canvas, info.grid, margin, sizePx, fg, bg);

      var label =
        "QR code representing the payload in the field below. Version " +
        info.version +
        ", " +
        info.size +
        " by " +
        info.size +
        " modules, error-correction level " +
        info.level +
        ", mask " +
        info.mask +
        ".";
      canvas.setAttribute("aria-label", label);

      wrap.classList.remove("qg__canvas-wrap--painted");
      element("qg-fallback").textContent = label;

      var preview = element("qg-preview-payload");
      preview.value = payload.text;

      paintStats(info);

      status.textContent =
        "Generated a version " +
        info.version +
        " symbol (" +
        info.size +
        " × " +
        info.size +
        " modules, mask " +
        info.mask +
        ", level " +
        info.level +
        ", " +
        bytes.length +
        " payload bytes).";

      element("qg-download-png").disabled = false;
      element("qg-download-svg").disabled = false;

      // Read the format information back out of our own finished matrix.
      var check = readFormat(info.grid);
      if (check.level === levelName && check.mask === info.mask && check.copiesAgree) {
        clearCheck(
          "ok",
          "Self-check passed — the format information decoded from the matrix reads level " +
            check.level +
            " and mask " +
            check.mask +
            ", matching the intent, and both copies agree."
        );
      } else {
        clearCheck(
          "bad",
          "Self-check FAILED — the matrix decodes as level " +
            (check.level || "unknown") +
            " and mask " +
            check.mask +
            ", but level " +
            levelName +
            " and mask " +
            info.mask +
            " were intended. Do not use this code."
        );
      }
    }

    /* ------------------------------------------------------------------ *
     * Downloads.
     * ------------------------------------------------------------------ */

    function saveBlob(blob, filename) {
      var url = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = url;
      link.download = filename;
      link.rel = "noopener";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.setTimeout(function () {
        URL.revokeObjectURL(url);
      }, 4000);
    }

    function downloadPng() {
      if (!last) return;
      var canvas = element("qg-canvas");
      var name = "qr-code-v" + last.version + ".png";
      var status = element("qg-status");
      if (canvas.toBlob) {
        canvas.toBlob(function (blob) {
          if (blob) {
            saveBlob(blob, name);
            status.textContent = "Downloaded " + name + ".";
          } else {
            status.textContent = "The browser could not encode the PNG. Try the SVG download instead.";
          }
        }, "image/png");
      } else {
        status.textContent = "This browser cannot export a PNG here. Use the SVG download instead.";
      }
    }

    function downloadSvg() {
      if (!last) return;
      var svg = document.getElementById("qg-svg");
      if (!svg) return;
      var source = new XMLSerializer().serializeToString(svg);
      if (source.indexOf("xmlns=") === -1) {
        source = source.replace("<svg", '<svg xmlns="' + SVG_NS + '"');
      }
      var blob = new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + source], {
        type: "image/svg+xml;charset=utf-8",
      });
      var name = "qr-code-v" + last.version + ".svg";
      saveBlob(blob, name);
      element("qg-status").textContent = "Downloaded " + name + ".";
    }

    /* ------------------------------------------------------------------ *
     * Wiring.
     * ------------------------------------------------------------------ */

    function syncGroups() {
      var mode = currentMode();
      var groups = document.querySelectorAll("[data-qg-group]");
      for (var i = 0; i < groups.length; i++) {
        var group = groups[i];
        var on = group.getAttribute("data-qg-group") === mode;
        if (on) group.removeAttribute("hidden");
        else group.setAttribute("hidden", "");
      }
    }

    function markStale() {
      element("qg-status").textContent = "Input changed — press Generate QR code to refresh the symbol.";
    }

    function init() {
      syncGroups();

      element("qg-mode").addEventListener("change", function () {
        syncGroups();
        markStale();
      });
      element("qg-generate").addEventListener("click", generate);
      element("qg-download-png").addEventListener("click", downloadPng);
      element("qg-download-svg").addEventListener("click", downloadSvg);

      var controls = ["qg-ec", "qg-size", "qg-margin", "qg-fg", "qg-bg"];
      for (var i = 0; i < controls.length; i++) {
        element(controls[i]).addEventListener("change", generate);
      }

      var fields = document.querySelectorAll(".qg input, .qg textarea, .qg select");
      for (var j = 0; j < fields.length; j++) {
        if (fields[j].id === "qg-preview-payload") continue;
        fields[j].addEventListener("input", markStale);
      }

      generate();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
