---
import Icon from "./Icon.astro";
import { categories, legacyTools, urlOf } from "../data/tools";

const year = new Date().getFullYear();

const quick = legacyTools.slice(0, 5);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true"><Icon name="grid" size={17} /></span>
          <span class="brand__name">Tools<b>.ly</b></span>
        </a>
        <p style="margin-top:0.85rem;max-width:34ch;color:var(--text-muted)">
          Free browser-based tools. Everything runs on your device — nothing to install,
          nothing uploaded.
        </p>
      </div>

      <div>
        <h2>Popular tools</h2>
        <ul>
          {
            quick.map((t) => (
              <li><a href={urlOf(t)}>{t.nav ?? t.title}</a></li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Categories</h2>
        <ul>
          {
            categories.slice(0, 6).map((c) => (
              <li><a href={`/all-tools/#${c.id}`}>{c.label}</a></li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Site</h2>
        <ul>
          <li><a href="/all-tools/">All tools</a></li>
          <li><a href="/7b3c2-blog-archive/">Blog</a></li>
          <li><a href="/7b3c2-about/">About</a></li>
          <li><a href="/7b3c2-contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Tools.ly — all tools are free to use.</span>
      <span>Built with static HTML. No trackers, no accounts, no uploads.</span>
    </div>
  </div>
</footer>
