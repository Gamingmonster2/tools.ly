---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { arTools, arUrlOf, arLiveCount } from "../../data/arTools";
import { SITE } from "../../data/site";

// الأدوات العربية الجاهزة، مرتبة كما وردت في السجل، وتُعرض في القائمة الجانبية.
const liveTools = arTools.filter((tool) => tool.status === "live");
const soonCount = arTools.length - arLiveCount;

const pageUrl = "https://tools.ly/ar/عن-الموقع/";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: `عن ${SITE.name}`,
    url: pageUrl,
    inLanguage: "ar",
    description: `من نحن، وكيف تعمل أدوات ${SITE.name} داخل المتصفح، وما لا نفعله: بلا حسابات، بلا رفع ملفات، وبلا بيع بيانات.`,
    mainEntity: {
      "@type": "Organization",
      name: SITE.name,
      url: "https://tools.ly/",
      description: `${SITE.teamFull}: نسخة عربية مجانية من ${SITE.name} بأدوات تعمل داخل المتصفح وحده.`,
      publishingPrinciples: pageUrl,
    },
    isPartOf: {
      "@type": "WebSite",
      name: "أدوات Tools.ly العربية",
      url: "https://tools.ly/ar/",
      inLanguage: "ar",
    },
  },
];
---

<Base
  title="عن الموقع"
  description={`عن ${SITE.name}: النسخة العربية المجانية، ولماذا هي نسخة منفصلة لا ترجمة، وكيف تعمل الأدوات داخل متصفحك، وما لا نفعله ببياناتك.`}
  canonical="/ar/عن-الموقع/"
  locale="ar"
  jsonLd={jsonLd}
>
  <div class="container">
    <div class="page-head" style="padding-top:2rem">
      <p class="eyebrow">عن الموقع</p>
      <h1>أدوات عربية بُنيت للعربية، لا مترجمة إليها</h1>
      <p class="lede">
        {SITE.name} مجموعة أدوات مجانية تعمل داخل متصفحك وحده. وهذه الصفحة تشرح من يقف خلف النسخة
        العربية، ولماذا نشأت منفصلة عن الموقع الإنجليزي، وكيف تُحسب نتائجها، وما لا نفعله ببياناتك.
      </p>
    </div>
  </div>

  <div class="container section">
    <div class="tool-layout tool-layout--aside">
      <div class="prose">
        <h2>من نحن</h2>
        <p>
          هذه هي النسخة العربية المجانية من <strong>{SITE.name}</strong>، وهي مجموعة أدوات يومية
          للقارئ العربي: عدّ للنصوص، وتحويل للتواريخ، وحاسبات للأرقام، وأدوات للملفات والخطوط. لا
          رسوم ولا اشتراك ولا نسخة «مدفوعة» تُخفي عنك نصف الموقع؛ كل ما تراه هنا متاح بالكامل،
          ويُفتح في أي متصفح حديث على الحاسوب أو الهاتف.
        </p>
        <p>
          بدأت الفكرة من ملاحظة بسيطة: أكثر ما يحتاجه العربي في أدواته اليومية لا وجود له في المواقع
          الإنجليزية أصلاً. التقويم الهجري، وتشكيل النص العربي وإزالته، والأرقام الهندية، ومعاينة
          الخطوط العربية — كلها حاجات لا يجدها في قائمة أدوات مكتوبة للإنجليزية.
        </p>

        <h2>لماذا نسخة عربية منفصلة</h2>
        <p>
          لأن هذه الصفحة العربية <strong>ليست ترجمة</strong> للموقع الإنجليزي، ولا نسخة مصغّرة عنه.
          الترجمة تنقل النص نفسه إلى لغة أخرى، أما هنا فالمنطق معكوس: نبدأ من الحاجة العربية، ثم
          نبني الأداة التي تخدمها. ولهذا تحمل هذه النسخة أدوات لا مقابل إنجليزي لها على الإطلاق،
          وعلى رأسها محوّل التقويم الهجري وأدوات النصوص العربية؛ فليست هناك صفحة إنجليزية تقوم
          بالمهمة نفسها، ولا معنى لاختلاق واحدة.
        </p>
        <p>
          والنتيجة العملية أن النسختين تنموان <strong>بشكل مستقل</strong>. فقد تُضاف أداة عربية لا
          نظير لها في الإنجليزية، وقد تُضاف أداة إنجليزية لا تحتاجها النسخة العربية. ولكل صفحة عنوان
          دائم خاص بها، فلا يتحوّل رابط إلى رابط آخر لمجرد أن النسخة الأخرى تغيّرت. وحين توجد أداة
          بمقابل حقيقي في اللغتين — لا تشابه في الاسم فقط — نُعلن ذلك صراحةً في رأس الصفحة عبر
          <code>hreflang</code>، وحين لا يوجد لا نخترع إشارة زائفة.
        </p>

        <h2>كيف تعمل الأدوات</h2>
        <p>
          كل أداة هنا صفحة ثابتة واحدة: HTML وCSS وجافاسكربت تُنزَّل مرة واحدة، ثم يجري العمل كله
          بعدها <strong>داخل متصفحك</strong>. لا خادم يحسب النتيجة نيابة عنك، ولا قاعدة بيانات
          تخزّن ما تكتبه، ولا سجلّ يحتفظ بالنصوص التي ألصقتها. تغلق التبويب فيزول كل شيء، إلا ما
          حفظه متصفحك أنت بإرادتك.
        </p>
        <p>
          ولأن الحساب يجري في الجهاز نفسه، فإن النتيجة تظهر في اللحظة التي تكتب فيها، وتظل الأداة
          تعمل حتى لو انقطع الاتصال بعد فتح الصفحة. وحين تتعامل أداة مع ملف، كما في ضغط الصور،
          فإنها تقرأه وتعالجه في الصفحة وتُهمله عند الإغلاق؛ لا يخرج الملف من جهازك في أي لحظة.
        </p>

        <h2>ما لا نفعله</h2>
        <ul>
          <li>
            <strong>لا حسابات:</strong> لا تسجيل، ولا كلمة مرور، ولا رسالة تحقّق على بريدك؛ لا
            نطلب بريدك أصلاً لتستخدم أي أداة.
          </li>
          <li>
            <strong>لا رفع ملفات:</strong> لا تُرسل صورك ولا مستنداتك ولا نصوصك إلى أي خادم، لأن
            المعالجة تجري في متصفحك.
          </li>
          <li>
            <strong>لا بيع بيانات:</strong> لا نبيع شيئاً لأننا لا نجمع شيئاً؛ لا متتبّعات إعلانية
            ولا أدوات تحليل ولا ملفات تعريف ارتباط تخصّك.
          </li>
          <li>
            <strong>لا حجب أي أداة خلف تسجيل دخول:</strong> لا زر «تابع بعد الاشتراك»، ولا نصف
            نتيجة يظهر ثم يُقفل. الأداة كاملة، أو لا تكون.
          </li>
        </ul>

        <h2>حدود أدوات الصحّة والتقويم</h2>
        <p>
          نُفضّل أن نكتب الحدود بوضوح بدلاً من أن نُخفيها. فمحوّل التقويم الهجري يعتمد
          <strong>تقويم أم القرى</strong>{"،"} وهو تقويم محسوب؛ وقد تختلف بداية الشهر الفعلية يوماً
          أو يومين عن نتيجته، لأن رؤية الهلال أو الإعلان الرسمي في بلدك هما الفيصل، لا الحساب. فإن
          كان التاريخ يتعلق بعبادة أو عقد أو موعد رسمي، فراجع الجهة المختصة في بلدك.
        </p>
        <p>
          وأدوات الصحّة — كتلك التي تقدّر الوزن أو السعرات أو الكتلة — تعطي
          <strong>تقديرات</strong> مبنية على معادلات منشورة، وقد لا تناسب حالتك الخاصة. هي
          للمعلومة لا للتشخيص، وليست نصيحة طبية ولا بديلاً عن طبيب أو أخصائي تغذية. القرار في صحتك
          يبقى لأهل الاختصاص، لا لصفحة على الإنترنت.
        </p>

        <h2>التوقيع الجماعي</h2>
        <p>
          لا يُنسب شيء في هذا الموقع إلى شخص بعينه. كل أداة وكل شرح وكل تحديث يُنشر باسم واحد
          جماعي: <strong>{SITE.team}</strong>، وهو {SITE.teamFull}. لا أسماء شخصية، ولا مؤلف
          مخترع، ولا صفحة تضع على غلافها صورة شخص لم يكتب السطر الذي تحته.
        </p>
        <p>
          وهذا ليس غياباً للمسؤولية، بل طريقة في عرضها: أن تُقاس الأداة بما تفعله، وما تكلفه لك،
          وهل تصحّ مصادرها — لا بمن وقّعها. وإذا اكتشفت خطأً في رقم أو تحويل أو صياغة،
          <a href="/ar/اتصل-بنا/">راسلنا</a> وسيُصحَّح على الصفحة نفسها.
        </p>

        <div class="callout" style="margin-top:2rem">
          <p>
            تريد أن ترى ما هو جاهز الآن؟ ابدأ من <a href="/ar/كل-الأدوات/">دليل الأدوات العربية</a>،
            أو جرّب <a href="/ar/عداد-الحروف/">عدّاد الحروف والكلمات</a> و
            <a href="/ar/التقويم-الهجري/">محوّل التقويم الهجري</a> مباشرةً.
          </p>
        </div>
      </div>

      <aside class="stack">
        <div class="card">
          <h2 style="font-size:1.05rem">بالأرقام</h2>
          <div class="stat-grid">
            <div class="stat">
              <div class="stat__label">متوفّرة الآن</div>
              <div class="stat__value">{arLiveCount}</div>
            </div>
            <div class="stat">
              <div class="stat__label">في الدليل</div>
              <div class="stat__value">{arTools.length}</div>
            </div>
            <div class="stat">
              <div class="stat__label">قيد الإنشاء</div>
              <div class="stat__value">{soonCount}</div>
            </div>
            <div class="stat">
              <div class="stat__label">ملفات مرفوعة</div>
              <div class="stat__value">0</div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2 style="font-size:1.05rem">أدوات عربية جاهزة</h2>
          <div class="related-list">
            {
              liveTools.map((tool) => (
                <a href={arUrlOf(tool)}>
                  <Icon name={tool.icon} size={16} />
                  {tool.nav ?? tool.title}
                </a>
              ))
            }
          </div>
          <p style="margin:0.9rem 0 0">
            <a class="btn btn--soft btn--sm btn--block" href="/ar/كل-الأدوات/">
              تصفّح كل الأدوات
            </a>
          </p>
        </div>

        <div class="card">
          <h2 style="font-size:1.05rem">هل وجدت خطأ؟</h2>
          <p style="margin:0;color:var(--text-muted);font-size:0.92rem">
            أخبرنا بالصفحة والقيمة التي أدخلتها، وأنت تساعد كل من سيأتي بعدك.
          </p>
          <p style="margin:0.75rem 0 0">
            <a class="btn btn--ghost btn--sm btn--block" href="/ar/اتصل-بنا/">اتصل بنا</a>
          </p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  /* عناوين البطاقات الجانبية: تصغير المسافة العليا فقط، دون المساس بعناوين المتن. */
  .tool-layout--aside :global(aside .card h2) {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .tool-layout--aside :global(aside .card) {
    padding: 1.1rem 1.2rem;
  }
</style>
