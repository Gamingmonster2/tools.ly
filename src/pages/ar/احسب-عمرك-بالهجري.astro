<script>
  /* ================================================================
     حاسبة العمر بالهجري — كل الحساب داخل المتصفح وحده.
     لا شبكة، لا مكتبات، لا تخزين. بيانات التقويم من أم القرى.
     ================================================================ */

  var ARABIC_DIGITS = "٠١٢٣٤٥٦٧٨٩";
  var DAY_MS = 86400000;
  var CALENDAR = "islamic-umalqura";

  var arabicDigits = function (value) {
    return String(value).replace(/[0-9]/g, function (digit) {
      return ARABIC_DIGITS[Number(digit)];
    });
  };

  /* تنسيق للعرض بالعربية، وتنسيق رقمي للقراءة والتحويل. */
  var hijriLong = new Intl.DateTimeFormat("ar-SA-u-ca-" + CALENDAR, {
    day: "numeric",
    month: "long",
    year: "numeric",
    weekday: "long"
  });
  var hijriMonthName = new Intl.DateTimeFormat("ar-SA-u-ca-" + CALENDAR, { month: "long" });
  var gregorianLong = new Intl.DateTimeFormat("ar-SA-u-ca-gregory", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });
  var hijriNumeric = new Intl.DateTimeFormat("en-US-u-ca-" + CALENDAR, {
    day: "numeric",
    month: "numeric",
    year: "numeric"
  });

  /* ---------- أدوات التاريخ: رقم يوم ثابت لا يتأثر بالتوقيت الصيفي ---------- */

  var dayNumberOf = function (date) {
    return Math.round(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_MS);
  };
  var dateOfDayNumber = function (number) {
    var utc = new Date(number * DAY_MS);
    return new Date(utc.getUTCFullYear(), utc.getUTCMonth(), utc.getUTCDate());
  };
  var todayDate = function () {
    var now = new Date();
    return new Date(now.getFullYear(), now.getMonth(), now.getDate());
  };
  var pad2 = function (value) {
    return String(value).padStart(2, "0");
  };
  var isoOf = function (date) {
    return date.getFullYear() + "-" + pad2(date.getMonth() + 1) + "-" + pad2(date.getDate());
  };
  var dateFromIso = function (value) {
    var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || "");
    if (!match) return null;
    var year = Number(match[1]);
    var month = Number(match[2]);
    var day = Number(match[3]);
    var date = new Date(year, month - 1, day);
    if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) return null;
    return date;
  };

  /* ---------- أم القرى: الثلاثية الهجرية <-> رقم اليوم الميلادي ---------- */

  var hijriOnDayNumber = function (number) {
    var parts = hijriNumeric.formatToParts(dateOfDayNumber(number));
    var year = 0;
    var month = 0;
    var day = 0;
    for (var i = 0; i < parts.length; i += 1) {
      if (parts[i].type === "year") year = Number(parts[i].value);
      else if (parts[i].type === "month") month = Number(parts[i].value);
      else if (parts[i].type === "day") day = Number(parts[i].value);
    }
    return { year: year, month: month, day: day };
  };

  /* Intl ينسّق ولا يحلّل، فالبحث عن يوم ميلادي مقابل لثلاثية هجرية يجري بحثاً ثنائياً. */
  var SEARCH_START = dayNumberOf(new Date(1937, 0, 1));
  var SEARCH_END = dayNumberOf(new Date(2077, 11, 31));

  var compareTriple = function (a, b) {
    return a.year - b.year || a.month - b.month || a.day - b.day;
  };

  var searchDay = function (year, month, day) {
    var target = { year: year, month: month, day: day };
    if (compareTriple(hijriOnDayNumber(SEARCH_START), target) > 0) return null;
    if (compareTriple(hijriOnDayNumber(SEARCH_END), target) < 0) return null;
    var low = SEARCH_START;
    var high = SEARCH_END;
    while (low < high) {
      var mid = low + Math.floor((high - low) / 2);
      if (compareTriple(hijriOnDayNumber(mid), target) < 0) low = mid + 1;
      else high = mid;
    }
    return compareTriple(hijriOnDayNumber(low), target) === 0 ? low : null;
  };

  /* النطاق المعلن: من ١ محرم ١٣٥٦ هـ إلى آخر يوم من ذي الحجة ١٥٠٠ هـ. */
  var RANGE_FIRST = { year: 1356, month: 1, day: 1 };
  var AFTER_RANGE = searchDay(1501, 1, 1);
  var RANGE_LAST = hijriOnDayNumber(AFTER_RANGE === null ? SEARCH_END : AFTER_RANGE - 1);

  var inRange = function (triple) {
    return compareTriple(triple, RANGE_FIRST) >= 0 && compareTriple(triple, RANGE_LAST) <= 0;
  };

  var hijriToDayNumber = function (year, month, day) {
    var target = { year: year, month: month, day: day };
    if (!inRange(target)) return null;
    return searchDay(year, month, day);
  };

  var monthLength = function (year, month) {
    var first = searchDay(year, month, 1);
    if (first === null) return 30;
    var nextYear = month === 12 ? year + 1 : year;
    var nextMonth = month === 12 ? 1 : month + 1;
    var next = searchDay(nextYear, nextMonth, 1);
    return next === null ? 30 : next - first;
  };

  /* ---------- صياغة عربية سليمة للمعدود ---------- */

  var UNITS = {
    year: { one: "سنة واحدة", two: "سنتان", few: "سنوات", many: "سنة" },
    month: { one: "شهر واحد", two: "شهران", few: "أشهر", many: "شهراً" },
    day: { one: "يوم واحد", two: "يومان", few: "أيام", many: "يوماً" },
    week: { one: "أسبوع واحد", two: "أسبوعان", few: "أسابيع", many: "أسبوعاً" }
  };

  var unitPhrase = function (count, unit, format) {
    if (count === 1) return unit.one;
    if (count === 2) return unit.two;
    if (count >= 3 && count <= 10) return format(count) + " " + unit.few;
    return format(count) + " " + unit.many;
  };

  var joinParts = function (parts) {
    var kept = [];
    for (var i = 0; i < parts.length; i += 1) {
      if (parts[i].count > 0) kept.push(parts[i]);
    }
    if (!kept.length) return "أقل من يوم واحد";
    var words = [];
    for (var j = 0; j < kept.length; j += 1) {
      words.push(unitPhrase(kept[j].count, kept[j].unit, arabicDigits));
    }
    return words.join(" و");
  };

  /* ---------- العمر بالاقتراض، لا بقسمة مجموع الأيام ---------- */

  var hijriAgeBetween = function (from, to) {
    var years = to.year - from.year;
    var months = to.month - from.month;
    var days = to.day - from.day;
    if (days < 0) {
      months -= 1;
      var prevMonth = to.month === 1 ? 12 : to.month - 1;
      var prevYear = to.month === 1 ? to.year - 1 : to.year;
      days += monthLength(prevYear, prevMonth);
    }
    if (months < 0) {
      years -= 1;
      months += 12;
    }
    return { years: years, months: months, days: days };
  };

  var gregorianAgeBetween = function (from, to) {
    var years = to.getFullYear() - from.getFullYear();
    var months = to.getMonth() - from.getMonth();
    var days = to.getDate() - from.getDate();
    if (days < 0) {
      months -= 1;
      var prevMonth = to.getMonth() === 0 ? 11 : to.getMonth() - 1;
      var prevYear = to.getMonth() === 0 ? to.getFullYear() - 1 : to.getFullYear();
      days += new Date(prevYear, prevMonth + 1, 0).getDate();
    }
    if (months < 0) {
      years -= 1;
      months += 12;
    }
    return { years: years, months: months, days: days };
  };

  /* عيد الميلاد الهجري القادم: الشهر واليوم نفسهما في السنة الهجرية التي لم يأتِ موعدهما فيها. */
  var nextHijriBirthday = function (birth, todayTriple, todayNumber) {
    for (var step = 0; step <= 2; step += 1) {
      var year = todayTriple.year + step;
      var length = monthLength(year, birth.month);
      var day = Math.min(birth.day, length);
      var number = hijriToDayNumber(year, birth.month, day);
      if (number === null) continue;
      if (number >= todayNumber) {
        return { year: year, month: birth.month, day: day, dayNumber: number, daysLeft: number - todayNumber };
      }
    }
    return null;
  };

  /* ---------- عناصر الصفحة ---------- */

  var byId = function (id) {
    return document.getElementById(id);
  };
  var el = {
    born: byId("ha-born"),
    until: byId("ha-until"),
    today: byId("ha-today"),
    alert: byId("ha-alert"),
    alertText: byId("ha-alert-text"),
    answer: byId("ha-answer"),
    bornNote: byId("ha-born-note"),
    yearsHij: byId("ha-years-hij"),
    yearsHijSub: byId("ha-years-hij-sub"),
    monthsHij: byId("ha-months-hij"),
    monthsHijSub: byId("ha-months-hij-sub"),
    daysHij: byId("ha-days-hij"),
    daysHijSub: byId("ha-days-hij-sub"),
    gregAge: byId("ha-greg-age"),
    gregAgeSub: byId("ha-greg-age-sub"),
    daysGreg: byId("ha-days-greg"),
    daysGregSub: byId("ha-days-greg-sub"),
    nextHij: byId("ha-next-hij"),
    nextHijSub: byId("ha-next-hij-sub")
  };

  var setAlert = function (message) {
    if (!message) {
      el.alertText.textContent = "";
      el.alert.hidden = true;
      return;
    }
    el.alertText.textContent = message;
    el.alert.hidden = false;
  };

  var setAnswer = function (text, state) {
    el.answer.textContent = text;
    el.answer.dataset.state = state;
  };

  var setStat = function (valueNode, subNode, value, sub) {
    valueNode.textContent = value;
    subNode.textContent = sub || "";
  };

  var setHijriStats = function (value, sub) {
    setStat(el.yearsHij, el.yearsHijSub, value, sub);
    setStat(el.monthsHij, el.monthsHijSub, value, sub);
    setStat(el.daysHij, el.daysHijSub, value, sub);
    setStat(el.nextHij, el.nextHijSub, value, sub);
  };

  var OUT_OF_RANGE_TEXT = "خارج النطاق";

  /* ---------- الحساب الرئيسي ---------- */

  var update = function () {
    setAlert("");

    var today = todayDate();
    var bornDate = dateFromIso(el.born.value);
    var untilDate = dateFromIso(el.until.value) || today;

    if (!bornDate) {
      setAnswer("اكتب تاريخ ميلادك بالأعلى، وسيظهر عمرك بالتقويم الهجري في هذه المساحة مباشرة.", "muted");
      el.bornNote.textContent = "";
      setHijriStats("—", "");
      setStat(el.gregAge, el.gregAgeSub, "—", "");
      setStat(el.daysGreg, el.daysGregSub, "—", "");
      return;
    }

    if (bornDate.getTime() > today.getTime()) {
      setAlert("تاريخ الميلاد لا يمكن أن يكون في المستقبل.");
      setAnswer("تحقّق من تاريخ الميلاد: هذا التاريخ لم يأتِ بعد.", "muted");
      el.bornNote.textContent = "";
      setHijriStats("—", "");
      setStat(el.gregAge, el.gregAgeSub, "—", "");
      setStat(el.daysGreg, el.daysGregSub, "—", "");
      return;
    }

    if (untilDate.getTime() < bornDate.getTime()) {
      setAlert("تاريخ «احسب العمر حتى تاريخ» يسبق تاريخ الميلاد؛ اختر تاريخاً لاحقاً ليوم ميلادك.");
      setAnswer("لا يمكن حساب عمر قبل تاريخ الميلاد.", "muted");
      el.bornNote.textContent = "";
      setHijriStats("—", "");
      setStat(el.gregAge, el.gregAgeSub, "—", "");
      setStat(el.daysGreg, el.daysGregSub, "—", "");
      return;
    }

    var bornNumber = dayNumberOf(bornDate);
    var untilNumber = dayNumberOf(untilDate);
    var totalDays = untilNumber - bornNumber;
    var bornHijri = hijriOnDayNumber(bornNumber);
    var untilHijri = hijriOnDayNumber(untilNumber);

    el.bornNote.textContent = "تاريخ ميلادك هجرياً: " + hijriLong.format(bornDate) + " — والتاريخ الذي يُحسب إليه: " +
      hijriLong.format(untilDate) + ".";

    /* العمر الميلادي: مستقل عن التقويم الهجري، ويبقى صحيحاً في كل الحالات. */
    var gAge = gregorianAgeBetween(bornDate, untilDate);
    setStat(
      el.gregAge,
      el.gregAgeSub,
      joinParts([
        { count: gAge.years, unit: UNITS.year },
        { count: gAge.months, unit: UNITS.month },
        { count: gAge.days, unit: UNITS.day }
      ]),
      "محسوباً بالتقويم الميلادي من تاريخ الميلاد إلى تاريخ الحساب."
    );

    var weeks = Math.floor(totalDays / 7);
    var restDays = totalDays % 7;
    var weekText = "";
    if (totalDays === 0) weekText = "لم يمضِ يوم كامل بعد.";
    else if (weeks === 0) weekText = "أقل من أسبوع.";
    else {
      weekText = "ما يعادل " + unitPhrase(weeks, UNITS.week, arabicDigits) +
        (restDays > 0 ? " و" + unitPhrase(restDays, UNITS.day, arabicDigits) : "") + ".";
    }
    setStat(el.daysGreg, el.daysGregSub, arabicDigits(totalDays) + " يوماً", weekText);

    var hijriOk = inRange(bornHijri) && inRange(untilHijri);

    if (!hijriOk) {
      setAnswer("بيانات تقويم أم القرى في متصفحك لا تغطي هذا التاريخ، فلا نعرض عمراً هجرياً يمكن أن يكون مضلِّلاً.", "muted");
      setHijriStats(OUT_OF_RANGE_TEXT, "خارج نطاق بيانات أم القرى (١٣٥٦–١٥٠٠ هـ).");
      setStat(el.daysHij, el.daysHijSub, arabicDigits(totalDays) + " يوماً", "مجموع الأيام الفعلي بين التاريخين.");
      setAlert(
        "أحد التاريخين خارج نطاق تقويم أم القرى المدمج في متصفحك، وهو يغطي نحو ١٣٥٦–١٥٠٠ هـ (١٩٣٧–٢٠٧٧ م). " +
        "قد يختلف الحساب الهجري خارج هذا النطاق بيوم أو أكثر، ولهذا نكتفي بالعمر الميلادي وإجمالي الأيام."
      );
      return;
    }

    var age = hijriAgeBetween(bornHijri, untilHijri);
    var monthLen = monthLength(untilHijri.year, untilHijri.month);
    var totalMonths = age.years * 12 + age.months;
    var decimalYears = age.years + age.months / 12 + age.days / monthLen;
    var breakdown = joinParts([
      { count: age.years, unit: UNITS.year },
      { count: age.months, unit: UNITS.month },
      { count: age.days, unit: UNITS.day }
    ]);

    if (totalDays === 0) {
      setAnswer("عمرك صفر بالتقويم الهجري؛ فتاريخ ميلادك هو نفسه التاريخ الذي يُحسب إليه.", "ok");
    } else {
      setAnswer("عمرك " + breakdown + " بالتقويم الهجري", "ok");
    }

    setStat(
      el.yearsHij,
      el.yearsHijSub,
      age.years === 0 ? "أقل من سنة" : arabicDigits(decimalYears.toFixed(1).replace(".", "٫")) + " سنة",
      breakdown + " بالتقويم الهجري."
    );

    setStat(
      el.monthsHij,
      el.monthsHijSub,
      totalMonths === 0 ? "أقل من شهر" : unitPhrase(totalMonths, UNITS.month, arabicDigits),
      age.days > 0 ? "و" + unitPhrase(age.days, UNITS.day, arabicDigits) + " فوقها." : "بالضبط."
    );

    setStat(
      el.daysHij,
      el.daysHijSub,
      arabicDigits(totalDays) + " يوماً",
      "مجموع الأيام الفعلي بين تاريخ الميلاد وتاريخ الحساب؛ واليوم مقياس واحد في التقويمين."
    );

    var next = nextHijriBirthday(bornHijri, untilHijri, untilNumber);
    if (next === null) {
      setStat(el.nextHij, el.nextHijSub, OUT_OF_RANGE_TEXT, "بيانات متصفحك لا تغطي السنة الهجرية القادمة.");
    } else {
      var nextDate = dateOfDayNumber(next.dayNumber);
      var nextLabel = arabicDigits(next.day) + " " + hijriMonthName.format(nextDate) + " " +
        arabicDigits(next.year) + " هـ";
      var leftText = next.daysLeft === 0
        ? "عيد ميلادك الهجري اليوم."
        : "بقي " + unitPhrase(next.daysLeft, UNITS.day, arabicDigits);
      setStat(
        el.nextHij,
        el.nextHijSub,
        nextLabel,
        "الموافق " + gregorianLong.format(nextDate) + " م — " + leftText
      );
    }
  };

  /* ---------- التهيئة ---------- */

  var init = function () {
    var today = todayDate();
    var todayIso = isoOf(today);
    el.until.value = todayIso;
    el.born.max = todayIso;

    el.born.addEventListener("input", update);
    el.born.addEventListener("change", update);
    el.until.addEventListener("input", update);
    el.until.addEventListener("change", update);

    el.today.addEventListener("click", function () {
      var now = todayDate();
      var nowIso = isoOf(now);
      el.until.value = nowIso;
      el.born.max = nowIso;
      update();
    });

    update();
  };

  init();
</script>
