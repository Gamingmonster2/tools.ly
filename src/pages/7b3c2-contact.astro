---
import Base from "../layouts/Base.astro";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact Tools.ly",
    url: "https://tools.ly/7b3c2-contact/",
    description: "Report a bug, suggest a tool or ask a question about Tools.ly.",
  },
];

// Change this one constant when the mailbox changes.
const CONTACT_EMAIL = "sales@tools.ly";
---

<Base
  title="Contact"
  description="Report a bug, suggest a new tool or ask a question. Tell us which tool page you mean and we will look at it."
  canonical="/7b3c2-contact/"
  jsonLd={jsonLd}
>
  <div class="container">
    <div class="page-head" style="padding-top:2rem">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">
        Bug reports, correction requests, tool ideas and questions are all welcome. The more
        specific you are — which tool, which device, what you expected — the faster it can be fixed.
      </p>
    </div>
  </div>

  <div class="container section">
    <div class="tool-layout tool-layout--aside">
      <div>
        <form class="card" id="contact-form" novalidate>
          <div class="field-grid">
            <div class="field">
              <label for="cf-name">Your name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="cf-email">Your email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="field" style="margin-top:1rem">
            <label for="cf-topic">What is this about?</label>
            <select id="cf-topic" name="topic">
              <option>Report a bug</option>
              <option>Report wrong information</option>
              <option>Suggest a new tool</option>
              <option>Accessibility or layout problem</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field" style="margin-top:1rem">
            <label for="cf-tool">Which tool page? (optional)</label>
            <input
              id="cf-tool"
              name="tool"
              type="text"
              placeholder="Paste the page address, or leave blank"
            />
          </div>

          <div class="field" style="margin-top:1rem">
            <label for="cf-message">Your message</label>
            <textarea id="cf-message" name="message" rows="7" required
              placeholder="What happened, what you expected, and your browser/device if relevant."></textarea>
          </div>

          <div class="check" style="margin-top:1rem">
            <input id="cf-copy" type="checkbox" checked />
            <label for="cf-copy">Also copy the message to my clipboard</label>
          </div>

          <div style="margin-top:1.25rem;display:flex;gap:0.6rem;flex-wrap:wrap">
            <button class="btn btn--primary" type="submit">Open my email app</button>
            <button class="btn btn--ghost" type="button" id="cf-copy-btn">Copy message</button>
          </div>

          <p class="callout" style="margin-top:1.25rem" id="cf-status" role="status" aria-live="polite">
            This site is static, so there is no form server to receive your message. The button
            below opens your own email application with everything filled in. Nothing is sent
            anywhere until <em>you</em> press send there.
          </p>
        </form>
      </div>

      <aside class="stack">
        <div class="card">
          <h2 style="font-size:1.05rem">Direct email</h2>
          <p style="color:var(--text-muted);font-size:0.92rem;margin-bottom:0.5rem">
            Prefer to write your own message? Use this address.
          </p>
          <p class="result-box" style="font-size:0.9rem">
            <a href={`mailto:${CONTACT_EMAIL}`} style="color:inherit">{CONTACT_EMAIL}</a>
          </p>
        </div>

        <div class="card">
          <h2 style="font-size:1.05rem">Before you write</h2>
          <ul style="margin:0;padding-inline-start:1.1rem;color:var(--text-muted);font-size:0.9rem">
            <li>Include the exact page address of the tool.</li>
            <li>Say which browser and device you used.</li>
            <li>For number problems, include the values you entered.</li>
          </ul>
        </div>

        <div class="card">
          <h2 style="font-size:1.05rem">Response time</h2>
          <p style="margin:0;color:var(--text-muted);font-size:0.9rem">
            This is an independent project, so replies are not instant — but every message is read.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <script define:vars={{ CONTACT_EMAIL }}>
    const form = document.getElementById("contact-form");
    const status = document.getElementById("cf-status");
    const copyCheck = document.getElementById("cf-copy");

    const buildBody = () => {
      const name = document.getElementById("cf-name").value.trim();
      const email = document.getElementById("cf-email").value.trim();
      const topic = document.getElementById("cf-topic").value;
      const tool = document.getElementById("cf-tool").value.trim();
      const message = document.getElementById("cf-message").value.trim();
      return [
        `Topic: ${topic}`,
        tool ? `Tool page: ${tool}` : null,
        "",
        message,
        "",
        `— ${name}${email ? ` (${email})` : ""}`,
        `Sent from: ${location.href}`,
      ]
        .filter((line) => line !== null)
        .join("\n");
    };

    const say = (text, ok = true) => {
      status.textContent = text;
      status.className = ok ? "callout" : "callout callout--warn";
    };

    const copyText = async (text) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand("copy");
        area.remove();
        return ok;
      }
    };

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const name = document.getElementById("cf-name").value.trim();
      const email = document.getElementById("cf-email").value.trim();
      const message = document.getElementById("cf-message").value.trim();

      if (!name || !email || !message) {
        say("Please fill in your name, your email and the message.", false);
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        say("That email address does not look valid — please check it.", false);
        return;
      }

      if (copyCheck?.checked) {
        void copyText(buildBody());
      }

      const subject = encodeURIComponent(
        `[Tools.ly] ${document.getElementById("cf-topic").value}`
      );
      const body = encodeURIComponent(buildBody());
      window.location.href = `mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`;
      say("Your email application should open now. Nothing has been sent yet.");
    });

    document.getElementById("cf-copy-btn")?.addEventListener("click", async () => {
      const ok = await copyText(buildBody());
      say(ok ? "Message copied to your clipboard." : "Could not copy — please select the text manually.", ok);
    });
  </script>
</Base>
