---
import ToolLayout from "../layouts/ToolLayout.astro";
import { legacyTools } from "../data/tools";
import { foods, foodGroups } from "../data/mediterranean-foods";

const tool = legacyTools.find((t) => t.slug === "506-2")!;

const faqs = [
  {
    q: "Is this the same as a calorie counting app?",
    a: "No — it is a quick estimator, not a food diary. You choose how many servings of typical Mediterranean foods you ate and it adds up the energy and macronutrients. It does not remember days, track weight or sync anywhere, and because the values are averages for a food rather than a specific product, treat the total as a rough figure.",
  },
  {
    q: "Why are the calorie values only approximate?",
    a: "Two reasons. First, the numbers are database averages: the same dish cooked at home, in a restaurant and from a packet can differ by 20 % or more, mostly because of the oil used. Second, portion sizes are guesses until you weigh food. If you need accuracy — for a medical condition or a competition — weigh your portions and use a scale with a proper food database.",
  },
  {
    q: "How much olive oil does this assume?",
    a: "The values are per tablespoon (about 13.5 g, roughly 119 kcal). Olive oil is the single easiest way to change the total here, because a generous drizzle can quietly be three or four tablespoons. If your total looks high, check the oil quantity first.",
  },
  {
    q: "What daily calorie figure should I compare the total against?",
    a: "The 2,000 kcal reference line is a general label value, not a personal target. Real needs depend on body size, age, sex and activity level. If you want a figure closer to your own, use the body composition or ideal weight tools and treat the Mediterranean total as a way to see roughly where the day landed.",
  },
];

const sources = [
  {
    label: "USDA FoodData Central",
    href: "https://fdc.nal.usda.gov/",
    note: "the public database behind the per-serving energy and macronutrient values used here",
  },
  {
    label: "WHO — Healthy diet fact sheet",
    href: "https://www.who.int/news-room/fact-sheets/detail/healthy-diet",
    note: "reference intake ranges for fat, carbohydrate and fibre",
  },
  {
    label: "Mediterranean diet and health (PREDIMED trial, NEJM)",
    href: "https://www.nejm.org/doi/full/10.1056/NEJMoa1800389",
    note: "the large long-term trial usually cited when the Mediterranean pattern is recommended",
  },
];

const jsonLdExtra = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<ToolLayout
  tool={tool}
  intro="Choose how many servings of typical Mediterranean foods you ate and see the energy and macronutrients add up as you go. Everything is calculated in your browser."
  faqs={faqs}
  sources={sources}
  notice="Estimates only. These values are database averages and cannot know your portion sizes, cooking oil or medical history. This is not medical or dietary advice."
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div
          class="mc-totals"
          aria-live="polite"
          aria-atomic="true"
        >
          <div class="stat">
            <div class="stat__label">Total energy</div>
            <div class="stat__value"><span id="total-kcal">0</span> <small>kcal</small></div>
          </div>
          <div class="stat">
            <div class="stat__label">Protein</div>
            <div class="stat__value"><span id="total-protein">0</span> <small>g</small></div>
          </div>
          <div class="stat">
            <div class="stat__label">Carbohydrate</div>
            <div class="stat__value"><span id="total-carbs">0</span> <small>g</small></div>
          </div>
          <div class="stat">
            <div class="stat__label">Fat</div>
            <div class="stat__value"><span id="total-fat">0</span> <small>g</small></div>
          </div>
        </div>

        <div class="mc-bar" role="img" aria-labelledby="mc-bar-label">
          <div class="mc-bar__fill" id="mc-bar-fill" style="width:0%"></div>
        </div>
        <p class="mc-bar__label" id="mc-bar-label">
          <span id="mc-bar-text">0 % of a 2,000 kcal reference day</span>
          <span class="mc-hint">2,000 kcal is a general label value, not a personal target.</span>
        </p>

        <div class="mc-actions">
          <label class="field" style="max-width:220px">
            <span class="label">Quick start</span>
            <select id="mc-preset">
              <option value="">Choose a preset…</option>
              <option value="typical">Typical Mediterranean day</option>
              <option value="light">Light day</option>
              <option value="generous">Generous day</option>
            </select>
          </label>
          <button class="btn btn--ghost" type="button" id="mc-reset">Reset all quantities</button>
          <button class="btn btn--soft" type="button" id="mc-copy">Copy summary</button>
        </div>

        <div class="mc-groups">
          {
            foodGroups.map((group) => {
              const items = foods.filter((f) => f.group === group.id);
              if (items.length === 0) return null;
              return (
                <section class="mc-group">
                  <h3 class="mc-group__title">{group.label}</h3>
                  <ul class="mc-list">
                    {items.map((food) => (
                      <li
                        class="mc-row"
                        data-food={food.id}
                        data-kcal={food.kcal}
                        data-protein={food.protein}
                        data-carbs={food.carbs}
                        data-fat={food.fat}
                      >
                        <span class="mc-row__name">
                          {food.name}
                          <small>{food.portion}</small>
                        </span>
                        <span
                          class="mc-qty"
                          role="group"
                          aria-label={`Servings of ${food.name}`}
                        >
                          <button
                            type="button"
                            class="mc-qty__btn"
                            data-step="-1"
                            aria-label={`Remove one serving of ${food.name}`}
                          >−</button>
                          <input
                            class="mc-qty__input"
                            type="number"
                            min="0"
                            max="30"
                            step="0.5"
                            value="0"
                            inputmode="decimal"
                            aria-label={`Number of servings of ${food.name}`}
                          />
                          <button
                            type="button"
                            class="mc-qty__btn"
                            data-step="1"
                            aria-label={`Add one serving of ${food.name}`}
                          >+</button>
                        </span>
                        <span class="mc-row__kcal readout" data-row-kcal>0 kcal</span>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })
          }
        </div>

        <p class="mc-status" id="mc-status" role="status" aria-live="polite"></p>
      </div>

      <div class="panel__foot">
        Values are per common serving, rounded from USDA FoodData Central averages. Press
        <kbd>+</kbd> / <kbd>−</kbd> or type a decimal quantity such as 1.5.
      </div>
    </div>
  </Fragment>

  <h2>How this tracker works</h2>
  <p>
    Mediterranean-style eating is less a set of rules than a pattern: plenty of vegetables, fruit,
    legumes and wholegrains; olive oil as the main added fat; fish and poultry more often than red
    meat; modest amounts of dairy; and small quantities of nuts, sweets and wine. The difficulty
    with that pattern is that it makes no attempt to control portions, so the same pattern can
    easily land at 1,600 kcal or 2,900 kcal depending mostly on how much oil, bread and cheese is
    involved.
  </p>
  <p>
    This page lets you pick the foods you actually ate, set a number of servings for each one, and
    watch the total energy, protein, carbohydrate and fat build up. Each food carries a value per
    common serving — a tablespoon of olive oil, a cup of cooked couscous, a medium tomato — taken
    from rounded USDA FoodData Central averages. The arithmetic happens entirely in your browser;
    no food list, quantity or total is transmitted anywhere.
  </p>

  <h2>Reading the totals honestly</h2>
  <p>
    There are three sources of error, and none of them can be fixed by a better calculator. The
    first is the food itself: the same dish cooked at home, at a restaurant and from a packet can
    differ by a fifth or more, and added oil is usually the reason. The second is the portion: a
    "cup" of pasta is far smaller than most people serve. The third is the day: a single day says
    very little — patterns over a week or more are what matter.
  </p>
  <p>
    The progress bar compares your total with a 2,000 kcal reference, which is the figure used on
    nutrition labels. It is a landmark, not a target. If you want a number closer to your own
    maintenance requirement, use the <a href="/506-2/">body composition tool</a> alongside this one,
    or the <a href="/find-your-perfect-fit-use-our-ideal-weight-calculator-to-know-your-healthy-weight-range/">ideal weight calculator</a>.
  </p>

  <h2>A quick way to sanity-check a day</h2>
  <ol>
    <li>Set the oil first. Two or three tablespoons is normal in this cuisine and immediately adds 240–360 kcal.</li>
    <li>Set the grains. Couscous, pasta, rice and bread are where most of the carbohydrate comes from.</li>
    <li>Add the protein: a palm-sized portion of fish, poultry or legumes.</li>
    <li>Add vegetables and fruit generously — they contribute volume and micronutrients for very few calories.</li>
    <li>Finish with nuts, sweets and drinks, then look at the fat figure before the calorie figure.</li>
  </ol>

  <h2>Where the numbers come from</h2>
  <p>
    Each entry is the rounded value for a stated portion from the USDA FoodData Central database,
    cross-checked against standard reference tables. Where a food naturally varies — grilled fish,
    feta, olive oil — the value reflects the most common version rather than the leanest one. Energy
    in kilocalories is reported as most people understand it: 1 kcal is what a nutrition label calls
    1 calorie.
  </p>
  <div class="callout callout--warn">
    <p>
      For a diagnosed condition such as diabetes, kidney disease, coeliac disease or an eating
      disorder, do not use an online estimator at all. Work with a registered dietitian who can see
      your bloods, your medications and your whole diet.
    </p>
  </div>
</ToolLayout>

<style>
  .mc-totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .mc-bar {
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .mc-bar__fill {
    height: 100%;
    background: var(--accent);
    transition: width 0.25s ease;
  }
  .mc-bar__fill[data-over="true"] {
    background: var(--warn);
  }

  .mc-bar__label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.5rem 0 1.25rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .mc-hint { color: var(--text-faint); font-size: 0.82rem; }

  .mc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .mc-actions .field { display: grid; gap: 0.3rem; }

  .mc-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .mc-group__title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }

  .mc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .mc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .mc-row[data-active="true"] {
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }

  .mc-row__name {
    display: block;
    font-size: 0.9rem;
    font-weight: 620;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .mc-row__name small {
    display: block;
    font-weight: 500;
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  .mc-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
  }
  .mc-qty__btn {
    width: 32px;
    height: 34px;
    border: 0;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
  }
  .mc-qty__btn:hover { background: var(--bg-sunken); color: var(--text); }
  .mc-qty__input {
    width: 52px;
    border: 0;
    border-inline: 1px solid var(--border);
    border-radius: 0;
    text-align: center;
    padding: 0.35rem 0.2rem;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .mc-qty__input:focus { box-shadow: none; outline: 2px solid var(--accent); outline-offset: -2px; }
  .mc-qty__input::-webkit-outer-spin-button,
  .mc-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .mc-row__kcal {
    min-width: 62px;
    text-align: right;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .mc-status { margin: 1.25rem 0 0; font-size: 0.88rem; color: var(--text-muted); }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }

  @media (max-width: 480px) {
    .mc-row { grid-template-columns: minmax(0, 1fr) auto; }
    .mc-row__kcal { grid-column: 1 / -1; text-align: left; }
  }
</style>

<script>
  const PRESETS: Record<string, Record<string, number>> = {
    typical: {
      "olive-oil": 2, couscous: 1, "ww-pasta": 0.5, bread: 2, "grilled-fish": 1.5,
      veg: 2, greens: 1, tomato: 1, fruit: 2, yogurt: 1, feta: 1, almonds: 1, lentils: 1,
    },
    light: {
      "olive-oil": 1, couscous: 0.5, bread: 1, "grilled-fish": 1, veg: 2, greens: 2,
      fruit: 2, yogurt: 1, "herbal-tea": 2,
    },
    generous: {
      "olive-oil": 4, couscous: 1.5, pizza: 1, bread: 3, salmon: 1.5, chicken: 1,
      veg: 2, fruit: 2, feta: 2, olives: 2, almonds: 1, walnuts: 1, baklava: 1, wine: 1,
    },
  };

  const rows = Array.from(document.querySelectorAll<HTMLLIElement>(".mc-row"));
  const outKcal = document.getElementById("total-kcal")!;
  const outProtein = document.getElementById("total-protein")!;
  const outCarbs = document.getElementById("total-carbs")!;
  const outFat = document.getElementById("total-fat")!;
  const barFill = document.getElementById("mc-bar-fill") as HTMLElement;
  const barText = document.getElementById("mc-bar-text")!;
  const status = document.getElementById("mc-status")!;
  const preset = document.getElementById("mc-preset") as HTMLSelectElement;
  const REFERENCE_KCAL = 2000;

  const round = (value: number, decimals = 1) => {
    const factor = 10 ** decimals;
    return Math.round(value * factor) / factor;
  };

  const setStatus = (text: string) => {
    status.textContent = text;
  };

  const recalc = () => {
    let kcal = 0;
    let protein = 0;
    let carbs = 0;
    let fat = 0;

    for (const row of rows) {
      const input = row.querySelector<HTMLInputElement>(".mc-qty__input");
      const output = row.querySelector<HTMLElement>("[data-row-kcal]");
      let qty = Number(input?.value ?? "0");
      if (!Number.isFinite(qty) || qty < 0) qty = 0;
      if (qty > 30) qty = 30;

      const rowKcal = Number(row.dataset.kcal ?? "0") * qty;
      kcal += rowKcal;
      protein += Number(row.dataset.protein ?? "0") * qty;
      carbs += Number(row.dataset.carbs ?? "0") * qty;
      fat += Number(row.dataset.fat ?? "0") * qty;

      if (output) output.textContent = `${Math.round(rowKcal)} kcal`;
      row.dataset.active = qty > 0 ? "true" : "false";
    }

    outKcal.textContent = Math.round(kcal).toLocaleString("en-GB");
    outProtein.textContent = String(round(protein));
    outCarbs.textContent = String(round(carbs));
    outFat.textContent = String(round(fat));

    const pct = (kcal / REFERENCE_KCAL) * 100;
    barFill.style.width = `${Math.min(100, pct)}%`;
    barFill.dataset.over = String(pct > 100);
    barText.textContent = `${Math.round(pct)} % of a 2,000 kcal reference day`;
  };

  const applyPreset = (name: string) => {
    const values = PRESETS[name] ?? {};
    for (const row of rows) {
      const input = row.querySelector<HTMLInputElement>(".mc-qty__input");
      if (!input) continue;
      input.value = String(values[row.dataset.food ?? ""] ?? 0);
    }
    recalc();
  };

  for (const row of rows) {
    const input = row.querySelector<HTMLInputElement>(".mc-qty__input");
    const calc = () => recalc();

    input?.addEventListener("input", () => {
      const qty = Number(input.value);
      if (Number.isFinite(qty)) {
        if (qty < 0) input.value = "0";
        if (qty > 30) input.value = "30";
      }
      calc();
    });

    for (const button of Array.from(row.querySelectorAll<HTMLButtonElement>("[data-step]"))) {
      button.addEventListener("click", () => {
        if (!input) return;
        const step = Number(button.dataset.step ?? "1");
        const current = Number(input.value) || 0;
        const next = Math.min(30, Math.max(0, round(current + step, 2)));
        input.value = String(next);
        recalc();
      });
    }
  }

  preset?.addEventListener("change", () => {
    applyPreset(preset.value);
    setStatus(preset.value ? `Preset applied: ${preset.options[preset.selectedIndex].text}. Adjust any quantity above.` : "");
  });

  document.getElementById("mc-reset")?.addEventListener("click", () => {
    for (const row of rows) {
      const input = row.querySelector<HTMLInputElement>(".mc-qty__input");
      if (input) input.value = "0";
    }
    if (preset) preset.value = "";
    recalc();
    setStatus("All quantities reset to zero.");
  });

  document.getElementById("mc-copy")?.addEventListener("click", async () => {
    const lines = ["Mediterranean calorie estimate (approximate)", ""];
    for (const row of rows) {
      const input = row.querySelector<HTMLInputElement>(".mc-qty__input");
      const qty = Number(input?.value ?? "0");
      if (qty <= 0) continue;
      const name = row.querySelector(".mc-row__name")?.childNodes[0]?.textContent?.trim() ?? "item";
      lines.push(`${qty} × ${name} — ${Math.round(Number(row.dataset.kcal ?? 0) * qty)} kcal`);
    }
    lines.push("");
    lines.push(`Total: ${outKcal.textContent} kcal`);
    lines.push(
      `Protein ${outProtein.textContent} g · Carbohydrate ${outCarbs.textContent} g · Fat ${outFat.textContent} g`
    );
    lines.push("Estimates from USDA FoodData Central averages — not medical advice.");

    const text = lines.join("\n");
    try {
      await navigator.clipboard.writeText(text);
      setStatus("Summary copied to your clipboard.");
    } catch {
      const area = document.createElement("textarea");
      area.value = text;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand("copy");
      area.remove();
      setStatus(ok ? "Summary copied to your clipboard." : "Copying was blocked — select the totals manually.");
    }
  });

  recalc();
</script>
