  <script>
    (function () {
      "use strict";

      var $ = function (id) {
        return document.getElementById(id);
      };

      var input = $("src");
      var output = $("out");
      var detect = $("detect");
      var warnBox = $("no-detect");
      var copyStatus = $("copy-status");
      var suggestBox = $("ord-suggest");
      var suggestText = $("ord-suggest-text");

      var optEncoding = $("fix-encoding");
      var optForms = $("fix-forms");
      var optHidden = $("fix-hidden");
      var optSpacing = $("fix-spacing");
      var orderRadios = Array.prototype.slice.call(
        document.querySelectorAll('input[name="order"]')
      );

      var NUM = new Intl.NumberFormat("ar-EG");
      var FFFD = "\uFFFD";

      /* ---------------- أصناف المحارف ---------------- */

      // الحروف العربية: الكتلة الأساسية، والكتل الممتدة، ونطاقا أشكال العرض.
      var AR_LETTER = /[\u0620-\u064A\u066E-\u06D3\u06FA-\u06FF\u0750-\u077F\u08A0-\u08C9\uFB50-\uFDFF\uFE70-\uFEFF]/;
      // محارف لا تراها العين: مسافة صفرية، ومحارف اتجاه وعزل، وعلامة ترتيب البايتات.
      var HIDDEN_ONE = /[\u200B-\u200F\u202A-\u202E\u2066-\u2069\uFEFF]/;
      var HIDDEN_ALL = /[\u200B-\u200F\u202A-\u202E\u2066-\u2069\uFEFF]/g;
      // نطاقا أشكال العرض.
      var PRESENTATION = /[\uFB50-\uFDFF\uFE70-\uFEFF]/;
      // حدود الكلمات بمعيار يونيكود، لا بالمسافات وحدها.
      var WORD_SPLIT = /[^\p{L}\p{M}\p{N}]+/u;
      // مقطع يمكن أن يكون بايتات UTF-8 قُرئت بترميز لاتيني: كل ما هو في مدى البايت،
      // زائد المحارف التي يحوّل إليها windows-1252 بايتاتِه العليا.
      var BYTE_RUN = /[\u0000-\u00FF\u0152\u0153\u0160\u0161\u0178\u017D\u017E\u0192\u02C6\u02DC\u2013\u2014\u2018\u2019\u201A\u201C\u201D\u201E\u2020\u2021\u2022\u2026\u2030\u2039\u203A\u20AC\u2122]+/g;
      // خريطة windows-1252 العكسية: من المحرف المطبوع إلى البايت الذي جاء منه.
      var CP1252 = {
        "\u20AC": 0x80, "\u201A": 0x82, "\u0192": 0x83, "\u201E": 0x84, "\u2026": 0x85,
        "\u2020": 0x86, "\u2021": 0x87, "\u02C6": 0x88, "\u2030": 0x89, "\u0160": 0x8a,
        "\u2039": 0x8b, "\u0152": 0x8c, "\u017D": 0x8e, "\u2018": 0x91, "\u2019": 0x92,
        "\u201C": 0x93, "\u201D": 0x94, "\u2022": 0x95, "\u2013": 0x96, "\u2014": 0x97,
        "\u02DC": 0x98, "\u2122": 0x99, "\u0161": 0x9a, "\u203A": 0x9b, "\u0153": 0x9c,
        "\u017E": 0x9e, "\u0178": 0x9f
      };
      var UTF8 =
        typeof TextDecoder === "function"
          ? new TextDecoder("utf-8", { fatal: false })
          : null;

      function countArabicLetters(text) {
        var n = 0;
        for (var i = 0; i < text.length; i += 1) {
          if (AR_LETTER.test(text.charAt(i))) n += 1;
        }
        return n;
      }

      function countHidden(text) {
        var n = 0;
        for (var i = 0; i < text.length; i += 1) {
          if (HIDDEN_ONE.test(text.charAt(i))) n += 1;
        }
        return n;
      }

      function measure(text) {
        return {
          letters: countArabicLetters(text),
          words: text.split(WORD_SPLIT).filter(function (word) {
            return word.length > 0;
          }).length,
          lines: text ? text.split(/\r\n|\r|\n/).length : 0
