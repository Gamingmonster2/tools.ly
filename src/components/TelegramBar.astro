---
/**
 * The Telegram bar.
 *
 * Deliberately NOT a modal. Google's intrusive-interstitial guidance penalises popups that
 * cover the content on mobile, and a tool site especially cannot afford to stand between a
 * visitor and the thing they came to do. This is a small bar that:
 *
 *   · appears only after 8 seconds, so it never blocks the first interaction;
 *   · is not shown at all if the visitor arrived and left before that;
 *   · stays dismissed for 30 days, stored locally, so it is not nagging;
 *   · never appears on a second page view in the same session;
 *   · is a plain link — no email capture, no fake countdown, no "wait!".
 *
 * Only rendered when SITE.telegram is set.
 */
import Icon from "./Icon.astro";
import { strings, type Locale } from "../data/i18n";
import { SITE } from "../data/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = strings[locale];
const enabled = Boolean(SITE.telegram);
---

{
  enabled && (
    <aside
      class="tg-bar"
      id="tg-bar"
      hidden
      data-href={SITE.telegram}
      data-locale={locale}
      aria-label={t.telegramTitle}
    >
      <span class="tg-bar__icon" aria-hidden="true"><Icon name="send" size={18} /></span>
      <span class="tg-bar__text">
        <strong>{t.telegramTitle}</strong>
        <span>{t.telegramBody}</span>
      </span>
      <a
        class="btn btn--primary btn--sm tg-bar__cta"
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.telegramCta}
      </a>
      <button class="tg-bar__close" type="button" id="tg-close" aria-label={t.telegramDismiss}>
        <Icon name="close" size={16} />
      </button>
    </aside>
  )
}

<style>
  .tg-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem clamp(0.75rem, 3vw, 1.5rem);
    /* Respects the iPhone home bar. */
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--border);
    box-shadow: 0 -6px 24px rgba(13, 21, 38, 0.08);
    transform: translateY(100%);
    transition: transform 0.28s ease;
  }
  .tg-bar[data-shown="true"] { transform: translateY(0); }

  .tg-bar__icon {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .tg-bar__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }
  .tg-bar__text strong { font-size: 0.925rem; line-height: 1.3; }
  .tg-bar__text span { font-size: 0.82rem; color: var(--text-muted); line-height: 1.4; }

  .tg-bar__cta { flex: none; }

  .tg-bar__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
  }
  .tg-bar__close:hover { background: var(--bg-sunken); color: var(--text); }

  @media (max-width: 620px) {
    .tg-bar {
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .tg-bar__text { flex-basis: calc(100% - 46px); }
    .tg-bar__cta { flex: 1; }
  }
</style>

<script>
  const bar = document.getElementById("tg-bar");
  const close = document.getElementById("tg-close");

  if (bar) {
    const KEY = "toolsly.tgbar.dismissed";
    const THIRTY_DAYS = 30 * 24 * 60 * 60 * 1000;

    const dismissedRecently = () => {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return false;
        return Date.now() - Number(raw) < THIRTY_DAYS;
      } catch {
        // Storage blocked: treat as dismissed rather than nagging on every page.
        return true;
      }
    };

    const dismiss = () => {
      try {
        localStorage.setItem(KEY, String(Date.now()));
      } catch {}
      bar.dataset.shown = "false";
      document.body.style.paddingBottom = "";
      window.setTimeout(() => {
        bar.hidden = true;
      }, 300);
    };

    if (!dismissedRecently()) {
      // 8 seconds: enough to have started using a tool, early enough to be seen.
      window.setTimeout(() => {
        bar.hidden = false;
        // Reserve room so the bar never covers the end of the page.
        document.body.style.paddingBottom = `${bar.offsetHeight}px`;
        // One frame later, so the transform transition actually runs.
        requestAnimationFrame(() => {
          bar.dataset.shown = "true";
        });
      }, 8000);
    }

    close?.addEventListener("click", dismiss);
  }
</script>
