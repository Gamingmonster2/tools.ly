---
import ToolLayout from "../layouts/ToolLayout.astro";
import { legacyTools } from "../data/tools";

const tool = legacyTools.find((t) => t.slug === "strong-password-generator-online")!;

const faqs = [
  {
    q: "Is this password generator safe to use?",
    a: "Yes. Every password is created inside your own browser by JavaScript that runs on this page. Randomness comes from crypto.getRandomValues, the browser's cryptographically secure random number generator, and the value never leaves your device — there is no upload, no logging and no network request at any point.",
  },
  {
    q: "What is a good password length in 2026?",
    a: "For anything you must type by hand, 16 characters of mixed letters, digits and symbols is a comfortable baseline. For accounts that matter most — email, banking, password managers — 20 characters or more costs you nothing when a password manager fills it in. Going from 16 to 20 characters adds roughly 26 bits of entropy, which multiplies the guessing effort by tens of millions.",
  },
  {
    q: "Are passphrases weaker than random strings?",
    a: "Not necessarily. A four-word passphrase drawn from a 7776-word list holds about 51.7 bits, which is decent but not great. Eight words reaches roughly 103 bits. Words are easier to read and retype by hand, while random strings pack more entropy per character. The right choice depends on whether a human or a password manager has to enter it.",
  },
  {
    q: "Should I write the password down?",
    a: "Write it into a password manager, not a sticky note. A manager stores the password encrypted, fills it in for you and can generate a unique one for every single account, which is the only reliable defense against credential stuffing. If you must keep a paper copy, store it somewhere physically secure and treat it as a spare key rather than your daily log-in.",
  },
];

const sources = [
  {
    label: "NIST SP 800-63B — Digital Identity Guidelines (Authentication and Lifecycle Management)",
    href: "https://pages.nist.gov/800-63-3/sp800-63b.html",
    note: "The reference that shifted industry advice toward length, blocklists and rate limiting instead of forced composition rules.",
  },
  {
    label: "OWASP Authentication Cheat Sheet",
    href: "https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html",
    note: "Practical guidance on password policy, breached-password checks and why you should never cap the maximum length.",
  },
  {
    label: "MDN — Crypto.getRandomValues()",
    href: "https://developer.mozilla.org/en-US/docs/Web/API/Crypto/getRandomValues",
    note: "Documents the browser API this tool uses to draw every character and word from a cryptographically secure source.",
  },
];
---

<ToolLayout
  tool={tool}
  intro="Generate strong random passwords or memorable passphrases in your browser, with a live entropy meter, crack-time estimate and bulk mode. Nothing is ever sent to a server."
  faqs={faqs}
  sources={sources}
>
  <Fragment slot="tool">
    <div class="panel">
      <div class="panel__body">
        <div class="seg" role="tablist" aria-label="Generation mode" id="modeTabs">
          <button type="button" class="seg__btn" role="tab" data-mode="chars" aria-selected="true" id="modeChars">
            Random characters
          </button>
          <button type="button" class="seg__btn" role="tab" data-mode="words" aria-selected="false" id="modeWords">
            Passphrase
          </button>
        </div>

        <div class="primary">
          <button type="button" class="btn btn--ghost btn--sm" id="regenBtn">
            Regenerate
          </button>
          <button type="button" class="btn btn--primary btn--sm" id="copyBtn">
            Copy
          </button>
        </div>

        <p class="pwd" id="primaryResult" aria-live="polite">—</p>

        <div class="stat-grid" style="margin-top:1rem">
          <div class="stat">
            <div class="stat__label">Entropy</div>
            <div class="stat__value" id="entropyValue">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">Strength</div>
            <div class="stat__value stat__value--text" id="strengthLabel">—</div>
          </div>
          <div class="stat">
            <div class="stat__label">Crack time</div>
            <div class="stat__value stat__value--text" id="crackValue">—</div>
          </div>
        </div>

        <div class="meter" id="meterWrap">
          <div class="meter__track">
            <span class="meter__fill" id="meterFill"></span>
          </div>
          <p class="meter__note" id="meterNote">—</p>
        </div>

        <div id="charsPanel" role="tabpanel" aria-labelledby="modeChars">
          <div class="row row--slider">
            <label class="label" for="length">Length</label>
            <input type="range" id="length" min="8" max="128" step="1" value="16" />
            <output class="readout length-out" id="lengthOut" for="length">16</output>
          </div>

          <fieldset class="fieldset" style="margin-top:1.1rem">
            <legend>Character sets</legend>
            <div class="check-grid">
              <label class="check"><input type="checkbox" id="useUpper" checked /> Uppercase (A–Z)</label>
              <label class="check"><input type="checkbox" id="useLower" checked /> Lowercase (a–z)</label>
              <label class="check"><input type="checkbox" id="useDigits" checked /> Digits (0–9)</label>
              <label class="check"><input type="checkbox" id="useSymbols" checked /> Symbols (!@#$…)</label>
            </div>
          </fieldset>

          <fieldset class="fieldset" style="margin-top:0.85rem">
            <legend>Extra rules</legend>
            <div class="check-grid">
              <label class="check"
                ><input type="checkbox" id="excludeLookAlike" /> Exclude look-alike characters (Il1O0)</label
              >
              <label class="check"
                ><input type="checkbox" id="requireEach" checked /> Require at least one of each selected set</label
              >
            </div>
            <div class="field" style="margin-top:0.75rem">
              <label for="excludeChars">Exclude characters</label>
              <input
                type="text"
                id="excludeChars"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="e.g. @#$%"
                aria-describedby="excludeHint"
              />
              <span class="hint" id="excludeHint">Every character listed here is removed from the pool.</span>
            </div>
          </fieldset>
        </div>

        <div id="wordsPanel" role="tabpanel" aria-labelledby="modeWords" hidden>
          <div class="row row--slider">
            <label class="label" for="wordCount">Words</label>
            <input type="range" id="wordCount" min="3" max="8" step="1" value="5" />
            <output class="readout length-out" id="wordCountOut" for="wordCount">5</output>
          </div>

          <div class="field-grid" style="margin-top:1rem">
            <div class="field">
              <label for="wordCase">Word casing</label>
              <select id="wordCase">
                <option value="lower" selected>lowercase</option>
                <option value="title">Title case</option>
                <option value="upper">UPPERCASE</option>
              </select>
            </div>
            <div class="field">
              <label for="separator">Separator</label>
              <select id="separator">
                <option value="-" selected>Hyphen ( - )</option>
                <option value=".">Dot ( . )</option>
                <option value="_">Underscore ( _ )</option>
                <option value=" ">Space ( )</option>
                <option value="+">Plus ( + )</option>
                <option value="">Nothing</option>
              </select>
            </div>
            <div class="field">
              <label for="wordNumber">Append a number</label>
              <select id="wordNumber">
                <option value="none" selected>No number</option>
                <option value="1">1 digit (0–9)</option>
                <option value="2">2 digits</option>
              </select>
            </div>
            <div class="field">
              <label for="wordSymbol">Append a symbol</label>
              <select id="wordSymbol">
                <option value="none" selected>No symbol</option>
                <option value="1">1 symbol</option>
                <option value="2">2 symbols</option>
              </select>
            </div>
          </div>
        </div>

        <div class="bulk" id="bulk">
          <div class="row row--slider">
            <label class="label" for="bulkCount">Bulk mode — how many</label>
            <input type="range" id="bulkCount" min="1" max="20" step="1" value="5" />
            <output class="readout length-out" id="bulkCountOut" for="bulkCount">5</output>
          </div>
          <div class="primary primary--bulk">
            <button type="button" class="btn btn--ghost btn--sm" id="bulkRegenBtn">Regenerate list</button>
            <button type="button" class="btn btn--soft btn--sm" id="copyAllBtn">Copy all</button>
          </div>
          <p class="sr-only" id="bulkStatus" role="status" aria-live="polite"></p>
          <ul class="list" id="bulkList"></ul>
        </div>

        <details class="callout" style="margin-top:1.1rem">
          <summary style="cursor:pointer;font-weight:650">Test here before you paste it anywhere</summary>
          <div class="field" style="margin-top:0.75rem">
            <label for="tester">Paste a password to measure its entropy</label>
            <input
              type="text"
              id="tester"
              class="readout"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="type or paste"
            />
            <span class="hint" id="testerOut">Nothing is uploaded — the estimate is computed locally.</span>
          </div>
        </details>
      </div>
      <div class="panel__foot">
        Generated locally with <code>crypto.getRandomValues()</code> and rejection sampling, so every character is
        uniformly random. Nothing is transmitted, stored or logged — close the tab and it is gone.
      </div>
    </div>
  </Fragment>

  <h2>How this generator works</h2>
  <p>
    Every password on this page is created by JavaScript that is already loaded in your browser. There is no server
    call, no queue and no account: when you move a slider or press <em>Regenerate</em>, the relevant code runs on your
    own machine and the result is written straight into the page. If you open your browser's network panel while using
    the tool, you will see no request carrying your password, because none is made.
  </p>
  <p>
    The random characters come from <code>crypto.getRandomValues()</code>, the browser's cryptographically secure
    random number generator, which is the same class of source used for TLS session keys and other security-critical
    values. It is deliberately <em>not</em> <code>Math.random()</code>, which is a fast but predictable
    pseudo-random generator whose internal state can be reconstructed from a handful of outputs — fine for animation
    jitter, unacceptable for secrets.
  </p>
  <p>
    Secure randomness alone is not enough, because of a subtle trap called <em>modulo bias</em>. If you take a random
    32-bit integer and compute <code>n % poolSize</code>, the first few characters of the pool come up slightly more
    often than the last ones whenever <code>poolSize</code> does not divide the range of <code>n</code> exactly. The
    bias is tiny per character, but over a 20-character password it quietly shrinks the search space. This generator
    uses <strong>rejection sampling</strong> instead: it draws a random 32-bit value, keeps only values below the
    largest multiple of the pool size, and throws the rest away. The discarded values are re-drawn, never folded, so
    every character in the pool has exactly the same probability.
  </p>
  <p>
    A related detail is the "require at least one of each selected set" option, which is on by default. Purely random
    strings occasionally contain no digits and no symbols at all, and a great many websites reject them. When that
    option is enabled, the generator first draws the full password at random, then guarantees that at least one
    character from each selected set is present and removes the overlap. The guarantee costs a fraction of a bit of
    entropy, which the meter accounts for.
  </p>

  <h2>Password length is the biggest lever</h2>
  <p>
    Entropy, measured in bits, is the standard way to describe how hard a password is to guess. For a password drawn
    uniformly from a pool of <code>A</code> distinct characters with length <code>L</code>, the number of possible
    passwords is <code>A^L</code>, and entropy is its base-2 logarithm:
  </p>
  <pre><code>bits = L × log2(A)

16 characters from 94 symbols  → 16 × 6.554 = 104.9 bits
12 characters from 94 symbols  → 12 × 6.554 =  78.6 bits
16 characters from 26 letters  → 16 × 4.700 =  75.2 bits</code></pre>
  <p>
    Because length multiplies and the alphabet only contributes a logarithm, adding characters beats adding symbols
    almost every time. Each extra character from a 94-character pool adds about 6.55 bits, which doubles the guessing
    effort every time you add roughly a sixth of a character — in practice, every one or two characters you add
    multiplies an attacker's work by tens or hundreds. Widening the alphabet from 26 to 94 characters only adds about
    1.85 bits per character, and you can only widen it so far.
  </p>
  <p>
    The meter on this page converts entropy into a crack-time estimate at <strong>10 billion guesses per second</strong>.
    That figure is generous to the attacker: it represents a determined offline assault using modern GPUs against a
    fast hash. On the other side of the ledger, real services rate-limit log-in attempts, hash passwords slowly, and
    lock accounts, so the practical time is usually far longer. Treat the number as a worst case, not a best case.
  </p>
  <div class="table-wrap" style="margin-bottom:1.25rem">
    <table class="data">
      <thead>
        <tr><th>Entropy</th><th>Typical label</th><th>Crack time at 10¹⁰ guesses/s</th><th>Good for</th></tr>
      </thead>
      <tbody>
        <tr><td>Under 28 bits</td><td>Very weak</td><td>Seconds or less</td><td>Nothing you care about</td></tr>
        <tr><td>28–35 bits</td><td>Weak</td><td>Minutes to hours</td><td>Throwaway test accounts</td></tr>
        <tr><td>36–59 bits</td><td>Fair</td><td>Days to years</td><td>Low-value log-ins</td></tr>
        <tr><td>60–89 bits</td><td>Strong</td><td>Centuries</td><td>Most accounts you own</td></tr>
        <tr><td>90 bits and up</td><td>Very strong</td><td>Far beyond centuries</td><td>Email, banking, password vaults</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    Notice how compressed the bottom of that table is. The difference between "cracked in a second" and "cracked in a
    century" is not a factor of a hundred; it is a factor of about 3 billion, and it is usually reached by moving from
    eight characters to eighteen.
  </p>

  <h2>Choosing a character set</h2>
  <p>
    The four sets on this page have very different sizes, and the size of the pool is what feeds the logarithm in the
    entropy formula:
  </p>
  <ul>
    <li><strong>Lowercase (26)</strong> — the baseline. Readable and easy to type on any keyboard layout.</li>
    <li><strong>Uppercase (26)</strong> — adds 26 possibilities, about one extra bit per character.</li>
    <li><strong>Digits (10)</strong> — only 10 extra possibilities, but many sites insist on them.</li>
    <li><strong>Symbols (32 here)</strong> — a useful top-up, and often the set that satisfies a stubborn password policy.</li>
  </ul>
  <p>
    All four together give a pool of 94 characters and 6.55 bits per character. If a site rejects symbols, dropping to
    62 characters loses only about 0.6 bits per character — recover it by adding a single character to the length. The
    one genuinely useful subtraction is <strong>excluding look-alike characters</strong>. The letters
    <code>I</code>, <code>l</code> and the digit <code>1</code>, or the letter <code>O</code> and the digit
    <code>0</code>, are the source of most transcription errors when a password is read off one screen and typed into
    another. Removing them costs about 0.4 bits per character and removes a whole category of support tickets. The
    <strong>exclude characters</strong> field goes further: paste in any characters your target system refuses — or ones
    that are awkward on a phone keyboard — and they are struck from the pool before generation.
  </p>
  <p>
    Two counter-intuitive points are worth stating plainly. First, symbols are not magic; they are simply more
    characters, and length buys more of them. Second, complexity rules that force one upper, one digit and one symbol
    into a short password do very little; the same rules applied to a 20-character password do not matter at all
    because it is already unguessable. Length first, then the alphabet.
  </p>

  <h2>Passphrases vs random strings</h2>
  <p>
    A passphrase trades some entropy per character for something random strings cannot offer: memorability and
    typeability. This tool ships with an embedded list of 2392 common English words of four to eight letters, which
    gives about 11.2 bits per word (log2 2392 ≈ 11.22). The meter uses that number for passphrase entropy, then adds
    the contribution of any appended digits (3.32 bits each) and symbols (3 bits each).
  </p>
  <pre><code>4 words → 4 × 11.2  = 44.9 bits   (fair: only for low-value log-ins)
5 words → 5 × 11.2  = 56.1 bits   (fair)
6 words → 6 × 11.2  = 67.3 bits   (strong)
8 words → 8 × 11.2  = 89.8 bits   (very strong)</code></pre>
  <p>
    Compare that with a 16-character random string at roughly 105 bits. To reach the same figure with words you would
    need eleven of them, which is a lot to type. The honest conclusion is that <strong>words win when a human has to
    remember and retype the secret</strong> — a device unlock code, a master password you type daily, a Wi-Fi key — and
    <strong>random strings win when software does the typing</strong>. Since a password manager types for you, the
    default here is a random string. Where a service forces you to memorise something, switch to passphrase mode, pick
    six or more words, and keep the separator consistent so it stays easy to retype.
  </p>
  <p>
    One warning about passphrases is easy to overlook: they are only strong if the words are chosen randomly. Human
    word choices cluster heavily around a small favourite set, which is exactly what cracking tools exploit with
    dictionary and rule-based attacks. Let the generator pick the words; never assemble them yourself.
  </p>

  <h2>What to do with the password you just generated</h2>
  <ol>
    <li>
      <strong>Put it into a password manager immediately.</strong> The few seconds between generating a password and
      saving it are when it gets lost — pasted into a chat window, lost in a closed tab, or replaced by something
      weaker because you were tired. Save first, then paste.
    </li>
    <li>
      <strong>Never reuse it.</strong> Credential stuffing works because one breach leaks an email and password pair,
      and attackers replay that pair against hundreds of other sites. A password you reuse is effectively one password
      shared across every account it protects; the strength of the individual string stops mattering once it appears in
      a breach dump.
    </li>
    <li>
      <strong>Turn on two-factor authentication</strong> for email, banking and anything holding payment details. A
      strong password and a second factor cover different attacks, and together they are far more than the sum of their
      parts.
    </li>
    <li>
      <strong>Change it only if it is exposed.</strong> Modern advice is against rotating passwords on a schedule —
      forced rotation produces predictable variations like <code>Summer2026!</code>. Change a password when a breach
      notification, a suspicious log-in or a shared computer gives you a reason.
    </li>
    <li>
      <strong>Check the password against breach lists</strong> where a service offers it, and prefer the longest value a
      site accepts. If a site caps you at twelve characters, that is a reason to enable two-factor authentication rather
      than to look for a different string.
    </li>
  </ol>
  <div class="callout callout--warn">
    <p>
      Treat the tab you are reading as a temporary workspace. Nothing here is stored, which is good for privacy and bad
      for retrieval: close the tab before saving the password and it is gone for good. Generate, save, then close.
    </p>
  </div>

  <style is:global>
    .seg {
      display: inline-flex;
      gap: 0.25rem;
      padding: 0.25rem;
      background: var(--bg-sunken);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      max-width: 100%;
      overflow-x: auto;
    }
    .seg__btn {
      border: 0;
      background: transparent;
      color: var(--text-muted);
      font: inherit;
      font-size: 0.9rem;
      font-weight: 650;
      padding: 0.45rem 0.95rem;
      border-radius: var(--radius-pill);
      cursor: pointer;
      white-space: nowrap;
    }
    .seg__btn[aria-selected="true"] {
      background: var(--surface);
      color: var(--accent);
      box-shadow: var(--shadow-xs);
    }

    .primary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1rem 0 0.75rem;
    }
    .primary--bulk { margin: 0.75rem 0 0.6rem; }

    .pwd {
      margin: 0;
      background: var(--bg-sunken);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.9rem 1rem;
      font-family: var(--font-mono);
      font-size: clamp(1rem, 3.6vw, 1.35rem);
      font-weight: 600;
      line-height: 1.45;
      word-break: break-all;
      min-height: 3.2rem;
      color: var(--text);
    }

    .stat__value--text { font-size: 1.05rem; word-break: break-word; }

    .meter { margin-top: 1rem; }
    .meter__track {
      height: 10px;
      background: var(--bg-sunken);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      overflow: hidden;
    }
    .meter__fill {
      display: block;
      height: 100%;
      width: 0;
      background: var(--danger);
      border-radius: var(--radius-pill);
      transition: width 0.18s ease, background-color 0.18s ease;
    }
    .meter__note {
      margin: 0.5rem 0 0;
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex-wrap: wrap;
    }
    .row--slider { margin-top: 1rem; }
    .row--slider input[type="range"] { flex: 1 1 180px; min-width: 0; }
    .length-out {
      min-width: 3.2rem;
      text-align: center;
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--accent);
      background: var(--accent-soft);
      border: 1px solid var(--accent-border);
      border-radius: var(--radius-sm);
      padding: 0.3rem 0.5rem;
    }

    .check-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 0.15rem 1rem;
    }

    .hint { font-size: 0.82rem; color: var(--text-faint); }

    .bulk {
      margin-top: 1.35rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .list {
      list-style: none;
      margin: 0.5rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.4rem;
      max-height: 22rem;
      overflow-y: auto;
    }
    .list__row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.45rem 0.5rem 0.45rem 0.75rem;
    }
    .list__index {
      flex: none;
      min-width: 1.4rem;
      font-size: 0.78rem;
      color: var(--text-faint);
      font-variant-numeric: tabular-nums;
    }
    .list__text {
      flex: 1 1 auto;
      min-width: 0;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      word-break: break-all;
    }
    .list__row .btn { flex: none; }

    .callout summary { color: var(--text); }

    @media (max-width: 480px) {
      .check-grid { grid-template-columns: minmax(0, 1fr); }
      .row--slider { gap: 0.5rem; }
      .list__row { flex-wrap: wrap; }
      .list__text { flex: 1 1 100%; order: 3; }
      .list__row .btn { margin-inline-start: auto; }
    }
  </style>

  <script>
    type Mode = "chars" | "words";

    const LOWER = "abcdefghijklmnopqrstuvwxyz";
    const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const DIGITS = "0123456789";
